	skos:note "Where a characteristic of NIST's AI Risk Management Framework, as lmodel/nist-ai-100-1 renders it, holds a property, the value maps to it: broad where NIST joins the property with another, close for fairness." ;
	linkml:annotations _:c14n26 ;
	linkml:definition_uri "https://w3id.org/lmodel/iso22989/AicTrustworthinessProperty"^^xsd:anyURI ;
	linkml:description "A property a trustworthiness claim is about." ;
	linkml:permissible_values <https://w3id.org/lmodel/iso22989/accountability> , <https://w3id.org/lmodel/iso22989/availability> , <https://w3id.org/lmodel/iso22989/bias_and_fairness> , <https://w3id.org/lmodel/iso22989/controllability> , <https://w3id.org/lmodel/iso22989/explainability> , <https://w3id.org/lmodel/iso22989/organizational_transparency> , <https://w3id.org/lmodel/iso22989/predictability> , <https://w3id.org/lmodel/iso22989/reliability> , <https://w3id.org/lmodel/iso22989/resilience> , <https://w3id.org/lmodel/iso22989/robustness> , <https://w3id.org/lmodel/iso22989/system_transparency> .
<https://w3id.org/lmodel/iso22989/accountability> skos:broadMatch "nist_ai_100_1:AiRmfCharacteristicName#accountable_and_transparent"^^xsd:anyURI ;
	linkml:annotations _:c14n235 ;
	linkml:description "Someone answers for what the system does and decides." .
<https://w3id.org/lmodel/iso22989/action> linkml:annotations _:c14n306 ;
	linkml:description "Carrying out what was chosen." .
<https://w3id.org/lmodel/iso22989/ai_customer> linkml:annotations _:c14n126 ;
	linkml:description "Takes an AI product or service for its own use." .
<https://w3id.org/lmodel/iso22989/ai_developer> linkml:annotations _:c14n207 ;
	linkml:description "Writes and builds the system." .
<https://w3id.org/lmodel/iso22989/ai_partner> linkml:annotations _:c14n271 ;
	linkml:description "Helps others in the ecosystem, by integrating systems or supplying data." .
<https://w3id.org/lmodel/iso22989/ai_platform_provider> linkml:annotations _:c14n121 ;
	linkml:description "Offers the platform that others run AI on." .
<https://w3id.org/lmodel/iso22989/ai_producer> linkml:annotations _:c14n197 ;
	linkml:description "Designs, builds, tests or runs AI systems." .
<https://w3id.org/lmodel/iso22989/ai_product_or_service_provider> linkml:annotations _:c14n22 ;
	linkml:description "Offers a finished AI product or a service built on AI." .
<https://w3id.org/lmodel/iso22989/ai_provider> linkml:annotations _:c14n29 ;
	linkml:description "Offers AI products or services, or the platform for them." .
<https://w3id.org/lmodel/iso22989/ai_subject> linkml:annotations _:c14n209 ;
	linkml:description "Is affected by an AI system, or has data about them used in it." .
<https://w3id.org/lmodel/iso22989/ai_system_integrator> linkml:annotations _:c14n65 ;
	linkml:description "Fits AI parts into a larger system." .
<https://w3id.org/lmodel/iso22989/ai_user> linkml:annotations _:c14n196 ;
