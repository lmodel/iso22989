<https://w3id.org/lmodel/iso22989/iso22989> dcterms:license "Apache-2.0" ;
	dcterms:source "https://www.iso.org/standard/74296.html"^^xsd:anyURI ;
	dcterms:title "ISO/IEC 22989:2022 AI concepts and terminology" ;
	pav:version "2022" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://lmodel.github.io/iso22989"^^xsd:anyURI , "https://www.iso.org/standard/74296.html"^^xsd:anyURI ;
	skos:note "Every record that other records refer to has an aic_id, and a reference holds that identifier. AicEcosystem holds each kind of record in a list of its own." , "ISO/IEC 22989 is copyright ISO and IEC, and none of its text is reproduced here. Each element cites what it renders by number, in the iso22989_term annotation for a term of Clause 3 and the iso22989_clause annotation for a clause, and its description is this project's own words. A reader with a licensed copy looks the standard's wording up there by those numbers." , "The version is the edition the schema models, and source is ISO's page for that edition. ISO Open Data's records of it and of the two amendments in progress are copied to src/iso22989/schema/iso-open-data/ as of the date in the annotations, and scripts/check_upstream_release.py reports when ISO publishes one of them or another edition. The release tags are the schema's own versions." , "tests/iso22989_numbers.yaml lists every term number and says which element renders it, or why none does." ;
	sh:declare _:c14n10 , _:c14n111 , _:c14n156 , _:c14n208 , _:c14n246 , _:c14n53 , _:c14n57 , _:c14n61 , _:c14n72 ;
	linkml:annotations _:c14n222 , _:c14n225 , _:c14n25 , _:c14n268 ;
	linkml:classes <https://w3id.org/lmodel/iso22989/AicAction> , <https://w3id.org/lmodel/iso22989/AicAgent> , <https://w3id.org/lmodel/iso22989/AicApplication> , <https://w3id.org/lmodel/iso22989/AicAssessment> , <https://w3id.org/lmodel/iso22989/AicComponent> , <https://w3id.org/lmodel/iso22989/AicCyberPhysicalSystem> , <https://w3id.org/lmodel/iso22989/AicDataProcess> , <https://w3id.org/lmodel/iso22989/AicDataset> , <https://w3id.org/lmodel/iso22989/AicDecision> , <https://w3id.org/lmodel/iso22989/AicEcosystem> , <https://w3id.org/lmodel/iso22989/AicExpertSystem> , <https://w3id.org/lmodel/iso22989/AicIotDevice> , <https://w3id.org/lmodel/iso22989/AicIotSystem> , <https://w3id.org/lmodel/iso22989/AicKnowledge> , <https://w3id.org/lmodel/iso22989/AicLifecycleProcess> , <https://w3id.org/lmodel/iso22989/AicMachineLearningModel> , <https://w3id.org/lmodel/iso22989/AicModel> , <https://w3id.org/lmodel/iso22989/AicNeuralNetworkModel> , <https://w3id.org/lmodel/iso22989/AicPrediction> , <https://w3id.org/lmodel/iso22989/AicRecordMixin> , <https://w3id.org/lmodel/iso22989/AicResourcePool> , <https://w3id.org/lmodel/iso22989/AicRobot> , <https://w3id.org/lmodel/iso22989/AicStakeholder> , <https://w3id.org/lmodel/iso22989/AicSystem> , <https://w3id.org/lmodel/iso22989/AicTask> , <https://w3id.org/lmodel/iso22989/AicTrustworthinessClaim> ;
	linkml:default_prefix "iso22989" ;
	linkml:default_range <https://w3id.org/lmodel/iso22989/string> ;
	linkml:description "A LinkML vocabulary for describing an AI system in the terms of ISO/IEC 22989:2022: the system and its kinds, its models, data and tasks, its place in the life cycle, the parties around it, the trustworthiness claims made for it, and the fields and applications it belongs to." ;
