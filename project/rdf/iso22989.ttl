<https://w3id.org/lmodel/iso22989/AicRecordMixin> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso22989"^^xsd:anyURI ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are. lokf adapt replaces aic_id with LOKF's id, and a class that declares id itself must descend from Concept." ;
	linkml:class_uri "https://w3id.org/lmodel/iso22989/AicRecordMixin"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso22989/AicRecordMixin"^^xsd:anyURI ;
	linkml:description "What every record has, so that other records can refer to it: an identifier, a title and a description." ;
	linkml:mixin true ;
	linkml:slot_usage _:c14n198 ;
	linkml:slots <https://w3id.org/lmodel/iso22989/AicRecordMixin_title> , <https://w3id.org/lmodel/iso22989/aic_id> , <https://w3id.org/lmodel/iso22989/description> .
