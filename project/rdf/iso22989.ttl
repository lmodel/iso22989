<https://w3id.org/lmodel/iso22989/cognitive_computing> linkml:annotations _:c14n297 , _:c14n62 ;
	linkml:description "Aims at interaction with people that feels closer to how people deal with one another." .
<https://w3id.org/lmodel/iso22989/collect_and_process_data> skos:closeMatch "nist_ai_100_1:AiRmfLifecycleStageName#collect_and_process_data"^^xsd:anyURI ;
