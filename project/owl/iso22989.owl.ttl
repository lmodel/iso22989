<https://w3id.org/lmodel/iso22989/JurisdictionalIssueType#regulatory_compliance> a owl:Class ;
    rdfs:label "regulatory_compliance" ;
    rdfs:subClassOf iso22989:JurisdictionalIssueType ;
    skos:definition "Conformity with applicable AI-specific or sector-specific regulations." .

iso22989:KnowledgeRepresentation a owl:Class ;
    rdfs:label "KnowledgeRepresentation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:representation_form ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:knowledge_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:symbolic_approach ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:knowledge_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:representation_form ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:SymbolicApproach ;
            owl:onProperty iso22989:symbolic_approach ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:KnowledgeType ;
            owl:onProperty iso22989:knowledge_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:symbolic_approach ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:representation_form ],
        iso22989:AIConcept ;
    skos:definition "Representation of knowledge usable by an AI system (Clause 5.4), including knowledge graphs, ontologies and rule bases." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

<https://w3id.org/lmodel/iso22989/KnowledgeType#common_sense> a owl:Class ;
    rdfs:label "common_sense" ;
    rdfs:subClassOf iso22989:KnowledgeType ;
    skos:definition "Background knowledge expected to be shared by typical humans." .

<https://w3id.org/lmodel/iso22989/KnowledgeType#declarative> a owl:Class ;
    rdfs:label "declarative" ;
    rdfs:subClassOf iso22989:KnowledgeType ;
    skos:definition "Knowledge of facts and relationships (Clause 3.1.12)." .

<https://w3id.org/lmodel/iso22989/KnowledgeType#domain_specific> a owl:Class ;
    rdfs:label "domain_specific" ;
    rdfs:subClassOf iso22989:KnowledgeType ;
    skos:definition "Knowledge specific to a particular application domain." .

<https://w3id.org/lmodel/iso22989/KnowledgeType#procedural> a owl:Class ;
    rdfs:label "procedural" ;
    rdfs:subClassOf iso22989:KnowledgeType ;
    skos:definition "Knowledge of how to perform tasks (Clause 3.1.28)." .

<https://w3id.org/lmodel/iso22989/KnowledgeType#tacit> a owl:Class ;
    rdfs:label "tacit" ;
    rdfs:subClassOf iso22989:KnowledgeType ;
    skos:definition "Implicit, experience-based knowledge that is hard to articulate." .

<https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#bayesian_network> a owl:Class ;
    rdfs:label "bayesian_network" ;
    rdfs:subClassOf iso22989:MLAlgorithmFamily ;
    skos:definition "Probabilistic graphical models encoding conditional dependencies between variables." .

<https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#decision_tree> a owl:Class ;
    rdfs:label "decision_tree" ;
    rdfs:subClassOf iso22989:MLAlgorithmFamily ;
    skos:definition "Tree-structured models splitting the input space on feature thresholds." .

<https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#genetic_algorithm> a owl:Class ;
    rdfs:label "genetic_algorithm" ;
    rdfs:subClassOf iso22989:MLAlgorithmFamily ;
    skos:definition "Population-based optimisation inspired by biological evolution (Clause 5.8)." .

<https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#neural_network> a owl:Class ;
    rdfs:label "neural_network" ;
    rdfs:subClassOf iso22989:MLAlgorithmFamily ;
    skos:definition "Networks of interconnected processing units (artificial neurons) trained by gradient methods." .

<https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#support_vector_machine> a owl:Class ;
    rdfs:label "support_vector_machine" ;
    rdfs:subClassOf iso22989:MLAlgorithmFamily ;
    skos:definition "Margin-maximising classifiers operating in (possibly kernelised) feature spaces." .

<https://w3id.org/lmodel/iso22989/MachineLearningParadigm#reinforcement> a owl:Class ;
    rdfs:label "reinforcement" ;
    rdfs:subClassOf iso22989:MachineLearningParadigm ;
    skos:definition "Learning policies by interaction with an environment that issues rewards." .

<https://w3id.org/lmodel/iso22989/MachineLearningParadigm#self_supervised> a owl:Class ;
    rdfs:label "self_supervised" ;
    rdfs:subClassOf iso22989:MachineLearningParadigm ;
    skos:definition "Learning representations from data using auxiliary tasks derived from the data itself." .

<https://w3id.org/lmodel/iso22989/MachineLearningParadigm#semi_supervised> a owl:Class ;
    rdfs:label "semi_supervised" ;
    rdfs:subClassOf iso22989:MachineLearningParadigm ;
    skos:definition "Learning from a mixture of labelled and unlabelled data." .

<https://w3id.org/lmodel/iso22989/MachineLearningParadigm#supervised> a owl:Class ;
    rdfs:label "supervised" ;
    rdfs:subClassOf iso22989:MachineLearningParadigm ;
    skos:definition "Learning from labelled input-output examples." .

<https://w3id.org/lmodel/iso22989/MachineLearningParadigm#transfer> a owl:Class ;
    rdfs:label "transfer" ;
    rdfs:subClassOf iso22989:MachineLearningParadigm ;
    skos:definition "Reusing knowledge learned on one task to accelerate learning on a related task." .

<https://w3id.org/lmodel/iso22989/MachineLearningParadigm#unsupervised> a owl:Class ;
    rdfs:label "unsupervised" ;
    rdfs:subClassOf iso22989:MachineLearningParadigm ;
    skos:definition "Learning structure from unlabelled data (clustering, density estimation, dimensionality reduction)." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#automatic_summarization> a owl:Class ;
    rdfs:label "automatic_summarization" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Producing condensed summaries of longer text (Clause 3.6.1)." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#coreference_resolution> a owl:Class ;
    rdfs:label "coreference_resolution" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Linking mentions in text that refer to the same entity." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#dialogue_management> a owl:Class ;
    rdfs:label "dialogue_management" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Controlling multi-turn conversational interaction (Clause 9.2.2)." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#emotion_recognition> a owl:Class ;
    rdfs:label "emotion_recognition" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Detecting affective or emotional state expressed in text or speech." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#information_retrieval> a owl:Class ;
    rdfs:label "information_retrieval" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Finding relevant documents or passages in a collection in response to a query." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#lemmatisation> a owl:Class ;
    rdfs:label "lemmatisation" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Reducing tokens to their canonical dictionary form." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#machine_translation> a owl:Class ;
    rdfs:label "machine_translation" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Automatically translating text between natural languages." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#named_entity_recognition> a owl:Class ;
    rdfs:label "named_entity_recognition" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Identifying and classifying named entities in text." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#natural_language_generation> a owl:Class ;
    rdfs:label "natural_language_generation" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Producing natural-language output from structured inputs (Clause 9.2)." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#natural_language_understanding> a owl:Class ;
    rdfs:label "natural_language_understanding" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Deriving structured meaning, intent or entities from natural-language input (Clause 9.2)." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#optical_character_recognition> a owl:Class ;
    rdfs:label "optical_character_recognition" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Converting images of printed or handwritten text into machine-readable text (Clause 3.6.12)." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#part_of_speech_tagging> a owl:Class ;
    rdfs:label "part_of_speech_tagging" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Assigning grammatical category labels to tokens." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#question_answering> a owl:Class ;
    rdfs:label "question_answering" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Producing direct answers to natural-language questions." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#relationship_extraction> a owl:Class ;
    rdfs:label "relationship_extraction" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Identifying typed relationships between entities mentioned in text." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#semantic_analysis> a owl:Class ;
    rdfs:label "semantic_analysis" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Deriving meaning representations from text." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#sentiment_analysis> a owl:Class ;
    rdfs:label "sentiment_analysis" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Estimating subjective polarity or affect in text." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#speech_recognition> a owl:Class ;
    rdfs:label "speech_recognition" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Converting acoustic speech signals into text." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#speech_synthesis> a owl:Class ;
    rdfs:label "speech_synthesis" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Generating speech audio from text." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#syntactic_parsing> a owl:Class ;
    rdfs:label "syntactic_parsing" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Producing syntactic structure for sentences." .

<https://w3id.org/lmodel/iso22989/NLPComponentType#tokenisation> a owl:Class ;
    rdfs:label "tokenisation" ;
    rdfs:subClassOf iso22989:NLPComponentType ;
    skos:definition "Segmenting text into tokens such as words or subwords." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#autoencoder> a owl:Class ;
    rdfs:label "autoencoder" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Encoder-decoder architecture trained to reconstruct inputs for representation learning." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#convolutional> a owl:Class ;
    rdfs:label "convolutional" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Convolutional neural network using local receptive fields (Clause 3.4.2)." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#deep> a owl:Class ;
    rdfs:label "deep" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Neural network with many hidden layers (deep learning, Clause 3.4.4)." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#feed_forward> a owl:Class ;
    rdfs:label "feed_forward" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Feed-forward neural network with unidirectional information flow (Clause 3.4.6)." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#gated_recurrent_unit> a owl:Class ;
    rdfs:label "gated_recurrent_unit" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "GRU recurrent architecture, a simplified gating variant of LSTM." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#generative_adversarial> a owl:Class ;
    rdfs:label "generative_adversarial" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Adversarial pairing of generator and discriminator networks." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#long_short_term_memory> a owl:Class ;
    rdfs:label "long_short_term_memory" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "LSTM recurrent architecture mitigating short memory in plain RNNs (Clause 3.4.7)." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#recurrent> a owl:Class ;
    rdfs:label "recurrent" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Recurrent neural network with feedback connections (Clause 3.4.10)." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkArchitecture#transformer> a owl:Class ;
    rdfs:label "transformer" ;
    rdfs:subClassOf iso22989:NeuralNetworkArchitecture ;
    skos:definition "Attention-based architecture used for sequence modelling." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkPhenomenon#catastrophic_forgetting> a owl:Class ;
    rdfs:label "catastrophic_forgetting" ;
    rdfs:subClassOf iso22989:NeuralNetworkPhenomenon ;
    skos:definition "Previously learned knowledge is lost when the network is retrained on new data." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkPhenomenon#exploding_gradient> a owl:Class ;
    rdfs:label "exploding_gradient" ;
    rdfs:subClassOf iso22989:NeuralNetworkPhenomenon ;
    skos:definition "Gradient signal grows without bound across layers during back-propagation (Clause 3.4.5)." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkPhenomenon#overfitting> a owl:Class ;
    rdfs:label "overfitting" ;
    rdfs:subClassOf iso22989:NeuralNetworkPhenomenon ;
    skos:definition "Model fits training data idiosyncrasies and fails to generalise." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkPhenomenon#underfitting> a owl:Class ;
    rdfs:label "underfitting" ;
    rdfs:subClassOf iso22989:NeuralNetworkPhenomenon ;
    skos:definition "Model lacks capacity or training to capture the underlying signal." .

<https://w3id.org/lmodel/iso22989/NeuralNetworkPhenomenon#vanishing_gradient> a owl:Class ;
    rdfs:label "vanishing_gradient" ;
    rdfs:subClassOf iso22989:NeuralNetworkPhenomenon ;
    skos:definition "Gradient signal shrinks across layers during back-propagation, slowing learning." .

<https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#loosely_coupled> a owl:Class ;
    rdfs:label "loosely_coupled" ;
    rdfs:subClassOf iso22989:NeuroSymbolicApproach ;
    skos:definition "Symbolic and subsymbolic components exchange information at well-defined interfaces." .

<https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#neural_in_symbolic> a owl:Class ;
    rdfs:label "neural_in_symbolic" ;
    rdfs:subClassOf iso22989:NeuroSymbolicApproach ;
    skos:definition "Subsymbolic components invoked inside a symbolic reasoning framework." .

<https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#symbolic_in_neural> a owl:Class ;
    rdfs:label "symbolic_in_neural" ;
    rdfs:subClassOf iso22989:NeuroSymbolicApproach ;
    skos:definition "Symbolic reasoning embedded within a primarily subsymbolic architecture." .

<https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#tightly_coupled> a owl:Class ;
    rdfs:label "tightly_coupled" ;
    rdfs:subClassOf iso22989:NeuroSymbolicApproach ;
    skos:definition "Symbolic and subsymbolic components share representations end-to-end." .

<https://w3id.org/lmodel/iso22989/OECDLifecycleStage#deploy> a owl:Class ;
    rdfs:label "deploy" ;
    rdfs:subClassOf iso22989:OECDLifecycleStage ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#DEPLOY_AND_USE> ;
    skos:definition "OECD stage covering deployment of the AI system." .

<https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#action_recommendation> a owl:Class ;
    rdfs:label "action_recommendation" ;
    rdfs:subClassOf iso22989:RecommendationOutcomeType ;
    skos:definition "Suggestion of an action to take." .

<https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#content_recommendation> a owl:Class ;
    rdfs:label "content_recommendation" ;
    rdfs:subClassOf iso22989:RecommendationOutcomeType ;
    skos:definition "Suggestion of content items." .

<https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#next_best_action> a owl:Class ;
    rdfs:label "next_best_action" ;
    rdfs:subClassOf iso22989:RecommendationOutcomeType ;
    skos:definition "Recommendation of the single most appropriate next action." .

<https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#ranking_recommendation> a owl:Class ;
    rdfs:label "ranking_recommendation" ;
    rdfs:subClassOf iso22989:RecommendationOutcomeType ;
    skos:definition "Recommendation expressed as a ranked list." .

iso22989:RelevantAuthority a owl:Class ;
    rdfs:label "RelevantAuthority" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        iso22989:AIStakeholderRole ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-100-1/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT> ;
    skos:definition "Regulator or standards-setting body with oversight responsibilities (Clause 5.19.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

<https://w3id.org/lmodel/iso22989/SocietalImpactCategory#democratic_processes> a owl:Class ;
    rdfs:label "democratic_processes" ;
    rdfs:subClassOf iso22989:SocietalImpactCategory ;
    skos:definition "Effects on political discourse, elections and civic participation." .

<https://w3id.org/lmodel/iso22989/SocietalImpactCategory#digital_divide> a owl:Class ;
    rdfs:label "digital_divide" ;
    rdfs:subClassOf iso22989:SocietalImpactCategory ;
    skos:definition "Differential access to and impact of AI systems across populations." .

<https://w3id.org/lmodel/iso22989/SocietalImpactCategory#employment> a owl:Class ;
    rdfs:label "employment" ;
    rdfs:subClassOf iso22989:SocietalImpactCategory ;
    skos:definition "Effects on labour markets and the nature of work." .

<https://w3id.org/lmodel/iso22989/SocietalImpactCategory#environment> a owl:Class ;
    rdfs:label "environment" ;
    rdfs:subClassOf iso22989:SocietalImpactCategory ;
    skos:definition "Environmental footprint of AI development and deployment." .

<https://w3id.org/lmodel/iso22989/SocietalImpactCategory#human_rights> a owl:Class ;
    rdfs:label "human_rights" ;
    rdfs:subClassOf iso22989:SocietalImpactCategory ;
    skos:definition "Effects on the exercise of fundamental human rights." .

<https://w3id.org/lmodel/iso22989/SoftComputingTechnique#evolutionary_computing> a owl:Class ;
    rdfs:label "evolutionary_computing" ;
    rdfs:subClassOf iso22989:SoftComputingTechnique ;
    skos:definition "Optimisation inspired by biological evolution (including genetic algorithms)." .

<https://w3id.org/lmodel/iso22989/SoftComputingTechnique#fuzzy_logic> a owl:Class ;
    rdfs:label "fuzzy_logic" ;
    rdfs:subClassOf iso22989:SoftComputingTechnique ;
    skos:definition "Reasoning with degrees of truth rather than crisp Boolean values." .

<https://w3id.org/lmodel/iso22989/SoftComputingTechnique#neural_computing> a owl:Class ;
    rdfs:label "neural_computing" ;
    rdfs:subClassOf iso22989:SoftComputingTechnique ;
    skos:definition "Computation realised by networks of artificial neurons." .

<https://w3id.org/lmodel/iso22989/SoftComputingTechnique#probabilistic_reasoning> a owl:Class ;
    rdfs:label "probabilistic_reasoning" ;
    rdfs:subClassOf iso22989:SoftComputingTechnique ;
    skos:definition "Reasoning under uncertainty using probability theory." .

<https://w3id.org/lmodel/iso22989/SoftComputingTechnique#swarm_intelligence> a owl:Class ;
    rdfs:label "swarm_intelligence" ;
    rdfs:subClassOf iso22989:SoftComputingTechnique ;
    skos:definition "Optimisation inspired by collective behaviour of decentralised agents." .

<https://w3id.org/lmodel/iso22989/SymbolicApproach#hybrid> a owl:Class ;
    rdfs:label "hybrid" ;
    rdfs:subClassOf iso22989:SymbolicApproach ;
    skos:definition "Approaches that combine symbolic and subsymbolic techniques (neuro-symbolic AI)." .

<https://w3id.org/lmodel/iso22989/SymbolicApproach#subsymbolic> a owl:Class ;
    rdfs:label "subsymbolic" ;
    rdfs:subClassOf iso22989:SymbolicApproach ;
    skos:definition "Approaches that operate on distributed numeric representations (neural networks, statistical models)." .

<https://w3id.org/lmodel/iso22989/SymbolicApproach#symbolic> a owl:Class ;
    rdfs:label "symbolic" ;
    rdfs:subClassOf iso22989:SymbolicApproach ;
    skos:definition "Approaches that manipulate explicit symbolic representations (rules, logic, knowledge graphs)." .

iso22989:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:task_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataModality ;
            owl:onProperty iso22989:input_modalities ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:task_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataLabelType ;
            owl:onProperty iso22989:output_label_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:output_label_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:performance_metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:output_label_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:TaskCategory ;
            owl:onProperty iso22989:task_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:input_modalities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:performance_metric ],
        iso22989:NamedEntity ;
    skos:closeMatch gist_linkml:Task,
        <https://w3id.org/lmodel/nist-ai-100-1/AiSystemDimensionEnum#TASK_AND_OUTPUT> ;
    skos:definition "AI task addressed by a model or system (e.g. classification, regression, planning). Provides a first-class entity for the task categories enumerated across Clause 3 terminology." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

<https://w3id.org/lmodel/iso22989/TaskCategory#anomaly_detection> a owl:Class ;
    rdfs:label "anomaly_detection" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Identifying inputs that deviate from expected behaviour." .

<https://w3id.org/lmodel/iso22989/TaskCategory#classification> a owl:Class ;
    rdfs:label "classification" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Assigning a class label to an input." .

<https://w3id.org/lmodel/iso22989/TaskCategory#clustering> a owl:Class ;
    rdfs:label "clustering" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Grouping items by similarity without supervision." .

<https://w3id.org/lmodel/iso22989/TaskCategory#control> a owl:Class ;
    rdfs:label "control" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Selecting actions to influence a dynamical system." .

<https://w3id.org/lmodel/iso22989/TaskCategory#decision_support> a owl:Class ;
    rdfs:label "decision_support" ;
