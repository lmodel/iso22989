iso22989:KnowledgeGraph a owl:Class ;
    rdfs:label "KnowledgeGraph" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty iso22989:edge_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:node_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty iso22989:node_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:node_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:edge_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ontology_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:edge_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty iso22989:ontology_reference ],
        iso22989:KnowledgeRepresentation ;
    skos:definition "Graph-structured knowledge representation, often used for reasoning and retrieval (Clause 8.5)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    skos:relatedMatch gist_linkml:KnowledgeConcept .

