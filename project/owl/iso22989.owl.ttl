@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gist_linkml: <https://w3id.org/lmodel/gist/> .
@prefix iso22989: <https://w3id.org/lmodel/iso22989/> .
@prefix iso27001: <https://w3id.org/lmodel/iso27001/> .
@prefix iso29100: <https://w3id.org/lmodel/iso29100/> .
@prefix iso42001: <https://w3id.org/lmodel/iso42001/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nist_ai_100_1: <https://w3id.org/lmodel/nist-ai-100-1/> .
@prefix nist_ai_600_1: <https://w3id.org/lmodel/nist-ai-600-1/> .
@prefix nist_ai_rmf_common: <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco_core: <https://w3id.org/lmodel/uco-core/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/iso22989.owl.ttl> a owl:Ontology ;
    rdfs:label "iso22989" ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0" ;
    dcterms:title "ISO/IEC 22989:2022: AI Concepts and Terminology — LinkML Schema" ;
    pav:version "0.1.0" ;
    rdfs:seeAlso <https://lmodel.github.io/iso22989>,
        <https://www.iso.org/standard/74296.html> ;
    skos:definition "A LinkML schema modelling the artificial-intelligence concepts, terminology, life-cycle stages, stakeholder roles, ecosystem components and application domains defined in ISO/IEC 22989:2022. The schema supplies the controlled vocabulary referenced by sibling lmodel schemas (iso42001 AIMS, iso23894 AI risk management) and supports SSSOM mappings to adjacent AI taxonomies." ;
    iso22989:developing_committee "ISO/IEC JTC 1/SC 42 (Artificial Intelligence)" ;
    iso22989:related_standards "ISO/IEC 42001 (AI management system); ISO/IEC 23894 (AI risk management guidance); ISO/IEC 38507 (Governance implications of AI); ISO/IEC 5338 (AI system life cycle process); ISO/IEC 5259 (Data quality for analytics and ML); ISO/IEC TR 24028 (Overview of trustworthiness in AI); ISO/IEC TR 24027 (Bias in AI systems and AI aided decision making); OECD AI Principles; NIST AI Risk Management Framework (AI RMF 1.0)" ;
    iso22989:rights_notice "This project is licensed under Apache-2.0 for original schema structure and descriptions. ISO/IEC standards text is owned by ISO/IEC and is not reproduced verbatim by this project. Verbatim term definitions, where required by downstream consumers, must be supplied through a private overlay file under their own ISO licence." ;
    iso22989:schema_status "draft" ;
    iso22989:standard_date "2022-07" ;
    iso22989:standard_edition "First edition" ;
    iso22989:standard_reference "ISO/IEC 22989:2022(E)" ;
    iso22989:standard_title "Information technology — Artificial intelligence — Artificial intelligence concepts and terminology" .

iso22989:AIAuditor a owl:Class ;
    rdfs:label "AIAuditor" ;
    rdfs:subClassOf iso22989:AIPartner ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-100-1/AiActorTaskEnum#TEVV>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#TEVV> ;
    skos:definition "Partner performing independent audits of AI systems (Clause 5.19.5)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIConceptsCollection a owl:Class ;
    rdfs:label "AIConceptsCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AbbreviationEntry ;
            owl:onProperty iso22989:abbreviations ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Dataset ;
            owl:onProperty iso22989:ai_datasets ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AILifecycleProcess ;
            owl:onProperty iso22989:ai_lifecycle_processes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:data_processes ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataProcess ;
            owl:onProperty iso22989:data_processes ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:IoTSystem ;
            owl:onProperty iso22989:iot_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_applications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:iot_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_models ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIApplication ;
            owl:onProperty iso22989:ai_applications ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AISystem ;
            owl:onProperty iso22989:ai_systems ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIStakeholderRole ;
            owl:onProperty iso22989:ai_stakeholder_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:tasks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:abbreviations ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:TrustworthinessProperty ;
            owl:onProperty iso22989:trustworthiness_records ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:cyber_physical_systems ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:KnowledgeGraph ;
            owl:onProperty iso22989:knowledge_graphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:knowledge_graphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Task ;
            owl:onProperty iso22989:tasks ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:ExpertSystem ;
            owl:onProperty iso22989:expert_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:trustworthiness_records ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIModel ;
            owl:onProperty iso22989:ai_models ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_datasets ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:CyberPhysicalSystem ;
            owl:onProperty iso22989:cyber_physical_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_stakeholder_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:expert_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_lifecycle_processes ] ;
    skos:definition "Top-level container aggregating AI systems, models, datasets, lifecycle processes, stakeholder roles, applications and trustworthiness records for serialisation as a single artefact." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIEvaluator a owl:Class ;
    rdfs:label "AIEvaluator" ;
    rdfs:subClassOf iso22989:AIPartner ;
    skos:definition "Partner performing evaluations of AI system performance and trustworthiness (Clause 5.19.5)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIPlatformProvider a owl:Class ;
    rdfs:label "AIPlatformProvider" ;
    rdfs:subClassOf iso22989:AIProvider ;
    skos:definition "Provider of platform infrastructure on which AI services are operated (Clause 5.19.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIServiceProductProvider a owl:Class ;
    rdfs:label "AIServiceProductProvider" ;
    rdfs:subClassOf iso22989:AIProvider ;
    skos:definition "Provider of an AI-enabled service or product to customers (Clause 5.19.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AISystemIntegrator a owl:Class ;
    rdfs:label "AISystemIntegrator" ;
    rdfs:subClassOf iso22989:AIPartner ;
    skos:definition "Partner integrating AI components into a wider system (Clause 5.19.5)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIUser a owl:Class ;
    rdfs:label "AIUser" ;
    rdfs:subClassOf iso22989:AICustomer ;
    skos:closeMatch gist_linkml:Person ;
    skos:definition "End user of an AI system or AI-backed service (Clause 5.19.4)." ;
    skos:exactMatch <https://w3id.org/lmodel/nist-ai-100-1/AiActorTaskEnum#END_USERS>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#END_USERS> ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ComputationVerifier a owl:Class ;
    rdfs:label "ComputationVerifier" ;
    rdfs:subClassOf iso22989:AIProducer ;
    skos:definition "Producer role verifying the computational behaviour of an AI system (Clause 5.19.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:DataProvider a owl:Class ;
    rdfs:label "DataProvider" ;
    rdfs:subClassOf iso22989:AIPartner ;
    skos:closeMatch iso29100:PIIController ;
    skos:definition "Partner supplying datasets used by AI systems (Clause 5.19.5)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:DataSubject a owl:Class ;
    rdfs:label "DataSubject" ;
    rdfs:subClassOf iso22989:AISubject ;
    skos:closeMatch gist_linkml:Person ;
    skos:definition "Individual whose personal data is processed by an AI system (Clause 5.19.6)." ;
    skos:exactMatch iso29100:PIIPrincipal ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ModelDesigner a owl:Class ;
    rdfs:label "ModelDesigner" ;
    rdfs:subClassOf iso22989:AIProducer ;
    skos:definition "Producer role responsible for designing AI models (Clause 5.19.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ModelImplementer a owl:Class ;
    rdfs:label "ModelImplementer" ;
    rdfs:subClassOf iso22989:AIProducer ;
    skos:definition "Producer role responsible for implementing AI models in code (Clause 5.19.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ModelVerifier a owl:Class ;
    rdfs:label "ModelVerifier" ;
    rdfs:subClassOf iso22989:AIProducer ;
    skos:definition "Producer role verifying that models meet specified requirements (Clause 5.19.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:NeuralNetworkModel a owl:Class ;
    rdfs:label "NeuralNetworkModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty iso22989:number_of_parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:number_of_layers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:algorithm_family ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:number_of_layers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:number_of_parameters ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty iso22989:number_of_layers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:algorithm_family ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:number_of_parameters ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:algorithm_family ],
        iso22989:AIModel ;
    skos:definition "AIModel realised as a neural network (Clause 5.12.1, Clause 3.4 terms)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:PolicyMaker a owl:Class ;
    rdfs:label "PolicyMaker" ;
    rdfs:subClassOf iso22989:RelevantAuthority ;
    skos:definition "Authority defining policy applicable to AI systems (Clause 5.19.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:Regulator a owl:Class ;
    rdfs:label "Regulator" ;
    rdfs:subClassOf iso22989:RelevantAuthority ;
    skos:definition "Authority responsible for regulatory oversight of AI systems (Clause 5.19.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:collection_date_range a owl:DatatypeProperty ;
    rdfs:label "collection_date_range" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text date range over which the data was collected." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:data_version a owl:DatatypeProperty ;
    rdfs:label "data_version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier of a dataset snapshot." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:validation_strategy a owl:ObjectProperty ;
    rdfs:label "validation_strategy" ;
    rdfs:range iso22989:ValidationStrategy ;
    skos:definition "Strategy used to estimate generalisation (Clause 5.11.8)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIAgent a owl:Class ;
    rdfs:label "AIAgent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:goal_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:agent_architecture ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AgentArchitectureType ;
            owl:onProperty iso22989:agent_architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:symbolic_approach ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:symbolic_approach ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:autonomy_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:SymbolicApproach ;
            owl:onProperty iso22989:symbolic_approach ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:agent_architecture ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AutonomyLevel ;
            owl:onProperty iso22989:autonomy_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:autonomy_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:goal_set ],
        iso22989:AIConcept ;
    skos:definition "Entity that perceives its environment and acts upon it to achieve goals (Clause 5.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AICustomer a owl:Class ;
    rdfs:label "AICustomer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:stakeholder_role_type ],
        iso22989:AIStakeholderRole ;
    skos:definition "Stakeholder using an AI system or AI-backed service (Clause 5.19.4)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIEcosystem a owl:Class ;
    rdfs:label "AIEcosystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:data_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:data_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ecosystem_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:big_data_characteristics ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AISystem ;
            owl:onProperty iso22989:ai_systems ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:ecosystem_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_stakeholder_roles ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIStakeholderRole ;
            owl:onProperty iso22989:ai_stakeholder_roles ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:ComputingResourceType ;
            owl:onProperty iso22989:computing_resources ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:BigDataCharacteristic ;
            owl:onProperty iso22989:big_data_characteristics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:computing_resources ],
        iso22989:NamedEntity ;
    skos:definition "Aggregation of the AI systems, data sources, computing resources and stakeholder roles that surround a deployment context (Clause 8)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AISubject a owl:Class ;
    rdfs:label "AISubject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:stakeholder_role_type ],
        iso22989:AIStakeholderRole ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-100-1/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#AFFECTED_INDIVIDUALS_AND_COMMUNITIES> ;
    skos:definition "Person or group affected by an AI system (Clause 5.19.6)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AITerm a owl:Class ;
    rdfs:label "AITerm" ;
    rdfs:subClassOf iso22989:Term ;
    skos:definition "Term defined in Clause 3.1 (terms related to AI)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    iso22989:clause_section "3.1" .

iso22989:AbbreviatedTerm a owl:Class ;
    rdfs:label "AbbreviatedTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:expansion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:expansion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:expansion ],
        iso22989:NamedEntity ;
    skos:definition "Abbreviation or acronym listed in Clause 4 with its expansion and optional definition reference." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso22989:ExecutionStatus ;
            owl:onProperty iso22989:execution_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:execution_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:triggered_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:execution_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:action_target ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:action_target ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:action_target ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Decision ;
            owl:onProperty iso22989:triggered_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:triggered_by ],
        iso22989:NamedEntity ;
    skos:closeMatch gist_linkml:Event ;
    skos:definition "Action carried out as a result of an AI-system decision (Clause 7.4.4)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AutonomyAssessment a owl:Class ;
    rdfs:label "AutonomyAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:autonomy_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:autonomy_criterion_scores ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:autonomy_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AutonomyLevel ;
            owl:onProperty iso22989:autonomy_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:autonomy_criterion_scores ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ) ] ) ] ;
            owl:onProperty iso22989:clause_reference ],
        iso22989:NamedEntity ;
    skos:definition "Structured assessment of the autonomy level of an AI system using the criteria listed in Clause 5.13." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:CatastrophicForgetting a owl:Class ;
    rdfs:label "CatastrophicForgetting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:affected_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:mitigation_strategy ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIModel ;
            owl:onProperty iso22989:affected_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:affected_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:mitigation_strategy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:mitigation_strategy ],
        iso22989:NamedEntity ;
    skos:definition "Phenomenon by which a continually-trained model loses previously acquired competence (Clause 5.11.9.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:CognitiveComputingSystem a owl:Class ;
    rdfs:label "CognitiveComputingSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:cognitive_capabilities ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:cognitive_capabilities ],
