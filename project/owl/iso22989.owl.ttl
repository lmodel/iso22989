iso22989:aic_system_jurisdictional_issues a owl:DatatypeProperty ;
	rdfs:label "aic_system_jurisdictional_issues" ;
	skos:definition "The legal questions that follow from where it is built, offered or used." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.17" .
iso22989:aic_system_models a owl:ObjectProperty ;
	rdfs:label "aic_system_models" ;
	skos:definition "The models it uses." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_purpose a owl:DatatypeProperty ;
	rdfs:label "aic_system_purpose" ;
	skos:definition "What the system is meant to do." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_resource_pools a owl:ObjectProperty ;
	rdfs:label "aic_system_resource_pools" ;
	skos:definition "The computing resources it runs on." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_scope a owl:ObjectProperty ;
	rdfs:label "aic_system_scope" ;
	skos:definition "How wide a range of problems the system can take on." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_societal_impacts a owl:DatatypeProperty ;
	rdfs:label "aic_system_societal_impacts" ;
	skos:definition "The effects it may have on people and society beyond its users." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.18" .
iso22989:aic_system_stage a owl:ObjectProperty ;
	rdfs:label "aic_system_stage" ;
	skos:definition "The stage of its life the system is in now." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_stakeholders a owl:ObjectProperty ;
	rdfs:label "aic_system_stakeholders" ;
	skos:definition "The parties around it." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_steps a owl:ObjectProperty ;
	rdfs:label "aic_system_steps" ;
	skos:definition "The steps from data to action that it performs." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_tasks a owl:ObjectProperty ;
	rdfs:label "aic_system_tasks" ;
	skos:definition "The tasks it takes on." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_techniques a owl:ObjectProperty ;
	rdfs:label "aic_system_techniques" ;
	skos:definition "The families of technique it is built with." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_system_type a owl:DatatypeProperty ;
	rdfs:label "aic_system_type" ;
	rdfs:range xsd:string ;
	skos:definition "Which class this record is: AicSystem or a kind of it." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_task_goal a owl:DatatypeProperty ;
	rdfs:label "aic_task_goal" ;
	skos:definition "What getting the task done achieves." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_task_kind a owl:ObjectProperty ;
	rdfs:label "aic_task_kind" ;
	skos:definition "The named kind of task it is, where it is one." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> .
iso22989:aic_task_languages a owl:DatatypeProperty ;
	rdfs:label "aic_task_languages" ;
	skos:definition "The human languages the task works in, as language tags such as en or fr-CA." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_term "3.6.7" .
iso22989:aic_task_performance_measures a owl:DatatypeProperty ;
	rdfs:label "aic_task_performance_measures" ;
	skos:definition "What is measured to judge how well it is done, such as accuracy." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_term "3.1.25" .
iso22989:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the record describes, in its author's words." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
iso22989:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "The name the record's author gives it." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
