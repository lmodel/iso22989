        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:organization_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:contact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:responsibilities ],
        [ a owl:Restriction ;
