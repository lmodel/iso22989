        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty iso22989:inference_latency_ms ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Dataset ;
            owl:onProperty iso22989:test_dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Dataset ;
            owl:onProperty iso22989:validation_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:training_dataset ],
        iso22989:NamedEntity ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-100-1/AiSystemDimensionEnum#AI_MODEL> ;
    skos:definition "Trained or rule-based model embedded in an AI system. Carries paradigm, algorithm family, dataset references and version metadata." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    skos:relatedMatch nist_ai_100_1:Model .

