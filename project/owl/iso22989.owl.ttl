<https://w3id.org/lmodel/iso22989/TaskCategory#dimensionality_reduction> a owl:Class ;
    rdfs:label "dimensionality_reduction" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Producing a lower-dimensional representation of the data." .

<https://w3id.org/lmodel/iso22989/TaskCategory#generation> a owl:Class ;
    rdfs:label "generation" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Producing new content (text, images, audio, etc.)." .

<https://w3id.org/lmodel/iso22989/TaskCategory#planning> a owl:Class ;
    rdfs:label "planning" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Producing a sequence of actions that achieve a goal." .

<https://w3id.org/lmodel/iso22989/TaskCategory#ranking> a owl:Class ;
    rdfs:label "ranking" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Ordering items by relevance or preference." .

<https://w3id.org/lmodel/iso22989/TaskCategory#recommendation> a owl:Class ;
    rdfs:label "recommendation" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Suggesting items to a user given context." .

<https://w3id.org/lmodel/iso22989/TaskCategory#regression> a owl:Class ;
    rdfs:label "regression" ;
    rdfs:subClassOf iso22989:TaskCategory ;
    skos:definition "Predicting a continuous numeric value." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#accountability> a owl:Class ;
    rdfs:label "accountability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of having identifiable parties answerable for system behaviour and outcomes." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#authenticity> a owl:Class ;
    rdfs:label "authenticity" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of being able to verify the origin and identity of inputs, models and outputs (Clause 5.15 Note)." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#availability> a owl:Class ;
    rdfs:label "availability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of being accessible and usable on demand by authorised entities (Clause 5.15.3 context)." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#bias_mitigation> a owl:Class ;
    rdfs:label "bias_mitigation" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of identifying and reducing unwanted bias in data, models or outcomes." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#controllability> a owl:Class ;
    rdfs:label "controllability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of allowing authorised humans to intervene in system behaviour." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#explainability> a owl:Class ;
    rdfs:label "explainability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of producing explanations of system behaviour that are intelligible to relevant audiences." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#fairness> a owl:Class ;
    rdfs:label "fairness" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of avoiding inappropriate or harmful discrimination across groups." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#fault_tolerance> a owl:Class ;
    rdfs:label "fault_tolerance" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of continuing to operate correctly in the presence of component faults (Clause 5.15.4 context)." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#integrity> a owl:Class ;
    rdfs:label "integrity" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_INTEGRITY> ;
    skos:definition "Property of safeguarding accuracy and completeness of data, models and outputs (Clause 5.15 Note)." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#predictability> a owl:Class ;
    rdfs:label "predictability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of behaviour being anticipatable given known inputs and state." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#quality> a owl:Class ;
    rdfs:label "quality" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Aggregate property reflecting how well the AI system meets stated and implied needs (Clause 5.15 Note)." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#reliability> a owl:Class ;
    rdfs:label "reliability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Consistent intended behaviour over time under stated conditions." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#resilience> a owl:Class ;
    rdfs:label "resilience" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Ability to recover acceptable behaviour after disruption or failure." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#robustness> a owl:Class ;
    rdfs:label "robustness" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Ability to maintain performance under varied or adversarial conditions." .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#security> a owl:Class ;
    rdfs:label "security" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_SECURITY> ;
    skos:definition "Property of preserving confidentiality, integrity and availability of the AI system and its data (Clause 5.15 context)." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT> ;
    skos:relatedMatch iso27001:InformationSecurityManagementSystem .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#transparency> a owl:Class ;
    rdfs:label "transparency" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of disclosing meaningful information about the system to interested parties." ;
    skos:narrowMatch <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT> .

<https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#usability> a owl:Class ;
    rdfs:label "usability" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of being effectively, efficiently and satisfactorily usable by the intended users (Clause 5.15 Note)." .

<https://w3id.org/lmodel/iso22989/ValidationStrategy#bootstrap> a owl:Class ;
    rdfs:label "bootstrap" ;
    rdfs:subClassOf iso22989:ValidationStrategy ;
    skos:definition "Resampling-with-replacement estimation of generalisation error." .

<https://w3id.org/lmodel/iso22989/ValidationStrategy#cross_validation> a owl:Class ;
    rdfs:label "cross_validation" ;
    rdfs:subClassOf iso22989:ValidationStrategy ;
    skos:definition "K-fold cross-validation." .

<https://w3id.org/lmodel/iso22989/ValidationStrategy#holdout> a owl:Class ;
    rdfs:label "holdout" ;
    rdfs:subClassOf iso22989:ValidationStrategy ;
    skos:definition "Single train / validation / test split." .

<https://w3id.org/lmodel/iso22989/ValidationStrategy#stratified_cross_validation> a owl:Class ;
    rdfs:label "stratified_cross_validation" ;
    rdfs:subClassOf iso22989:ValidationStrategy ;
    skos:definition "Cross-validation that preserves class distribution in each fold." .

<https://w3id.org/lmodel/iso22989/ValidationStrategy#time_series_split> a owl:Class ;
    rdfs:label "time_series_split" ;
    rdfs:subClassOf iso22989:ValidationStrategy ;
    skos:definition "Forward-chaining split that respects temporal order." .

<https://w3id.org/lmodel/iso22989/ValidationStrategy#two_way_split> a owl:Class ;
    rdfs:label "two_way_split" ;
    rdfs:subClassOf iso22989:ValidationStrategy ;
    skos:definition "Two-way split (train / test) used when data is limited (Clause 5.11.8)." .

<https://w3id.org/lmodel/iso22989/VerificationValidationLevel#completely_verifiable> a owl:Class ;
    rdfs:label "completely_verifiable" ;
    rdfs:subClassOf iso22989:VerificationValidationLevel ;
    skos:definition "System behaviour is fully verifiable against specifications." .

<https://w3id.org/lmodel/iso22989/VerificationValidationLevel#partially_verifiable_validatable> a owl:Class ;
    rdfs:label "partially_verifiable_validatable" ;
    rdfs:subClassOf iso22989:VerificationValidationLevel ;
    skos:definition "System is partially verifiable and validatable against specifications." .

<https://w3id.org/lmodel/iso22989/VerificationValidationLevel#unverifiable_partially_validatable> a owl:Class ;
    rdfs:label "unverifiable_partially_validatable" ;
    rdfs:subClassOf iso22989:VerificationValidationLevel ;
    skos:definition "System is not verifiable and only partially validatable." .

<https://w3id.org/lmodel/iso22989/VerificationValidationLevel#unverifiable_unvalidatable> a owl:Class ;
    rdfs:label "unverifiable_unvalidatable" ;
    rdfs:subClassOf iso22989:VerificationValidationLevel ;
    skos:definition "System is neither verifiable nor validatable with available techniques." .

<https://w3id.org/lmodel/iso22989/VerificationValidationLevel#unverifiable_validatable> a owl:Class ;
    rdfs:label "unverifiable_validatable" ;
    rdfs:subClassOf iso22989:VerificationValidationLevel ;
    skos:definition "System is not verifiable but its behaviour can be validated empirically." .

