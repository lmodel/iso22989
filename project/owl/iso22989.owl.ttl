iso22989:AicOecdLifecycleStage a owl:Class ;
	rdfs:label "AicOecdLifecycleStage" ;
	owl:unionOf _:c14n221 ;
	skos:definition "A phase of the OECD's account of an AI system's life, which Annex A sets beside the standard's." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "NIST's AI Risk Management Framework names the first six phases too, with deploy as deploy and use, and lmodel/nist-ai-100-1 renders them, so each maps to NIST's stage by close_mappings." , "The first six values are the phases the OECD Recommendation on Artificial Intelligence (OECD/LEGAL/0449) named when the standard was published, as the OECD Framework for the Classification of AI Systems (2022) draws them. The Recommendation as revised on 3 May 2024 names seven: it adds retiring or decommissioning, widens building to adapting a model that exists, and widens checking to testing and evaluation. The descriptions follow the revised text, read at legalinstruments.oecd.org on 2026-11-05, and retire_or_decommission is here for a record that follows it." ;
	linkml:permissible_values iso22989:AicOecdLifecycleStage\#build_and_use_model , iso22989:AicOecdLifecycleStage\#collect_and_process_data , iso22989:AicOecdLifecycleStage\#deploy , iso22989:AicOecdLifecycleStage\#operate_and_monitor , iso22989:AicOecdLifecycleStage\#plan_and_design , iso22989:AicOecdLifecycleStage\#retire_or_decommission , iso22989:AicOecdLifecycleStage\#verify_and_validate ;
	iso22989:iso22989_clause "Annex A" ;
	iso22989:oecd_source "OECD/LEGAL/0449" .
iso22989:AicPrediction a owl:Class ;
	rdfs:label "AicPrediction" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n115 , _:c14n131 , _:c14n2 , _:c14n230 , _:c14n26 , _:c14n392 , _:c14n393 , _:c14n446 , _:c14n451 ;
	skos:definition "A result a system worked out for one case." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "7.4.2" ;
	iso22989:iso22989_term "3.1.27" .
iso22989:AicRecordMixin a owl:Class ;
	rdfs:label "AicRecordMixin" ;
	rdfs:subClassOf _:c14n147 , _:c14n155 , _:c14n250 , _:c14n318 , _:c14n338 , _:c14n343 , _:c14n410 , _:c14n52 , _:c14n9 ;
	skos:definition "What every record has, so that other records can refer to it: an identifier, a title and a description." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are. lokf adapt replaces aic_id with LOKF's id, and a class that declares id itself must descend from Concept." .
