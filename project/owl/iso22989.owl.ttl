iso22989:AicStakeholder a owl:Class ;
	rdfs:label "AicStakeholder" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n135 , _:c14n19 , _:c14n225 , _:c14n331 , _:c14n35 , _:c14n356 , _:c14n419 , _:c14n434 , _:c14n453 , _:c14n59 , _:c14n80 , _:c14n90 , _:c14n97 ;
	skos:definition "A person, group or organization with a part in an AI system or an interest in it." ;
