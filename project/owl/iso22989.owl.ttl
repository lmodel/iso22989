	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicStakeholderRole\#ai_customer , iso22989:AicStakeholderRole\#ai_partner , iso22989:AicStakeholderRole\#ai_producer , iso22989:AicStakeholderRole\#ai_provider , iso22989:AicStakeholderRole\#ai_subject , iso22989:AicStakeholderRole\#relevant_authority ;
