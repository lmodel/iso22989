iso22989:AicTrustworthinessClaim a owl:Class ;
	rdfs:label "AicTrustworthinessClaim" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n11 , _:c14n126 , _:c14n164 , _:c14n20 , _:c14n202 , _:c14n305 , _:c14n407 , _:c14n423 , _:c14n440 , _:c14n63 , _:c14n73 ;
	skos:definition "A claim that a system has a property people can rely on, with what backs it." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.15.1" ;
	iso22989:iso22989_term "3.5.16" .
iso22989:AicTrustworthinessProperty\#accountability a owl:Class ;
	rdfs:label "accountability" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:broadMatch nist_ai_100_1:AiRmfCharacteristicName\#accountable_and_transparent ;
	skos:definition "Someone answers for what the system does and decides." ;
	iso22989:iso22989_term "3.5.1, 3.5.2" .
iso22989:AicTrustworthinessProperty\#availability a owl:Class ;
	rdfs:label "availability" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:definition "Those entitled to use it can reach it and use it when they ask." ;
	iso22989:iso22989_term "3.5.3" .
iso22989:AicTrustworthinessProperty\#bias_and_fairness a owl:Class ;
	rdfs:label "bias_and_fairness" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:closeMatch nist_ai_100_1:AiRmfCharacteristicName\#fair_with_harmful_bias_managed ;
	skos:definition "Whether the system treats some people or things worse than others, as a pattern." ;
	iso22989:iso22989_clause "5.15.9" ;
	iso22989:iso22989_term "3.5.4" .
iso22989:AicTrustworthinessProperty\#controllability a owl:Class ;
	rdfs:label "controllability" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:definition "A person or another system can step in and steer it." ;
	iso22989:iso22989_clause "5.15.5" ;
	iso22989:iso22989_term "3.5.5, 3.5.6" .
iso22989:AicTrustworthinessProperty\#explainability a owl:Class ;
	rdfs:label "explainability" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:broadMatch nist_ai_100_1:AiRmfCharacteristicName\#explainable_and_interpretable ;
	skos:definition "Can say, in terms people follow, what drove a result." ;
	iso22989:iso22989_clause "5.15.6" ;
	iso22989:iso22989_term "3.5.7" .
iso22989:AicTrustworthinessProperty\#organizational_transparency a owl:Class ;
	rdfs:label "organizational_transparency" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:broadMatch nist_ai_100_1:AiRmfCharacteristicName\#accountable_and_transparent ;
	skos:definition "The organization tells those concerned what it does and decides." ;
	iso22989:iso22989_clause "5.15.8" ;
	iso22989:iso22989_term "3.5.14" .
iso22989:AicTrustworthinessProperty\#predictability a owl:Class ;
	rdfs:label "predictability" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:definition "Lets people form sound expectations of what it will produce." ;
	iso22989:iso22989_clause "5.15.7" ;
	iso22989:iso22989_term "3.5.8" .
iso22989:AicTrustworthinessProperty\#reliability a owl:Class ;
	rdfs:label "reliability" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:broadMatch nist_ai_100_1:AiRmfCharacteristicName\#valid_and_reliable ;
	skos:definition "Behaves and delivers as intended, time after time." ;
	iso22989:iso22989_clause "5.15.3" ;
	iso22989:iso22989_term "3.5.9" .
iso22989:AicTrustworthinessProperty\#resilience a owl:Class ;
	rdfs:label "resilience" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:broadMatch nist_ai_100_1:AiRmfCharacteristicName\#secure_and_resilient ;
	skos:definition "Gets back to working order soon after something goes wrong." ;
	iso22989:iso22989_clause "5.15.4" ;
	iso22989:iso22989_term "3.5.10" .
iso22989:AicTrustworthinessProperty\#robustness a owl:Class ;
	rdfs:label "robustness" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:definition "Keeps performing well when conditions turn hostile or unusual." ;
	iso22989:iso22989_clause "5.15.2" ;
	iso22989:iso22989_term "3.5.12" .
iso22989:AicTrustworthinessProperty\#system_transparency a owl:Class ;
	rdfs:label "system_transparency" ;
	rdfs:subClassOf iso22989:AicTrustworthinessProperty ;
	skos:broadMatch nist_ai_100_1:AiRmfCharacteristicName\#accountable_and_transparent ;
	skos:definition "Those concerned can learn what they need to know about the system." ;
	iso22989:iso22989_clause "5.15.8" ;
	iso22989:iso22989_term "3.5.15" .
iso22989:AicTrustworthinessProperty a owl:Class ;
	rdfs:label "AicTrustworthinessProperty" ;
	owl:unionOf _:c14n334 ;
