	iso22989:iso22989_clause "9" .
iso22989:AicFunctionalStep\#action a owl:Class ;
	rdfs:label "action" ;
	rdfs:subClassOf iso22989:AicFunctionalStep ;
	skos:definition "Carrying out what was chosen." ;
	iso22989:iso22989_clause "7.4.4" .
iso22989:AicFunctionalStep\#data_and_information a owl:Class ;
	rdfs:label "data_and_information" ;
	rdfs:subClassOf iso22989:AicFunctionalStep ;
