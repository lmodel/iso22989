iso22989:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:feature_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:data_quality_notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:ground_truth_available ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:feature_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataModality ;
            owl:onProperty iso22989:data_modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:data_modality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:dataset_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:record_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:label_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty iso22989:contains_personal_data ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:label_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:data_processes_applied ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty iso22989:ground_truth_available ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataLabelType ;
            owl:onProperty iso22989:label_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty iso22989:feature_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:record_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:contains_personal_data ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty iso22989:record_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:data_provenance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:data_quality_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:data_quality_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:dataset_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:contains_personal_data ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataProcess ;
            owl:onProperty iso22989:data_processes_applied ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:data_provenance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ground_truth_available ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DatasetRole ;
            owl:onProperty iso22989:dataset_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:data_provenance ],
        iso22989:NamedEntity ;
    skos:definition "Collection of data items used by an AI system in a training, validation, test, reference or production role." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    skos:relatedMatch schema1:Dataset,
        iso27001:Asset,
        iso29100:PersonallyIdentifiableInformation,
        uco_core:UcoObject .

xsd:float a rdfs:Datatype ;
    owl:equivalentClass [ owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
                        owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] .

