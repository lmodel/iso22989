<https://w3id.org/lmodel/iso22989.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://www.iso.org/standard/74296.html> ;
	dcterms:title "ISO/IEC 22989:2022 AI concepts and terminology" ;
	pav:version "2022" ;
	a owl:Ontology ;
	rdfs:label "iso22989" ;
	rdfs:seeAlso <https://lmodel.github.io/iso22989> , <https://www.iso.org/standard/74296.html> ;
	skos:definition "A LinkML vocabulary for describing an AI system in the terms of ISO/IEC 22989:2022: the system and its kinds, its models, data and tasks, its place in the life cycle, the parties around it, the trustworthiness claims made for it, and the fields and applications it belongs to." ;
	skos:note "Every record that other records refer to has an aic_id, and a reference holds that identifier. AicEcosystem holds each kind of record in a list of its own." , "ISO/IEC 22989 is copyright ISO and IEC, and none of its text is reproduced here. Each element cites what it renders by number, in the iso22989_term annotation for a term of Clause 3 and the iso22989_clause annotation for a clause, and its description is this project's own words. A reader with a licensed copy looks the standard's wording up there by those numbers." , "The version is the edition the schema models, and source is ISO's page for that edition. ISO Open Data's records of it and of the two amendments in progress are copied to src/iso22989/schema/iso-open-data/ as of the date in the annotations, and scripts/check_upstream_release.py reports when ISO publishes one of them or another edition. The release tags are the schema's own versions." , "tests/iso22989_numbers.yaml lists every term number and says which element renders it, or why none does." ;
	iso22989:edition "1" ;
	iso22989:iso_open_data_date "2026-11-05" ;
	iso22989:publication_date "2022-07-19" ;
	iso22989:standard "ISO/IEC 22989:2022" .
iso22989:AicAction a owl:Class ;
	rdfs:label "AicAction" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n104 , _:c14n105 , _:c14n113 , _:c14n224 , _:c14n251 , _:c14n30 , _:c14n390 , _:c14n411 , _:c14n65 ;
	skos:definition "What was done because of a decision." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "7.4.4" .
iso22989:AicAgent a owl:Class ;
	rdfs:label "AicAgent" ;
	rdfs:subClassOf iso22989:AicSystem , _:c14n103 , _:c14n125 , _:c14n160 , _:c14n444 , _:c14n54 ;
	skos:definition "A system that perceives its surroundings and acts on them in pursuit of goals." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.3" ;
	iso22989:iso22989_term "3.1.1" .
iso22989:AicAlgorithmFamily\#bayesian_network a owl:Class ;
	rdfs:label "bayesian_network" ;
	rdfs:subClassOf iso22989:AicAlgorithmFamily ;
	skos:definition "A graph of variables and how the probability of one depends on others." ;
	iso22989:iso22989_clause "5.12.2" ;
	iso22989:iso22989_term "3.3.1" .
iso22989:AicAlgorithmFamily\#decision_tree a owl:Class ;
	rdfs:label "decision_tree" ;
	rdfs:subClassOf iso22989:AicAlgorithmFamily ;
	skos:definition "A series of branching tests that end in a result." ;
	iso22989:iso22989_clause "5.12.3" ;
	iso22989:iso22989_term "3.3.2" .
iso22989:AicAlgorithmFamily\#neural_network a owl:Class ;
	rdfs:label "neural_network" ;
	rdfs:subClassOf iso22989:AicAlgorithmFamily ;
	skos:definition "Layers of simple units whose connection weights are tuned to the data." ;
	iso22989:iso22989_clause "5.12.1" .
iso22989:AicAlgorithmFamily\#support_vector_machine a owl:Class ;
	rdfs:label "support_vector_machine" ;
	rdfs:subClassOf iso22989:AicAlgorithmFamily ;
	skos:definition "Finds the widest gap that separates the classes of example." ;
	iso22989:iso22989_clause "5.12.4" ;
	iso22989:iso22989_term "3.3.13" .
iso22989:AicAlgorithmFamily a owl:Class ;
	rdfs:label "AicAlgorithmFamily" ;
	owl:unionOf _:c14n383 ;
	skos:definition "A family of algorithms that fit machine learning models." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicAlgorithmFamily\#bayesian_network , iso22989:AicAlgorithmFamily\#decision_tree , iso22989:AicAlgorithmFamily\#neural_network , iso22989:AicAlgorithmFamily\#support_vector_machine ;
	iso22989:iso22989_clause "5.12" ;
	iso22989:iso22989_term "3.3.6" .
iso22989:AicApplication a owl:Class ;
	rdfs:label "AicApplication" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n107 , _:c14n171 , _:c14n239 , _:c14n247 , _:c14n260 , _:c14n266 , _:c14n368 , _:c14n415 , _:c14n422 , _:c14n430 , _:c14n439 , _:c14n75 ;
	skos:definition "One use of a system in a line of work." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "10" .
iso22989:AicApplicationDomain\#automated_vehicles a owl:Class ;
	rdfs:label "automated_vehicles" ;
	rdfs:subClassOf iso22989:AicApplicationDomain ;
	skos:definition "Vehicles that drive part or all of the way without a driver." ;
	iso22989:iso22989_clause "10.3" .
iso22989:AicApplicationDomain\#fraud_detection a owl:Class ;
	rdfs:label "fraud_detection" ;
	rdfs:subClassOf iso22989:AicApplicationDomain ;
	skos:definition "Spotting dishonest transactions or claims." ;
	iso22989:iso22989_clause "10.2" .
iso22989:AicApplicationDomain\#predictive_maintenance a owl:Class ;
	rdfs:label "predictive_maintenance" ;
	rdfs:subClassOf iso22989:AicApplicationDomain ;
	skos:definition "Forecasting when equipment needs attention, before it fails." ;
	iso22989:iso22989_clause "10.4" .
iso22989:AicApplicationDomain a owl:Class ;
	rdfs:label "AicApplicationDomain" ;
	owl:unionOf _:c14n424 ;
	skos:definition "A domain the standard works through as an application of AI." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicApplicationDomain\#automated_vehicles , iso22989:AicApplicationDomain\#fraud_detection , iso22989:AicApplicationDomain\#predictive_maintenance ;
	iso22989:iso22989_clause "10" .
iso22989:AicApproach\#subsymbolic a owl:Class ;
	rdfs:label "subsymbolic" ;
	rdfs:subClassOf iso22989:AicApproach ;
	skos:definition "Works on numeric encodings that carry meaning only as a whole, such as the weights of a network." ;
	iso22989:iso22989_term "3.1.34" .
iso22989:AicApproach\#symbolic a owl:Class ;
	rdfs:label "symbolic" ;
	rdfs:subClassOf iso22989:AicApproach ;
	skos:definition "Works by manipulating explicit symbols and the rules that relate them." ;
	iso22989:iso22989_term "3.1.33" .
iso22989:AicApproach a owl:Class ;
	rdfs:label "AicApproach" ;
	owl:unionOf _:c14n398 ;
	skos:definition "Whether a system works on explicit symbols or on learned numeric encodings." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicApproach\#subsymbolic , iso22989:AicApproach\#symbolic ;
	iso22989:iso22989_clause "5.9" .
iso22989:AicAssessment a owl:Class ;
	rdfs:label "AicAssessment" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n13 , _:c14n264 , _:c14n267 , _:c14n268 , _:c14n284 , _:c14n296 , _:c14n320 , _:c14n342 , _:c14n353 , _:c14n355 , _:c14n387 , _:c14n418 , _:c14n42 , _:c14n78 , _:c14n8 ;
	skos:definition "One verification or validation of a system." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.16" .
iso22989:AicAssessmentKind\#validation a owl:Class ;
	rdfs:label "validation" ;
	rdfs:subClassOf iso22989:AicAssessmentKind ;
	skos:definition "Evidence shows that the system suits the use it is meant for." ;
	iso22989:iso22989_term "3.5.18" .
iso22989:AicAssessmentKind\#verification a owl:Class ;
	rdfs:label "verification" ;
	rdfs:subClassOf iso22989:AicAssessmentKind ;
	skos:definition "Evidence shows that the system meets what was specified for it." ;
	iso22989:iso22989_term "3.5.17" .
iso22989:AicAssessmentKind a owl:Class ;
	rdfs:label "AicAssessmentKind" ;
	owl:unionOf _:c14n333 ;
	skos:definition "Which question an assessment answers." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicAssessmentKind\#validation , iso22989:AicAssessmentKind\#verification ;
	iso22989:iso22989_clause "5.16" .
iso22989:AicAutonomy\#autonomous a owl:Class ;
	rdfs:label "autonomous" ;
	rdfs:subClassOf iso22989:AicAutonomy ;
	skos:definition "Can change what it is for or where it applies with nobody directing it." ;
	iso22989:iso22989_term "3.1.5" .
iso22989:AicAutonomy\#heteronomous a owl:Class ;
	rdfs:label "heteronomous" ;
	rdfs:subClassOf iso22989:AicAutonomy ;
	skos:definition "Stays under the direction of a person or another system." ;
	iso22989:iso22989_term "3.1.16" .
iso22989:AicAutonomy a owl:Class ;
	rdfs:label "AicAutonomy" ;
	owl:unionOf _:c14n158 ;
	skos:definition "Whether a system can change its own remit or stays under outside direction." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicAutonomy\#autonomous , iso22989:AicAutonomy\#heteronomous ;
	iso22989:iso22989_clause "5.13" .
iso22989:AicComponent a owl:Class ;
	rdfs:label "AicComponent" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n118 , _:c14n218 , _:c14n300 , _:c14n309 , _:c14n384 ;
	skos:definition "A part of a system that does one job in it." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_term "3.1.2" .
iso22989:AicCyberPhysicalSystem a owl:Class ;
	rdfs:label "AicCyberPhysicalSystem" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n114 , _:c14n134 , _:c14n345 , _:c14n351 , _:c14n363 , _:c14n367 , _:c14n388 ;
	skos:definition "Computing and physical processes tied in a loop, each affecting the other." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.14.3" .
iso22989:AicDataProcess a owl:Class ;
	rdfs:label "AicDataProcess" ;
	rdfs:subClassOf _:c14n111 , _:c14n187 , _:c14n192 , _:c14n308 , _:c14n311 , _:c14n350 , _:c14n408 , _:c14n41 , _:c14n66 ;
	skos:definition "One piece of work done on a dataset." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "5.10" .
iso22989:AicDataProcessKind\#data_annotation a owl:Class ;
	rdfs:label "data_annotation" ;
	rdfs:subClassOf iso22989:AicDataProcessKind ;
	skos:definition "Adds descriptive notes to data and leaves the data itself as it was." ;
	iso22989:iso22989_term "3.2.1" .
iso22989:AicDataProcessKind\#data_augmentation a owl:Class ;
	rdfs:label "data_augmentation" ;
	rdfs:subClassOf iso22989:AicDataProcessKind ;
	skos:definition "Makes new samples out of existing ones by altering them." ;
	iso22989:iso22989_term "3.2.3" .
iso22989:AicDataProcessKind\#data_quality_checking a owl:Class ;
	rdfs:label "data_quality_checking" ;
	rdfs:subClassOf iso22989:AicDataProcessKind ;
	skos:definition "Looks for gaps, skew and whatever else would limit the data's use." ;
	iso22989:iso22989_term "3.2.2" .
iso22989:AicDataProcessKind\#data_sampling a owl:Class ;
	rdfs:label "data_sampling" ;
	rdfs:subClassOf iso22989:AicDataProcessKind ;
	skos:definition "Picks a smaller part of the data that behaves like the whole." ;
	iso22989:iso22989_term "3.2.4" .
iso22989:AicDataProcessKind\#exploratory_data_analysis a owl:Class ;
	rdfs:label "exploratory_data_analysis" ;
	rdfs:subClassOf iso22989:AicDataProcessKind ;
	skos:definition "A first look at data to learn its shape and what it may hold." ;
	iso22989:iso22989_term "3.2.6" .
iso22989:AicDataProcessKind\#imputation a owl:Class ;
	rdfs:label "imputation" ;
	rdfs:subClassOf iso22989:AicDataProcessKind ;
	skos:definition "Fills gaps with values worked out from what is there." ;
	iso22989:iso22989_term "3.2.8" .
iso22989:AicDataProcessKind a owl:Class ;
	rdfs:label "AicDataProcessKind" ;
	owl:unionOf _:c14n31 ;
	skos:definition "A kind of work done on data before or while a model uses it." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicDataProcessKind\#data_annotation , iso22989:AicDataProcessKind\#data_augmentation , iso22989:AicDataProcessKind\#data_quality_checking , iso22989:AicDataProcessKind\#data_sampling , iso22989:AicDataProcessKind\#exploratory_data_analysis , iso22989:AicDataProcessKind\#imputation ;
	iso22989:iso22989_clause "5.10" .
iso22989:AicDataset a owl:Class ;
	rdfs:label "AicDataset" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n116 , _:c14n215 , _:c14n246 , _:c14n263 , _:c14n28 , _:c14n280 , _:c14n287 , _:c14n332 , _:c14n34 , _:c14n354 , _:c14n371 , _:c14n373 , _:c14n432 , _:c14n435 , _:c14n436 , _:c14n454 , _:c14n74 , _:c14n86 ;
	skos:definition "A set of data kept together in one format." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "SPDX's DatasetPackage describes a dataset as a distributed package." ;
	skos:relatedMatch spdx_dataset:DatasetPackage ;
	iso22989:iso22989_term "3.2.5" .
iso22989:AicDatasetRole\#input a owl:Class ;
	rdfs:label "input" ;
	rdfs:subClassOf iso22989:AicDatasetRole ;
	skos:definition "What a system is given so that it can work out a result." ;
	iso22989:iso22989_term "3.2.9" .
iso22989:AicDatasetRole\#production a owl:Class ;
	rdfs:label "production" ;
	rdfs:subClassOf iso22989:AicDatasetRole ;
	skos:definition "Gathered while the system runs, when it is deployed and in real use." ;
	iso22989:iso22989_term "3.2.12" .
iso22989:AicDatasetRole\#test a owl:Class ;
	rdfs:label "test" ;
	rdfs:subClassOf iso22989:AicDatasetRole ;
	skos:definition "Held back from development, to judge the finished model." ;
	iso22989:iso22989_clause "5.11.8" ;
	iso22989:iso22989_term "3.2.14" .
iso22989:AicDatasetRole\#training a owl:Class ;
	rdfs:label "training" ;
	rdfs:subClassOf iso22989:AicDatasetRole ;
	skos:definition "Used to fit a model." ;
	iso22989:iso22989_clause "5.11.6" ;
	iso22989:iso22989_term "3.3.16" .
iso22989:AicDatasetRole\#validation a owl:Class ;
	rdfs:label "validation" ;
	rdfs:subClassOf iso22989:AicDatasetRole ;
	skos:definition "Used while developing a model, to compare versions and tune settings." ;
	iso22989:iso22989_clause "5.11.8" ;
	iso22989:iso22989_term "3.2.15" .
iso22989:AicDatasetRole a owl:Class ;
	rdfs:label "AicDatasetRole" ;
	owl:unionOf _:c14n83 ;
	skos:definition "What a dataset is used for." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicDatasetRole\#input , iso22989:AicDatasetRole\#production , iso22989:AicDatasetRole\#test , iso22989:AicDatasetRole\#training , iso22989:AicDatasetRole\#validation .
iso22989:AicDecision a owl:Class ;
	rdfs:label "AicDecision" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n133 , _:c14n178 , _:c14n188 , _:c14n214 , _:c14n226 , _:c14n254 , _:c14n326 , _:c14n361 ;
	skos:definition "A choice made on the strength of some predictions." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "7.4.3" .
iso22989:AicEcosystem a owl:Class ;
	rdfs:label "AicEcosystem" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n0 , _:c14n100 , _:c14n136 , _:c14n138 , _:c14n15 , _:c14n154 , _:c14n161 , _:c14n174 , _:c14n177 , _:c14n182 , _:c14n185 , _:c14n194 , _:c14n206 , _:c14n211 , _:c14n216 , _:c14n241 , _:c14n242 , _:c14n249 , _:c14n256 , _:c14n274 , _:c14n281 , _:c14n299 , _:c14n303 , _:c14n313 , _:c14n314 , _:c14n347 , _:c14n364 , _:c14n379 , _:c14n38 , _:c14n409 , _:c14n414 , _:c14n456 , _:c14n51 , _:c14n57 , _:c14n7 , _:c14n89 ;
	skos:definition "The AI systems around one context of use, with the data, resources and parties that surround them, each kind of record in a list of its own." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "8" .
iso22989:AicExpertSystem a owl:Class ;
	rdfs:label "AicExpertSystem" ;
	rdfs:subClassOf iso22989:AicSystem , _:c14n10 , _:c14n120 , _:c14n328 , _:c14n365 , _:c14n400 ;
	skos:definition "A system that puts what human specialists know into a form it can reason with." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	iso22989:iso22989_clause "8.5.2" ;
	iso22989:iso22989_term "3.1.13" .
iso22989:AicField\#computer_vision a owl:Class ;
	rdfs:label "computer_vision" ;
	rdfs:subClassOf iso22989:AicField ;
