iso22989:Decision a owl:Class ;
    rdfs:label "Decision" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:decision_outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:decision_policy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:based_on_predictions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:decision_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:decision_outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:decision_outcome ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Prediction ;
            owl:onProperty iso22989:based_on_predictions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:decision_policy ],
        iso22989:NamedEntity ;
    skos:closeMatch gist_linkml:Determination ;
    skos:definition "Decision produced by an AI system on the basis of one or more predictions (Clause 7.4.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

<https://w3id.org/lmodel/iso22989/EngineeringApproach#constraint_satisfaction> a owl:Class ;
    rdfs:label "constraint_satisfaction" ;
    rdfs:subClassOf iso22989:EngineeringApproach ;
    skos:definition "Solving problems by satisfying a set of declared constraints." .

<https://w3id.org/lmodel/iso22989/EngineeringApproach#expert_system> a owl:Class ;
    rdfs:label "expert_system" ;
    rdfs:subClassOf iso22989:EngineeringApproach ;
    skos:definition "Rule-based system encoding domain expertise (Clause 8.5.2)." .

<https://w3id.org/lmodel/iso22989/EngineeringApproach#knowledge_graph> a owl:Class ;
    rdfs:label "knowledge_graph" ;
    rdfs:subClassOf iso22989:EngineeringApproach ;
    skos:definition "Graph-structured knowledge representation used for reasoning and retrieval." .

<https://w3id.org/lmodel/iso22989/EngineeringApproach#logic_programming> a owl:Class ;
    rdfs:label "logic_programming" ;
    rdfs:subClassOf iso22989:EngineeringApproach ;
    skos:definition "Programming paradigm based on formal logic (Clause 8.5.3)." .

<https://w3id.org/lmodel/iso22989/ExecutionStatus#cancelled> a owl:Class ;
    rdfs:label "cancelled" ;
    rdfs:subClassOf iso22989:ExecutionStatus ;
    skos:definition "Execution was cancelled before completion." .

<https://w3id.org/lmodel/iso22989/ExecutionStatus#completed> a owl:Class ;
    rdfs:label "completed" ;
    rdfs:subClassOf iso22989:ExecutionStatus ;
    skos:definition "Execution has completed successfully." .

<https://w3id.org/lmodel/iso22989/ExecutionStatus#failed> a owl:Class ;
    rdfs:label "failed" ;
    rdfs:subClassOf iso22989:ExecutionStatus ;
    skos:definition "Execution has terminated unsuccessfully." .

<https://w3id.org/lmodel/iso22989/ExecutionStatus#in_progress> a owl:Class ;
    rdfs:label "in_progress" ;
    rdfs:subClassOf iso22989:ExecutionStatus ;
    skos:definition "Execution is currently in progress." .

<https://w3id.org/lmodel/iso22989/ExecutionStatus#planned> a owl:Class ;
    rdfs:label "planned" ;
    rdfs:subClassOf iso22989:ExecutionStatus ;
    skos:definition "Execution has been planned but not yet started." .

iso22989:ExpertSystem a owl:Class ;
    rdfs:label "ExpertSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:rule_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:inference_engine ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:rule_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:InferenceEngine ;
            owl:onProperty iso22989:inference_engine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:inference_engine ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty iso22989:rule_count ],
        iso22989:NamedEntity ;
    skos:definition "Rule-based system encoding domain expertise (Clause 8.5.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:IoTDevice a owl:Class ;
    rdfs:label "IoTDevice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:device_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:device_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:actuating_capabilities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:sensing_capabilities ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:IoTDeviceRole ;
            owl:onProperty iso22989:device_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:actuating_capabilities ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:sensing_capabilities ],
        iso22989:NamedEntity ;
    skos:definition "Device participating in an Internet-of-Things deployment (Clause 5.14.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

