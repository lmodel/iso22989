iso22989:NamedEntity a owl:Class ;
    rdfs:label "NamedEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty iso22989:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:aliases ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:preferred_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty iso22989:see_also_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ) ] ) ] ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:clause_reference ],
