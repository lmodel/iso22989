<https://w3id.org/lmodel/iso22989/DataProcessType#feature_engineering> a owl:Class ;
    rdfs:label "feature_engineering" ;
    rdfs:subClassOf iso22989:DataProcessType ;
    skos:definition "Constructing or selecting features used as model inputs." .

<https://w3id.org/lmodel/iso22989/DataProcessType#filtering> a owl:Class ;
