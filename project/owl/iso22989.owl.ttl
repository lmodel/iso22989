	rdfs:label "general_ai" ;
	rdfs:subClassOf iso22989:AicSystemScope ;
	skos:definition "Able to take on problems of many kinds, including ones it was not built for." ;
	iso22989:iso22989_term "3.1.14" .
iso22989:AicSystemScope\#narrow_ai a owl:Class ;
	rdfs:label "narrow_ai" ;
	rdfs:subClassOf iso22989:AicSystemScope ;
	skos:definition "Built for a bounded set of problems, and cannot move beyond them." ;
	iso22989:iso22989_term "3.1.24" .
iso22989:AicSystemScope a owl:Class ;
	rdfs:label "AicSystemScope" ;
	owl:unionOf _:c14n372 ;
	skos:definition "How wide a range of problems a system can take on." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicSystemScope\#general_ai , iso22989:AicSystemScope\#narrow_ai ;
	iso22989:iso22989_clause "5.2" .
iso22989:AicTask a owl:Class ;
	rdfs:label "AicTask" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n190 , _:c14n223 , _:c14n237 , _:c14n238 , _:c14n315 , _:c14n357 , _:c14n375 , _:c14n405 , _:c14n417 , _:c14n445 ;
	skos:definition "Something a system is asked to get done." ;
