iso22989:AicField a owl:Class ;
	rdfs:label "AicField" ;
	owl:unionOf _:c14n142 ;
	skos:definition "A field of AI a system belongs to." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
