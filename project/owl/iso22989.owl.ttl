iso22989:CyberPhysicalSystem a owl:Class ;
    rdfs:label "CyberPhysicalSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIComponent ;
            owl:onProperty iso22989:cyber_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:cyber_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:IoTSystem ;
            owl:onProperty iso22989:iot_subsystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:physical_processes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:physical_processes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:iot_subsystem ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:iot_subsystem ],
        iso22989:NamedEntity ;
    skos:definition "System that tightly integrates computational and physical components, typically with feedback loops between sensing and actuation (Clause 5.14.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

