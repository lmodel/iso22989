iso22989:AicStakeholderSubRole a owl:Class ;
	rdfs:label "AicStakeholderSubRole" ;
	owl:unionOf _:c14n259 ;
	skos:definition "A narrower part within one of the roles." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "Each value's role annotation names the role it sits under. The list is open, so a party whose part is not named here states its role alone." , "lmodel/iso42001 names nine more parts under the AI producer role, from clause 4.1 of ISO/IEC 42001:2023. Only a copy of each standard can settle which parts each one names." ;
	linkml:permissible_values iso22989:AicStakeholderSubRole\#ai_developer , iso22989:AicStakeholderSubRole\#ai_platform_provider , iso22989:AicStakeholderSubRole\#ai_product_or_service_provider , iso22989:AicStakeholderSubRole\#ai_system_integrator , iso22989:AicStakeholderSubRole\#ai_user , iso22989:AicStakeholderSubRole\#data_provider , iso22989:AicStakeholderSubRole\#data_subject , iso22989:AicStakeholderSubRole\#other_subject , iso22989:AicStakeholderSubRole\#policy_maker , iso22989:AicStakeholderSubRole\#regulator .
iso22989:AicSystem a owl:Class ;
	rdfs:label "AicSystem" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n112 , _:c14n121 , _:c14n130 , _:c14n151 , _:c14n169 , _:c14n172 , _:c14n173 , _:c14n179 , _:c14n199 , _:c14n200 , _:c14n208 , _:c14n212 , _:c14n213 , _:c14n219 , _:c14n220 , _:c14n222 , _:c14n229 , _:c14n243 , _:c14n244 , _:c14n248 , _:c14n255 , _:c14n27 , _:c14n282 , _:c14n292 , _:c14n293 , _:c14n307 , _:c14n316 , _:c14n324 , _:c14n352 , _:c14n36 , _:c14n366 , _:c14n381 , _:c14n395 , _:c14n399 , _:c14n40 , _:c14n438 , _:c14n44 , _:c14n443 , _:c14n67 , _:c14n70 , _:c14n79 , _:c14n81 , _:c14n82 , _:c14n91 , _:c14n94 ;
	skos:broadMatch gist_ontology:System ;
	skos:closeMatch nist_ai_100_1:AiSystem ;
	skos:definition "A system built to produce results for goals set by people, using AI techniques, whatever else it is made of." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	skos:note "NIST's AI system, as lmodel/nist-ai-100-1 renders it, is a machine-based system that produces outputs for given objectives, a definition NIST adapts from the OECD's, so the two are close." , "gist's System is any composite whose parts work as a whole, so it is the wider term. SPDX's AIPackage describes a system as a distributed package." ;
	skos:relatedMatch spdx_ai:AIPackage ;
	iso22989:iso22989_clause "8.2" ;
	iso22989:iso22989_term "3.1.4" .
