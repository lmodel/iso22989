        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:component_function ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:depends_on ],
        iso22989:NamedEntity ;
    skos:definition "Functional component of an AI system, such as a data pipeline, preprocessor, model server, or post-processing module." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

