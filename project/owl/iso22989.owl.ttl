	iso22989:iso22989_clause "7.2" .
iso22989:AicFunctionalStep\#decision a owl:Class ;
	rdfs:label "decision" ;
	rdfs:subClassOf iso22989:AicFunctionalStep ;
	skos:definition "Choosing what to do, given the results so far." ;
