iso22989:training_phenomena a owl:ObjectProperty ;
    rdfs:label "training_phenomena" ;
    skos:definition "Training-time phenomena observed for the model (Clause 3.4)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:trustworthiness_properties a owl:ObjectProperty ;
    rdfs:label "trustworthiness_properties" ;
    rdfs:range iso22989:TrustworthinessProperty ;
    skos:definition "Trustworthiness properties claimed for the AI system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:trustworthiness_records a owl:ObjectProperty ;
    rdfs:label "trustworthiness_records" ;
    rdfs:range iso22989:TrustworthinessProperty ;
    skos:definition "Trustworthiness property claims documented in the collection." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:validation_methods a owl:DatatypeProperty ;
    rdfs:label "validation_methods" ;
    skos:definition "Validation methods applied or applicable to the system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:verification_methods a owl:DatatypeProperty ;
    rdfs:label "verification_methods" ;
    skos:definition "Verification methods applied or applicable to the system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

<https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#BUILD_AND_USE_MODEL> a owl:Class ;
    rdfs:label "build_and_use_model" ;
    rdfs:subClassOf iso22989:OECDLifecycleStage ;
    skos:definition "OECD stage covering model building and inference." .

<https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA> a owl:Class ;
    rdfs:label "collect_and_process_data" ;
    rdfs:subClassOf iso22989:OECDLifecycleStage ;
    skos:definition "OECD stage covering data collection and processing." .

<https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#OPERATE_AND_MONITOR> a owl:Class ;
    rdfs:label "operate_and_monitor" ;
    rdfs:subClassOf iso22989:OECDLifecycleStage ;
    skos:definition "OECD stage covering operation and monitoring of the AI system." .

<https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#PLAN_AND_DESIGN> a owl:Class ;
    rdfs:label "plan_and_design" ;
    rdfs:subClassOf iso22989:OECDLifecycleStage ;
    skos:definition "OECD stage covering planning and design activities." .

<https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#VERIFY_AND_VALIDATE> a owl:Class ;
    rdfs:label "verify_and_validate" ;
    rdfs:subClassOf iso22989:OECDLifecycleStage ;
    skos:definition "OECD stage covering verification and validation." .

<https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED> a owl:Class ;
    rdfs:label "privacy" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:closeMatch iso29100:PrivacyPrinciple,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DATA_PRIVACY> ;
    skos:definition "Property of respecting personal data and individual privacy expectations." ;
    skos:relatedMatch iso27001:SecurityControl .

<https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#SAFE> a owl:Class ;
    rdfs:label "safety" ;
    rdfs:subClassOf iso22989:TrustworthinessPropertyType ;
    skos:definition "Property of not causing unacceptable risk of harm to people, property or environment." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> a owl:Class ;
    rdfs:label "retirement" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:definition "Decommissioning of the AI system and management of residual data and artefacts." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT> a owl:Class ;
    rdfs:label "deployment" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:definition "Release of the AI system into its operational environment." .

iso22989:AIApplication a owl:Class ;
    rdfs:label "AIApplication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:hosting_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIApplicationDomain ;
            owl:onProperty iso22989:application_domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:intended_purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:intended_purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:jurisdictional_issues ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:intended_purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:societal_impacts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:application_domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:hosting_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:SocietalImpactCategory ;
            owl:onProperty iso22989:societal_impacts ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AISystem ;
            owl:onProperty iso22989:hosting_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:JurisdictionalIssueType ;
            owl:onProperty iso22989:jurisdictional_issues ],
        iso22989:NamedEntity ;
    skos:definition "Description of an AI application instance situated in a domain (Clause 10)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AILifecycleProcess a owl:Class ;
    rdfs:label "AILifecycleProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIStakeholderRoleType ;
            owl:onProperty iso22989:responsible_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:risk_items ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:start_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso22989:start_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:process_outputs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:process_outputs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:process_sub_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:process_inputs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:risk_items ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:process_inputs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:process_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:responsible_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso22989:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:process_sub_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:approval_criteria ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:responsible_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AILifecycleStage ;
            owl:onProperty iso22989:process_stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:process_sub_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:approval_criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:process_stage ],
        iso22989:NamedEntity ;
    skos:broadMatch gist_linkml:Event ;
    skos:closeMatch nist_ai_100_1:AiLifecycleStage ;
    skos:definition "Process or activity associated with a stage of the AI system life cycle (Clause 6)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    skos:relatedMatch nist_ai_600_1:SuggestedAction .

iso22989:InferenceEngine a owl:Class ;
    rdfs:label "InferenceEngine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:inference_strategy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:inference_strategy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:uses_model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:inference_strategy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:uses_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIModel ;
            owl:onProperty iso22989:uses_model ],
        iso22989:NamedEntity ;
    skos:definition "Component performing inference over a model or knowledge base (Clause 3.1.17)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:Prediction a owl:Class ;
    rdfs:label "Prediction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty iso22989:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:predicted_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:predicted_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:predicted_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIModel ;
            owl:onProperty iso22989:produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:produced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:confidence ],
        iso22989:NamedEntity ;
    skos:definition "Prediction produced by an AI model (Clause 7.4.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:abbreviation_code a owl:ObjectProperty ;
    rdfs:label "abbreviation_code" ;
    rdfs:range iso22989:AbbreviationCode ;
    skos:definition "Acronym or abbreviation code (Clause 4)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:action_target a owl:DatatypeProperty ;
    rdfs:label "action_target" ;
    rdfs:range xsd:string ;
    skos:definition "Entity or system on which an action is performed (Clause 7.4.4)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:affected_dataset a owl:ObjectProperty ;
    rdfs:label "affected_dataset" ;
    skos:definition "Dataset in which drift was observed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:affected_model a owl:ObjectProperty ;
    rdfs:label "affected_model" ;
    skos:definition "Model in which the phenomenon was observed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ai_system_type a owl:ObjectProperty ;
    rdfs:label "ai_system_type" ;
    rdfs:range iso22989:AISystemType ;
    skos:definition "Capability classification of the AI system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:annotator a owl:ObjectProperty ;
    rdfs:label "annotator" ;
    skos:definition "Role of the party that produced the label." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:applies_to_metric a owl:DatatypeProperty ;
    rdfs:label "applies_to_metric" ;
    skos:definition "Name of the metric or score the threshold applies to." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:capacity_units a owl:DatatypeProperty ;
    rdfs:label "capacity_units" ;
    skos:definition "Capacity expressed in units appropriate to the resource type." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:catastrophic_forgetting_risk a owl:DatatypeProperty ;
    rdfs:label "catastrophic_forgetting_risk" ;
    rdfs:range xsd:float ;
    skos:definition "Estimated risk of catastrophic forgetting on retraining (Clause 5.11.9.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:component_function a owl:ObjectProperty ;
    rdfs:label "component_function" ;
    rdfs:range iso22989:AIFunctionalComponent ;
    skos:definition "Functional view component implemented by an AI component (Clause 7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:confidence_score a owl:DatatypeProperty ;
    rdfs:label "confidence_score" ;
    rdfs:range xsd:float ;
    skos:definition "Normalised confidence in the property claim." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:consequence a owl:DatatypeProperty ;
    rdfs:label "consequence" ;
    skos:definition "Consequence to one or more stakeholders if the event occurs." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:consumed_by a owl:ObjectProperty ;
    rdfs:label "consumed_by" ;
    skos:definition "AI system that consumes the input." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:contact a owl:DatatypeProperty ;
    rdfs:label "contact" ;
    rdfs:range xsd:string ;
    skos:definition "Contact identifier (e.g. email) for the stakeholder." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:contains_personal_data a owl:DatatypeProperty ;
    rdfs:label "contains_personal_data" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the dataset contains personal or personally identifiable information." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:controlled_by a owl:ObjectProperty ;
    rdfs:label "controlled_by" ;
    skos:definition "AI system that controls the robot." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:coverage_scope a owl:DatatypeProperty ;
    rdfs:label "coverage_scope" ;
    skos:definition "Scope of failure modes the mechanism covers." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:cv_task a owl:ObjectProperty ;
    rdfs:label "cv_task" ;
    rdfs:range iso22989:ComputerVisionTask ;
    skos:definition "Type of computer-vision task (Clause 9.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:data_collection_method a owl:ObjectProperty ;
    rdfs:label "data_collection_method" ;
    rdfs:range iso22989:DataCollectionMethod ;
    skos:definition "Method used to collect data (Clause 8.6.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:data_provenance a owl:DatatypeProperty ;
    rdfs:label "data_provenance" ;
    rdfs:range xsd:string ;
    skos:definition "Provenance statement for the dataset (origin, collection method, licensing)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:data_quality_notes a owl:DatatypeProperty ;
    rdfs:label "data_quality_notes" ;
    rdfs:range xsd:string ;
    skos:definition "Notes on data quality, completeness or representativeness." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:data_source_type a owl:ObjectProperty ;
    rdfs:label "data_source_type" ;
    rdfs:range iso22989:DataSourceType ;
    skos:definition "Classification of a data source (Clause 8.6.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:dataset_role a owl:ObjectProperty ;
    rdfs:label "dataset_role" ;
    rdfs:range iso22989:DatasetRole ;
    skos:definition "Role the dataset plays in the ML workflow." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:decision_outcome a owl:DatatypeProperty ;
    rdfs:label "decision_outcome" ;
    rdfs:range xsd:string ;
    skos:definition "Chosen course of action resulting from a decision (Clause 7.4.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:decision_policy a owl:DatatypeProperty ;
    rdfs:label "decision_policy" ;
    rdfs:range xsd:string ;
    skos:definition "Policy or rule used to translate predictions into a decision." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:detected_at a owl:DatatypeProperty ;
    rdfs:label "detected_at" ;
    skos:definition "Timestamp or interval at which drift was detected." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:device_role a owl:ObjectProperty ;
    rdfs:label "device_role" ;
    rdfs:range iso22989:IoTDeviceRole ;
    skos:definition "Role played by a device in an IoT or cyber-physical system (Clause 5.14.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:drift_type a owl:DatatypeProperty ;
    rdfs:label "drift_type" ;
    skos:definition "Type of drift (covariate, label, concept)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:edge_count a owl:DatatypeProperty ;
    rdfs:label "edge_count" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Approximate number of edges in a graph-structured artefact." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:embodiment a owl:DatatypeProperty ;
    rdfs:label "embodiment" ;
    skos:definition "Free-text description of the physical embodiment." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:end_date a owl:DatatypeProperty ;
    rdfs:label "end_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the process completed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:engineering_approach a owl:ObjectProperty ;
    rdfs:label "engineering_approach" ;
    rdfs:range iso22989:EngineeringApproach ;
    skos:definition "Non-learning engineering approach used (for symbolic/knowledge-based models)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:executed_by a owl:ObjectProperty ;
    rdfs:label "executed_by" ;
    skos:definition "Stakeholder role that executed the process." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:execution_status a owl:ObjectProperty ;
    rdfs:label "execution_status" ;
    rdfs:range iso22989:ExecutionStatus ;
    skos:definition "Execution status of an action or process." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:feature_count a owl:DatatypeProperty ;
    rdfs:label "feature_count" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Number of features per record in a dataset.",
        "Number of features per record." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ground_truth_available a owl:DatatypeProperty ;
    rdfs:label "ground_truth_available" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether trusted ground-truth labels are available (Clause 3.2.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ground_truth_value a owl:DatatypeProperty ;
    rdfs:label "ground_truth_value" ;
    rdfs:range xsd:string ;
    skos:definition "Trusted reference value (Clause 3.2.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:hosting_system a owl:ObjectProperty ;
    rdfs:label "hosting_system" ;
    skos:definition "AI system that provides the application." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Unique CURIE or URI identifying the entity." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:inference_engine a owl:ObjectProperty ;
    rdfs:label "inference_engine" ;
    skos:definition "Inference engine used by the expert system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:inference_latency_ms a owl:DatatypeProperty ;
    rdfs:label "inference_latency_ms" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
                        owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
    skos:definition "Typical end-to-end inference latency in milliseconds." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:input_arity a owl:DatatypeProperty ;
    rdfs:label "input_arity" ;
    skos:definition "Number of inputs combined by the neuron." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:input_dataset a owl:ObjectProperty ;
    rdfs:label "input_dataset" ;
    skos:definition "Dataset consumed by the process." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:iot_integration a owl:ObjectProperty ;
    rdfs:label "iot_integration" ;
    skos:definition "IoT/CPS system this AI system is integrated with, if any (Clause 5.14)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:iot_subsystem a owl:ObjectProperty ;
    rdfs:label "iot_subsystem" ;
    skos:definition "IoT subsystem the CPS relies on, if any." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:iso_stage a owl:ObjectProperty ;
    rdfs:label "iso_stage" ;
    skos:definition "ISO/IEC 22989 life-cycle stage." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:knowledge_type a owl:ObjectProperty ;
    rdfs:label "knowledge_type" ;
    skos:definition "Type of knowledge captured (Clause 3.1.12, 3.1.28)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:label_value a owl:DatatypeProperty ;
    rdfs:label "label_value" ;
    rdfs:range xsd:string ;
    skos:definition "Concrete label value." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:language_code a owl:DatatypeProperty ;
    rdfs:label "language_code" ;
    skos:definition "BCP-47 language tag." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:lifecycle_stage a owl:ObjectProperty ;
    rdfs:label "lifecycle_stage" ;
    rdfs:range iso22989:AILifecycleStage ;
    skos:definition "Current life-cycle stage of the AI system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:likelihood a owl:DatatypeProperty ;
    rdfs:label "likelihood" ;
    skos:definition "Estimated likelihood of the event (0.0–1.0)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:mapping_notes a owl:DatatypeProperty ;
    rdfs:label "mapping_notes" ;
    skos:definition "Free-text notes on the mapping relationship." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:measurement_method a owl:DatatypeProperty ;
    rdfs:label "measurement_method" ;
    rdfs:range xsd:string ;
    skos:definition "How the property was assessed or measured." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:mechanism_type a owl:DatatypeProperty ;
    rdfs:label "mechanism_type" ;
    skos:definition "Type of mechanism (redundancy, graceful degradation, failover, etc.)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:metric_name a owl:DatatypeProperty ;
    rdfs:label "metric_name" ;
    skos:definition "Name of the metric (e.g. accuracy, F1, MAE)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:metric_unit a owl:DatatypeProperty ;
    rdfs:label "metric_unit" ;
    skos:definition "Unit of the metric, when applicable." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:metric_value a owl:DatatypeProperty ;
    rdfs:label "metric_value" ;
    skos:definition "Observed numeric value of the metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:modality a owl:ObjectProperty ;
    rdfs:label "modality" ;
    skos:definition "Modality of the input data." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:model_compression_applied a owl:DatatypeProperty ;
    rdfs:label "model_compression_applied" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the model has had compression or distillation applied for deployment (Clause 8.6.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:model_paradigm a owl:ObjectProperty ;
    rdfs:label "model_paradigm" ;
    rdfs:range iso22989:MachineLearningParadigm ;
    skos:definition "Machine-learning paradigm under which the model was trained." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:model_version a owl:DatatypeProperty ;
    rdfs:label "model_version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier of the trained model artefact." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable label for the entity." ;
    skos:exactMatch dcterms:title,
        schema1:name ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:neural_network_architecture a owl:ObjectProperty ;
    rdfs:label "neural_network_architecture" ;
    skos:definition "Neural-network architecture, when algorithm_family is neural_network (Clauses 3.4, 5.12.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:nlp_component_type a owl:ObjectProperty ;
    rdfs:label "nlp_component_type" ;
    rdfs:range iso22989:NLPComponentType ;
    skos:definition "Type of NLP pipeline component (Clause 9.2.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:node_count a owl:DatatypeProperty ;
    rdfs:label "node_count" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Approximate number of nodes in a graph-structured artefact." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:number_of_layers a owl:DatatypeProperty ;
    rdfs:label "number_of_layers" ;
    skos:definition "Number of layers in the network." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:number_of_parameters a owl:DatatypeProperty ;
    rdfs:label "number_of_parameters" ;
    skos:definition "Approximate number of trainable parameters." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:oecd_stage a owl:ObjectProperty ;
    rdfs:label "oecd_stage" ;
    skos:definition "Corresponding OECD life-cycle stage." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:organization_name a owl:DatatypeProperty ;
    rdfs:label "organization_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the organisation acting in the stakeholder role." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:output_dataset a owl:ObjectProperty ;
    rdfs:label "output_dataset" ;
    skos:definition "Dataset produced by the process." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:output_label_type a owl:ObjectProperty ;
    rdfs:label "output_label_type" ;
    rdfs:range iso22989:DataLabelType ;
    skos:definition "Type of output label produced by a task, when applicable." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:over_model a owl:ObjectProperty ;
    rdfs:label "over_model" ;
    skos:definition "Model over which the inference was performed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:padding a owl:DatatypeProperty ;
    rdfs:label "padding" ;
    skos:definition "Padding mode (e.g. valid, same)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:parameter_count a owl:DatatypeProperty ;
    rdfs:label "parameter_count" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Approximate count of trainable model parameters." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:performed_by a owl:ObjectProperty ;
    rdfs:label "performed_by" ;
    skos:definition "Engine that performed the inference." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:potential_event a owl:DatatypeProperty ;
    rdfs:label "potential_event" ;
    skos:definition "Potential event whose occurrence would realise the risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:predicted_value a owl:DatatypeProperty ;
    rdfs:label "predicted_value" ;
    rdfs:range xsd:string ;
    skos:definition "Serialised representation of a predicted value (Clause 7.4.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:preferred_label a owl:DatatypeProperty ;
    rdfs:label "preferred_label" ;
    rdfs:range xsd:string ;
    skos:definition "Preferred natural-language label." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:process_stage a owl:ObjectProperty ;
    rdfs:label "process_stage" ;
    rdfs:range iso22989:AILifecycleStage ;
    skos:definition "Life-cycle stage the process belongs to." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:process_sub_type a owl:DatatypeProperty ;
    rdfs:label "process_sub_type" ;
    skos:definition "Free-text refinement of the process within its life-cycle stage (e.g. \"objectives\", \"requirements\")." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:process_type a owl:ObjectProperty ;
    rdfs:label "process_type" ;
    skos:definition "Type of data-handling process performed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:produced_by a owl:ObjectProperty ;
    rdfs:label "produced_by" ;
    skos:definition "Model that produced the prediction." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:produced_output a owl:DatatypeProperty ;
    rdfs:label "produced_output" ;
    skos:definition "Serialised representation of the inference output." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:provenance_statement a owl:DatatypeProperty ;
    rdfs:label "provenance_statement" ;
    rdfs:range xsd:string ;
    skos:definition "Provenance description for an artefact." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:recommendation_outcome_type a owl:ObjectProperty ;
    rdfs:label "recommendation_outcome_type" ;
    rdfs:range iso22989:RecommendationOutcomeType ;
    skos:definition "High-level outcome type of a recommendation (Clauses 7.4, 10)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:record_count a owl:DatatypeProperty ;
    rdfs:label "record_count" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Number of records or examples in the dataset." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:reference_dataset a owl:ObjectProperty ;
    rdfs:label "reference_dataset" ;
    skos:definition "Dataset against which the metric was computed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:representation_form a owl:DatatypeProperty ;
    rdfs:label "representation_form" ;
    skos:definition "Concrete form of representation (rules, frames, ontology, graph, vectors)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:resource_type a owl:ObjectProperty ;
    rdfs:label "resource_type" ;
    rdfs:range iso22989:ComputingResourceType ;
    skos:definition "Category of computing resource (Clause 8.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:responsible_role a owl:ObjectProperty ;
    rdfs:label "responsible_role" ;
    rdfs:range iso22989:AIStakeholderRoleType ;
    skos:definition "Stakeholder role responsible for executing the process." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:risk_source a owl:DatatypeProperty ;
    rdfs:label "risk_source" ;
    skos:definition "Source from which the risk originates." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:rule_count a owl:DatatypeProperty ;
    rdfs:label "rule_count" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Approximate count of rules in a rule-based knowledge base." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:sample_label a owl:DatatypeProperty ;
    rdfs:label "sample_label" ;
    skos:definition "Label or target value associated with the sample." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:sample_payload a owl:DatatypeProperty ;
    rdfs:label "sample_payload" ;
    skos:definition "Serialised representation of the sample contents." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:script a owl:DatatypeProperty ;
    rdfs:label "script" ;
    skos:definition "ISO 15924 script code, when relevant." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:semantic_model a owl:DatatypeProperty ;
    rdfs:label "semantic_model" ;
    skos:definition "Reference to the semantic model or ontology used." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:severity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    skos:definition "Qualitative severity assessment of the consequence." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:start_date a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the process started." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:stride a owl:DatatypeProperty ;
    rdfs:label "stride" ;
    skos:definition "Stride applied when sliding the kernel over the input." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:supports_continuous_learning a owl:DatatypeProperty ;
    rdfs:label "supports_continuous_learning" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a model supports continuous or online learning (Clause 3.1.9, 5.11.9.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:task_allocation a owl:DatatypeProperty ;
    rdfs:label "task_allocation" ;
    skos:definition "Free-text description of how tasks are allocated between humans and AI." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:task_category a owl:ObjectProperty ;
    rdfs:label "task_category" ;
    rdfs:range iso22989:TaskCategory ;
    skos:definition "Category of AI task being addressed." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:test_dataset a owl:ObjectProperty ;
    rdfs:label "test_dataset" ;
    rdfs:range iso22989:Dataset ;
    skos:definition "Dataset used to estimate generalisation performance." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:threshold_policy a owl:DatatypeProperty ;
    rdfs:label "threshold_policy" ;
    skos:definition "Policy describing how the threshold is interpreted." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:threshold_value a owl:DatatypeProperty ;
    rdfs:label "threshold_value" ;
    skos:definition "Numeric threshold value." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:trained_on a owl:DatatypeProperty ;
    rdfs:label "trained_on" ;
    rdfs:range xsd:string ;
    skos:definition "Date or version reference for when the model was last trained." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:training_dataset a owl:ObjectProperty ;
    rdfs:label "training_dataset" ;
    rdfs:range iso22989:Dataset ;
    skos:definition "Dataset used to fit the model." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:training_duration a owl:DatatypeProperty ;
    rdfs:label "training_duration" ;
    rdfs:range xsd:duration ;
    skos:definition "Wall-clock duration of model training, expressed as an ISO 8601 duration." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:triggered_by a owl:ObjectProperty ;
    rdfs:label "triggered_by" ;
    skos:definition "Decision that triggered the action." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:trustworthiness_property_type a owl:ObjectProperty ;
    rdfs:label "trustworthiness_property_type" ;
    rdfs:range iso22989:TrustworthinessPropertyType ;
    skos:definition "Which trustworthiness property is being characterised." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:uses_model a owl:ObjectProperty ;
    rdfs:label "uses_model" ;
    skos:definition "Model the inference engine evaluates." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:validation_dataset a owl:ObjectProperty ;
    rdfs:label "validation_dataset" ;
    rdfs:range iso22989:Dataset ;
    skos:definition "Dataset used for hyperparameter tuning and model selection." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:verification_validation_level a owl:ObjectProperty ;
    rdfs:label "verification_validation_level" ;
    rdfs:range iso22989:VerificationValidationLevel ;
    skos:definition "Verifiability / validatability claim (Clause 5.16)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso29100:PersonallyIdentifiableInformation a owl:Class ;
    rdfs:label "PII" ;
    rdfs:subClassOf iso22989:AbbreviationCode ;
    skos:definition "Personally identifiable information." .

iso22989:AIPartner a owl:Class ;
    rdfs:label "AIPartner" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        iso22989:AIStakeholderRole ;
    skos:closeMatch iso29100:ThirdParty,
        <https://w3id.org/lmodel/nist-ai-100-1/AiActorTaskEnum#THIRD_PARTY_ENTITIES>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#THIRD_PARTY_ENTITIES> ;
    skos:definition "Stakeholder providing supporting services across the AI life cycle (Clause 5.19.5)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:AIProducer a owl:Class ;
    rdfs:label "AIProducer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:stakeholder_role_type ],
        iso22989:AIStakeholderRole ;
    skos:closeMatch iso29100:PIIProcessor ;
    skos:definition "Stakeholder designing, developing or assembling AI systems (Clause 5.19.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:DataProcess a owl:Class ;
    rdfs:label "DataProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Dataset ;
            owl:onProperty iso22989:input_dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIStakeholderRole ;
            owl:onProperty iso22989:executed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:parameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:output_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:process_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:executed_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:Dataset ;
            owl:onProperty iso22989:output_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:input_dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:DataProcessType ;
            owl:onProperty iso22989:process_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:executed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:process_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:output_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:input_dataset ],
        iso22989:NamedEntity ;
    skos:broadMatch gist_linkml:Event ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-100-1/AiSystemDimensionEnum#DATA_AND_INPUT> ;
    skos:definition "Discrete data-handling process applied to a dataset during AI system development or operation (Clause 5.10)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    skos:relatedMatch iso29100:PIIProcessingActivity .

iso22989:IoTSystem a owl:Class ;
    rdfs:label "IoTSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:ai_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:IoTDevice ;
            owl:onProperty iso22989:devices ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIComponent ;
            owl:onProperty iso22989:ai_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:devices ],
        iso22989:NamedEntity ;
    skos:definition "Networked system composed of IoT devices, possibly enhanced with AI capabilities (Clause 5.14.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:NeuroSymbolicApproach a owl:Class ;
    rdfs:label "NeuroSymbolicApproach" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#symbolic_in_neural> <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#neural_in_symbolic> <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#tightly_coupled> <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#loosely_coupled> ) ;
    skos:definition "Sub-categorisation of hybrid neuro-symbolic approaches mentioned in\\n      Clause 5.9." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#loosely_coupled>,
        <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#neural_in_symbolic>,
        <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#symbolic_in_neural>,
        <https://w3id.org/lmodel/iso22989/NeuroSymbolicApproach#tightly_coupled> .

iso22989:ai_stakeholder_roles a owl:ObjectProperty ;
    rdfs:label "ai_stakeholder_roles" ;
    rdfs:range iso22989:AIStakeholderRole ;
    skos:definition "Stakeholder role records in the collection." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ai_systems a owl:ObjectProperty ;
    rdfs:label "ai_systems" ;
    rdfs:range iso22989:AISystem ;
    skos:definition "AI systems documented in the collection." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:application_domain a owl:ObjectProperty ;
    rdfs:label "application_domain" ;
    rdfs:range iso22989:AIApplicationDomain ;
    skos:definition "Application domain(s) the AI system targets." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:based_on_predictions a owl:ObjectProperty .

iso22989:data_processes a owl:ObjectProperty .

iso22989:jurisdictional_issues a owl:ObjectProperty ;
    rdfs:label "jurisdictional_issues" ;
    rdfs:range iso22989:JurisdictionalIssueType ;
    skos:definition "Jurisdictional issues considered in scope for the application." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:societal_impacts a owl:ObjectProperty ;
    rdfs:label "societal_impacts" ;
    rdfs:range iso22989:SocietalImpactCategory ;
    skos:definition "Societal impact categories considered in scope." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:TrustworthinessProperty a owl:Class ;
    rdfs:label "TrustworthinessProperty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:property_evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:measurement_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:measurement_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:BiasType ;
            owl:onProperty iso22989:applicable_biases ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:property_evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:confidence_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:TrustworthinessPropertyType ;
            owl:onProperty iso22989:trustworthiness_property_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty iso22989:confidence_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:trustworthiness_property_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:trustworthiness_property_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:confidence_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:applicable_biases ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:measurement_method ],
        iso22989:NamedEntity ;
    skos:closeMatch nist_ai_rmf_common:TrustworthinessCharacteristicEnum ;
    skos:definition "Claim about a trustworthiness property of an AI system or model, with evidence and measurement metadata." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    skos:relatedMatch iso29100:PrivacyFramework,
        nist_ai_100_1:TrustworthinessCharacteristic .

iso22989:mitigation_strategy a owl:DatatypeProperty .

iso22989:AIComponent a owl:Class ;
