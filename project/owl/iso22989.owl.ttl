<https://w3id.org/lmodel/iso22989/AIField#speech_processing> a owl:Class ;
    rdfs:label "speech_processing" ;
    rdfs:subClassOf iso22989:AIField ;
    skos:definition "AI sub-field concerned with processing and producing speech signals." .

<https://w3id.org/lmodel/iso22989/AIFunctionalComponent#action> a owl:Class ;
    rdfs:label "action" ;
    rdfs:subClassOf iso22989:AIFunctionalComponent ;
    skos:definition "Functions enacting decisions on the environment or downstream systems." .

<https://w3id.org/lmodel/iso22989/AIFunctionalComponent#data_and_information> a owl:Class ;
    rdfs:label "data_and_information" ;
    rdfs:subClassOf iso22989:AIFunctionalComponent ;
    skos:definition "Data acquisition, storage and information management functions." .

<https://w3id.org/lmodel/iso22989/AIFunctionalComponent#decision> a owl:Class ;
    rdfs:label "decision" ;
    rdfs:subClassOf iso22989:AIFunctionalComponent ;
    skos:definition "Functions selecting a course of action based on predictions and constraints." .

<https://w3id.org/lmodel/iso22989/AIFunctionalComponent#knowledge_and_learning> a owl:Class ;
    rdfs:label "knowledge_and_learning" ;
    rdfs:subClassOf iso22989:AIFunctionalComponent ;
    skos:definition "Functions producing or maintaining knowledge representations and learned models." .

<https://w3id.org/lmodel/iso22989/AIFunctionalComponent#prediction> a owl:Class ;
    rdfs:label "prediction" ;
    rdfs:subClassOf iso22989:AIFunctionalComponent ;
    skos:definition "Functions producing predictions from inputs using a trained model or knowledge base." .

<https://w3id.org/lmodel/iso22989/AILifecycleStage#continuous_validation> a owl:Class ;
    rdfs:label "continuous_validation" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:definition "Ongoing checks that the system continues to meet validation criteria during operation." .

<https://w3id.org/lmodel/iso22989/AILifecycleStage#design_and_development> a owl:Class ;
    rdfs:label "design_and_development" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEVELOPMENT> ;
    skos:definition "Architecture, model selection, data preparation, training and integration activities." .

<https://w3id.org/lmodel/iso22989/AILifecycleStage#inception> a owl:Class ;
    rdfs:label "inception" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DESIGN> ;
    skos:definition "Identification of need, opportunity and high-level objectives for the AI system." .

<https://w3id.org/lmodel/iso22989/AILifecycleStage#operation_and_monitoring> a owl:Class ;
    rdfs:label "operation_and_monitoring" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:closeMatch <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#OPERATION> ;
    skos:definition "Routine use of the AI system with ongoing observation of behaviour and performance." .

<https://w3id.org/lmodel/iso22989/AILifecycleStage#re_evaluation> a owl:Class ;
    rdfs:label "re_evaluation" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:definition "Periodic or event-triggered reassessment of the system, often leading to retraining or redesign." .

<https://w3id.org/lmodel/iso22989/AILifecycleStage#verification_and_validation> a owl:Class ;
    rdfs:label "verification_and_validation" ;
    rdfs:subClassOf iso22989:AILifecycleStage ;
    skos:definition "Evidence-gathering activities establishing that the system meets specified requirements." .

iso22989:AIProvider a owl:Class ;
    rdfs:label "AIProvider" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:stakeholder_role_type ],
        iso22989:AIStakeholderRole ;
    skos:definition "Stakeholder making an AI system available to customers (Clause 5.19.2)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

<https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_customer> a owl:Class ;
    rdfs:label "ai_customer" ;
    rdfs:subClassOf iso22989:AIStakeholderRoleType ;
    skos:definition "Party that uses an AI system or a service backed by an AI system." .

<https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_partner> a owl:Class ;
    rdfs:label "ai_partner" ;
    rdfs:subClassOf iso22989:AIStakeholderRoleType ;
    skos:definition "Party providing services that support the AI life cycle (data brokers, integrators, evaluators)." .

<https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_producer> a owl:Class ;
    rdfs:label "ai_producer" ;
    rdfs:subClassOf iso22989:AIStakeholderRoleType ;
    skos:definition "Party that designs, develops or assembles AI systems or components." .

<https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_provider> a owl:Class ;
    rdfs:label "ai_provider" ;
    rdfs:subClassOf iso22989:AIStakeholderRoleType ;
    skos:definition "Party that makes an AI system available to AI customers." .

<https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_subject> a owl:Class ;
    rdfs:label "ai_subject" ;
    rdfs:subClassOf iso22989:AIStakeholderRoleType ;
    skos:definition "Person or group whose data is used by, or who is otherwise affected by, the AI system." .

<https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#relevant_authority> a owl:Class ;
    rdfs:label "relevant_authority" ;
    rdfs:subClassOf iso22989:AIStakeholderRoleType ;
    skos:definition "Body with regulatory, supervisory or standards-setting responsibility for AI." .

<https://w3id.org/lmodel/iso22989/AISystemCharacteristic#adaptive> a owl:Class ;
    rdfs:label "adaptive" ;
    rdfs:subClassOf iso22989:AISystemCharacteristic ;
    skos:definition "Adjusts behaviour over time in response to new data or feedback." .

<https://w3id.org/lmodel/iso22989/AISystemCharacteristic#contextual> a owl:Class ;
    rdfs:label "contextual" ;
    rdfs:subClassOf iso22989:AISystemCharacteristic ;
    skos:definition "Adapts behaviour to its operational context." .

<https://w3id.org/lmodel/iso22989/AISystemCharacteristic#data_dependent> a owl:Class ;
    rdfs:label "data_dependent" ;
    rdfs:subClassOf iso22989:AISystemCharacteristic ;
    skos:definition "Performance depends materially on the data used to build or operate the system." .

<https://w3id.org/lmodel/iso22989/AISystemCharacteristic#interactive> a owl:Class ;
    rdfs:label "interactive" ;
    rdfs:subClassOf iso22989:AISystemCharacteristic ;
    skos:definition "Engages in interaction with users or other systems." .

<https://w3id.org/lmodel/iso22989/AISystemCharacteristic#oversight_enabled> a owl:Class ;
    rdfs:label "oversight_enabled" ;
    rdfs:subClassOf iso22989:AISystemCharacteristic ;
    skos:definition "Provides mechanisms for human oversight and intervention." .

<https://w3id.org/lmodel/iso22989/AISystemType#general_ai> a owl:Class ;
    rdfs:label "general_ai" ;
    rdfs:subClassOf iso22989:AISystemType ;
    skos:definition "Hypothetical AI system able to perform any cognitive task a human can perform." .

<https://w3id.org/lmodel/iso22989/AISystemType#narrow_ai> a owl:Class ;
    rdfs:label "narrow_ai" ;
