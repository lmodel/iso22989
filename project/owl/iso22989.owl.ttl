iso22989:AbbreviationEntry a owl:Class ;
    rdfs:label "AbbreviationEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:abbreviation_code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:expansion ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AbbreviationCode ;
            owl:onProperty iso22989:abbreviation_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:expansion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:abbreviation_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:expansion ],
        iso22989:NamedEntity ;
    skos:definition "Record of a single abbreviation listed in Clause 4 of the standard." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

