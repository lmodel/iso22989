iso22989:clause_reference a owl:DatatypeProperty ;
    rdfs:label "clause_reference" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ) ] ) ] ;
    skos:definition "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:symbolic_approach a owl:ObjectProperty ;
    rdfs:label "symbolic_approach" ;
    rdfs:range iso22989:SymbolicApproach ;
    skos:definition "Predominant symbolic vs subsymbolic approach used by the system." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

