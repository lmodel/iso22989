            owl:onProperty iso22989:recommendation_outcome_type ],
        iso22989:NamedEntity ;
    skos:definition "Recommendation produced by an AI system (Clauses 7.4, 10)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:ResourcePool a owl:Class ;
    rdfs:label "ResourcePool" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:resource_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:capacity_units ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:resource_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:ComputingResourceType ;
            owl:onProperty iso22989:resource_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:capacity_units ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:capacity_units ],
        iso22989:NamedEntity ;
    skos:definition "Pool of computing resources (CPU/GPU/TPU/ASIC/FPGA) available to AI workloads (Clause 8.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:RiskItem a owl:Class ;
    rdfs:label "RiskItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:likelihood ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:risk_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:consequence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:risk_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:consequence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:consequence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty iso22989:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:mitigation_strategy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:potential_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:affected_stakeholders ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AIStakeholderRole ;
            owl:onProperty iso22989:affected_stakeholders ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:potential_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:mitigation_strategy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:potential_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:risk_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:severity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:likelihood ],
        iso22989:NamedEntity ;
    skos:closeMatch iso27001:Risk,
        iso29100:PrivacyRisk,
        nist_ai_600_1:GaiRisk ;
    skos:definition "Risk associated with an AI system, capturing source, potential event, consequence and treatment metadata (Clause 3.5.11; aligned with ISO/IEC 23894 risk concepts)." ;
    skos:exactMatch nist_ai_100_1:Risk ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:Robot a owl:Class ;
    rdfs:label "Robot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:controlled_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:AISystem ;
            owl:onProperty iso22989:controlled_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:embodiment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:controlled_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:embodiment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:embodiment ],
        iso22989:NamedEntity ;
    skos:definition "Embodied agent able to perceive its environment and act in the physical world (Clause 5.3 / Clause 9.5 robotics field)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:SemanticComputingSystem a owl:Class ;
    rdfs:label "SemanticComputingSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:semantic_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:semantic_model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:semantic_model ],
        iso22989:AIConcept ;
    skos:definition "System whose behaviour is driven by the explicit semantics of its inputs and knowledge sources (Clause 5.6)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:SoftComputingSystem a owl:Class ;
    rdfs:label "SoftComputingSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:soft_computing_techniques ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:SoftComputingTechnique ;
            owl:onProperty iso22989:soft_computing_techniques ],
        iso22989:AIConcept ;
    skos:definition "System employing soft computing techniques tolerant of imprecision and uncertainty (Clause 5.7)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:Threshold a owl:Class ;
    rdfs:label "Threshold" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty iso22989:threshold_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:applies_to_metric ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty iso22989:threshold_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:threshold_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:applies_to_metric ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:threshold_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:threshold_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:applies_to_metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:threshold_policy ],
        iso22989:NamedEntity ;
    skos:definition "Decision threshold applied to a metric, prediction or score (Clause 7.4.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

iso22989:TrustworthinessTerm a owl:Class ;
    rdfs:label "TrustworthinessTerm" ;
    rdfs:subClassOf iso22989:Term ;
    skos:definition "Term defined in Clause 3.5 (terms related to trustworthiness)." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> ;
    iso22989:clause_section "3.5" .

iso22989:VerificationValidationFramework a owl:Class ;
    rdfs:label "VerificationValidationFramework" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:validation_methods ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:verification_methods ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso22989:VerificationValidationLevel ;
            owl:onProperty iso22989:verification_validation_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ) ] ) ] ;
            owl:onProperty iso22989:clause_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:validation_methods ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso22989:verification_methods ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso22989:verification_validation_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso22989:verification_validation_level ],
        iso22989:NamedEntity ;
    skos:definition "Verifiability and validatability claim for an AI system characterised according to the levels in Clause 5.16." ;
    skos:inScheme <https://w3id.org/lmodel/iso22989> .

xsd:duration a rdfs:Datatype .

