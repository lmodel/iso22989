	iso22989:iso22989_clause "9.1" ;
	iso22989:iso22989_term "3.7.1" .
iso22989:AicField\#data_mining a owl:Class ;
	rdfs:label "data_mining" ;
	rdfs:subClassOf iso22989:AicField ;
