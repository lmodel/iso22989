	iso22989:iso22989_clause "7.4.2" .
iso22989:AicFunctionalStep a owl:Class ;
	rdfs:label "AicFunctionalStep" ;
	owl:unionOf _:c14n394 ;
	skos:definition "A step in how a system gets from data to acting on its results." ;
	skos:inScheme <https://w3id.org/lmodel/iso22989> ;
	linkml:permissible_values iso22989:AicFunctionalStep\#action , iso22989:AicFunctionalStep\#data_and_information , iso22989:AicFunctionalStep\#decision , iso22989:AicFunctionalStep\#knowledge_and_learning , iso22989:AicFunctionalStep\#prediction ;
	iso22989:iso22989_clause "7" .
iso22989:AicIotDevice a owl:Class ;
	rdfs:label "AicIotDevice" ;
	rdfs:subClassOf iso22989:AicRecordMixin , _:c14n150 , _:c14n346 , _:c14n397 , _:c14n402 , _:c14n50 ;
	skos:broadMatch uco-observable:Device ;
	skos:definition "A connected device that reads from or acts on its physical surroundings." ;
