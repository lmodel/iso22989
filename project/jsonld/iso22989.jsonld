    {
      "name": "AicSystem",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicSystem",
      "annotations": [
        {
          "tag": "iso22989_term",
          "value": "3.1.4",
          "@type": "Annotation"
        },
        {
          "tag": "iso22989_clause",
          "value": "8.2",
          "@type": "Annotation"
        }
      ],
      "description": "A system built to produce results for goals set by people, using AI techniques, whatever else it is made of.",
      "comments": [
        "gist's System is any composite whose parts work as a whole, so it is the wider term. SPDX's AIPackage describes a system as a distributed package."
      ],
      "in_subset": [
        "aic_systems"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "related_mappings": [
        "spdx_ai:AIPackage"
      ],
      "broad_mappings": [
        "gist_ontology:System"
      ],
      "mixins": [
        "AicRecordMixin"
      ],
