      "name": "ConfidenceScore",
      "definition_uri": "https://w3id.org/lmodel/iso22989/ConfidenceScore",
      "description": "Numeric confidence score expressed as a value in the closed interval [0.0, 1.0]. Used for model prediction confidence, trust scores and similar normalised quality indicators.",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "typeof": "float",
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "minimum_value": 0.0,
      "maximum_value": 1.0,
      "@type": "TypeDefinition"
    },
