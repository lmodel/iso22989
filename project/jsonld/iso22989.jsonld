      "owner": "AicRecordMixin",
      "domain_of": [
        "AicRecordMixin"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "title",
      "range": "string",
      "required": true,
      "pattern": "^\\s*\\S",
      "@type": "SlotDefinition"
    }
