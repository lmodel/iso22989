{
  "name": "iso22989",
  "annotations": [
    {
      "tag": "standard",
      "value": "ISO/IEC 22989:2022"
    },
    {
      "tag": "edition",
      "value": "1"
    },
    {
      "tag": "publication_date",
      "value": "2022-07-19"
    },
    {
      "tag": "iso_open_data_date",
      "value": "2026-11-05"
    }
  ],
  "description": "A LinkML vocabulary for describing an AI system in the terms of ISO/IEC 22989:2022: the system and its kinds, its models, data and tasks, its place in the life cycle, the parties around it, the trustworthiness claims made for it, and the fields and applications it belongs to.",
  "title": "ISO/IEC 22989:2022 AI concepts and terminology",
  "comments": [
    "The version is the edition the schema models, and source is ISO's page for that edition. ISO Open Data's records of it and of the two amendments in progress are copied to src/iso22989/schema/iso-open-data/ as of the date in the annotations, and scripts/check_upstream_release.py reports when ISO publishes one of them or another edition. The release tags are the schema's own versions.",
    "ISO/IEC 22989 is copyright ISO and IEC, and none of its text is reproduced here. Each element cites what it renders by number, in the iso22989_term annotation for a term of Clause 3 and the iso22989_clause annotation for a clause, and its description is this project's own words. A reader with a licensed copy looks the standard's wording up there by those numbers.",
    "tests/iso22989_numbers.yaml lists every term number and says which element renders it, or why none does.",
    "Every record that other records refer to has an aic_id, and a reference holds that identifier. AicEcosystem holds each kind of record in a list of its own."
  ],
  "source": "https://www.iso.org/standard/74296.html",
  "see_also": [
    "https://lmodel.github.io/iso22989",
    "https://www.iso.org/standard/74296.html"
  ],
  "id": "https://w3id.org/lmodel/iso22989",
  "version": "2022",
  "imports": [
    "linkml:types"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    {
      "prefix_prefix": "iso22989",
      "prefix_reference": "https://w3id.org/lmodel/iso22989/"
    },
    {
      "prefix_prefix": "schema",
      "prefix_reference": "http://schema.org/"
    },
    {
      "prefix_prefix": "gist_ontology",
      "prefix_reference": "https://w3id.org/semanticarts/ns/ontology/gist/"
    },
    {
      "prefix_prefix": "spdx_ai",
      "prefix_reference": "https://spdx.org/rdf/3.0.1/terms/AI/"
    },
    {
      "prefix_prefix": "spdx_dataset",
      "prefix_reference": "https://spdx.org/rdf/3.0.1/terms/Dataset/"
    },
    {
      "prefix_prefix": "uco-observable",
      "prefix_reference": "https://ontology.unifiedcyberontology.org/uco/observable/"
    },
    {
      "prefix_prefix": "uco-role",
      "prefix_reference": "https://ontology.unifiedcyberontology.org/uco/role/"
    }
  ],
  "default_prefix": "iso22989",
  "default_range": "string",
  "subsets": [
    {
      "name": "aic_systems",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicSystems",
      "description": "AI systems, their kinds and their parts (clauses 5.1 to 5.9, 5.13 and 8.2).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_data",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicData",
      "description": "Datasets and the work done on them (clauses 5.10 and 8.6).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_machine_learning",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicMachineLearning",
      "description": "Models and how they learn (clauses 5.11, 5.12 and 8.4).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_iot",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicIot",
      "description": "Connected devices and physical systems (clause 5.14).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_trustworthiness",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicTrustworthiness",
      "description": "Claims about an AI system and checks on it (clauses 5.15 and 5.16).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_stakeholders",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicStakeholders",
      "description": "The parties around an AI system (clause 5.19).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_lifecycle",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicLifecycle",
      "description": "The stages of an AI system's life and the work in each (clause 6).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_functional_view",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicFunctionalView",
      "description": "How a system moves from data to acting on its results (clause 7).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_ecosystem",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicEcosystem",
      "description": "What surrounds AI systems, such as computing resources (clause 8).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    },
    {
      "name": "aic_fields_and_applications",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicFieldsAndApplications",
      "description": "The fields of AI and where systems are applied (clauses 9 and 10).",
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "@type": "SubsetDefinition"
    }
  ],
  "types": [
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "boolean",
      "definition_uri": "https://w3id.org/linkml/Boolean",
      "description": "A binary (true or false) value",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "http://www.w3.org/2001/XMLSchema#boolean",
      "repr": "bool",
      "@type": "TypeDefinition"
    },
    {
      "name": "float",
      "definition_uri": "https://w3id.org/linkml/Float",
      "description": "A real number that conforms to the xsd:float specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "double",
      "definition_uri": "https://w3id.org/linkml/Double",
      "description": "A real number that conforms to the xsd:double specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#double",
      "@type": "TypeDefinition"
    },
    {
      "name": "decimal",
      "definition_uri": "https://w3id.org/linkml/Decimal",
      "description": "A real number with arbitrary precision that conforms to the xsd:decimal specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "broad_mappings": [
        "schema:Number"
      ],
      "base": "Decimal",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "time",
      "definition_uri": "https://w3id.org/linkml/Time",
      "description": "A time object represents a (local) time of day, independent of any particular day",
      "notes": [
        "URI is dateTime because OWL reasoners do not work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Time"
      ],
      "base": "XSDTime",
      "uri": "http://www.w3.org/2001/XMLSchema#time",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date",
      "definition_uri": "https://w3id.org/linkml/Date",
      "description": "a date (year, month and day) in an idealized calendar",
      "notes": [
        "URI is dateTime because OWL reasoners don't work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Date"
      ],
      "base": "XSDDate",
      "uri": "http://www.w3.org/2001/XMLSchema#date",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "datetime",
      "definition_uri": "https://w3id.org/linkml/Datetime",
      "description": "The combination of a date and time",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:DateTime"
      ],
      "base": "XSDDateTime",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date_or_datetime",
      "definition_uri": "https://w3id.org/linkml/DateOrDatetime",
      "description": "Either a date or a datetime",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "AicSystemScope",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicSystemScope",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.2"
        }
      ],
      "description": "How wide a range of problems a system can take on.",
      "in_subset": [
        "aic_systems"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "narrow_ai",
          "description": "Built for a bounded set of problems, and cannot move beyond them.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.24"
            }
          ]
        },
        {
          "text": "general_ai",
          "description": "Able to take on problems of many kinds, including ones it was not built for.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.14"
            }
          ]
        }
      ]
    },
    {
      "name": "AicApproach",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicApproach",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.9"
        }
      ],
      "description": "Whether a system works on explicit symbols or on learned numeric encodings.",
      "in_subset": [
        "aic_systems"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "symbolic",
          "description": "Works by manipulating explicit symbols and the rules that relate them.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.33"
            }
          ]
        },
        {
          "text": "subsymbolic",
          "description": "Works on numeric encodings that carry meaning only as a whole, such as the weights of a network.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.34"
            }
          ]
        }
      ]
    },
    {
      "name": "AicTechnique",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicTechnique",
      "description": "A family of techniques a system is built with.",
      "in_subset": [
        "aic_systems"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "machine_learning",
          "description": "Fits a model's numbers to data rather than having a person write the logic.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.5"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11"
            }
          ]
        },
        {
          "text": "deep_learning",
          "description": "Machine learning that stacks many layers of a network.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.4.4"
            }
          ]
        },
        {
          "text": "cognitive_computing",
          "description": "Aims at interaction with people that feels closer to how people deal with one another.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.8"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.5"
            }
          ]
        },
        {
          "text": "semantic_computing",
          "description": "Works out what content and requests mean, so that it can act on the meaning.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.31"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.6"
            }
          ]
        },
        {
          "text": "soft_computing",
          "description": "Accepts inexact or uncertain reasoning where an exact answer would cost too much.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.32"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.7"
            }
          ]
        },
        {
          "text": "genetic_algorithm",
          "description": "Searches by breeding and selecting candidate answers over many generations.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.15"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.8"
            }
          ]
        },
        {
          "text": "logic_programming",
          "description": "States facts and rules in logic, and lets a solver reach the conclusions.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "8.5.3"
            }
          ]
        }
      ]
    },
    {
      "name": "AicAutonomy",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicAutonomy",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.13"
        }
      ],
      "description": "Whether a system can change its own remit or stays under outside direction.",
      "in_subset": [
        "aic_systems"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "autonomous",
          "description": "Can change what it is for or where it applies with nobody directing it.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.5"
            }
          ]
        },
        {
          "text": "heteronomous",
          "description": "Stays under the direction of a person or another system.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.16"
            }
          ]
        }
      ]
    },
    {
      "name": "AicKnowledgeKind",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicKnowledgeKind",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.4"
        }
      ],
      "description": "How a body of knowledge is put.",
      "in_subset": [
        "aic_systems"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "declarative",
          "description": "States what is the case.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.12"
            }
          ]
        },
        {
          "text": "procedural",
          "description": "States what to do, step by step.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.1.28"
            }
          ]
        }
      ]
    },
    {
      "name": "AicFunctionalStep",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicFunctionalStep",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "7"
        }
      ],
      "description": "A step in how a system gets from data to acting on its results.",
      "in_subset": [
        "aic_functional_view"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "data_and_information",
          "description": "Taking in data and giving it meaning.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "7.2"
            }
          ]
        },
        {
          "text": "knowledge_and_learning",
          "description": "Building up what the system knows, and learning from more data.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "7.3"
            }
          ]
        },
        {
          "text": "prediction",
          "description": "Working out a likely result for the case in hand.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "7.4.2"
            }
          ]
        },
        {
          "text": "decision",
          "description": "Choosing what to do, given the results so far.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "7.4.3"
            }
          ]
        },
        {
          "text": "action",
          "description": "Carrying out what was chosen.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "7.4.4"
            }
          ]
        }
      ]
    },
    {
      "name": "AicLearningParadigm",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicLearningParadigm",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.11"
        }
      ],
      "description": "How a model learns from its data.",
      "in_subset": [
        "aic_machine_learning"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "supervised",
          "description": "Every example comes with the answer it should give.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.12"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.1"
            }
          ]
        },
        {
          "text": "unsupervised",
          "description": "No example comes with an answer, so the model looks for structure.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.17"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.2"
            }
          ]
        },
        {
          "text": "semi_supervised",
          "description": "Some examples come with answers and the rest do not.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.11"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.3"
            }
          ]
        },
        {
          "text": "reinforcement",
          "description": "The model acts, gets a reward or penalty, and adjusts to earn more reward.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.9"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.4"
            }
          ]
        },
        {
          "text": "transfer",
          "description": "What was learned on one problem gives a start on another.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.11.5"
            }
          ]
        }
      ]
    },
    {
      "name": "AicAlgorithmFamily",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicAlgorithmFamily",
      "annotations": [
        {
          "tag": "iso22989_term",
          "value": "3.3.6"
        },
        {
          "tag": "iso22989_clause",
          "value": "5.12"
        }
      ],
      "description": "A family of algorithms that fit machine learning models.",
      "in_subset": [
        "aic_machine_learning"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "neural_network",
          "description": "Layers of simple units whose connection weights are tuned to the data.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.12.1"
            }
          ]
        },
        {
          "text": "bayesian_network",
          "description": "A graph of variables and how the probability of one depends on others.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.1"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.12.2"
            }
          ]
        },
        {
          "text": "decision_tree",
          "description": "A series of branching tests that end in a result.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.2"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.12.3"
            }
          ]
        },
        {
          "text": "support_vector_machine",
          "description": "Finds the widest gap that separates the classes of example.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.13"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.12.4"
            }
          ]
        }
      ]
    },
    {
      "name": "AicNetworkArchitecture",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicNetworkArchitecture",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.12.1"
        }
      ],
      "description": "How the layers of a neural network are connected.",
      "in_subset": [
        "aic_machine_learning"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "feed_forward",
          "description": "Signals pass one way, from first layer to last, with no loops.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.4.6"
            }
          ]
        },
        {
          "text": "recurrent",
          "description": "Outputs feed back as inputs, so the network can follow a sequence.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.4.10"
            }
          ]
        },
        {
          "text": "long_short_term_memory",
          "description": "A recurrent design whose gates let it carry a signal across long sequences.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.4.7"
            }
          ]
        },
        {
          "text": "convolutional",
          "description": "Layers slide small filters across the input, as is usual for images.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.4.2"
            }
          ]
        }
      ]
    },
    {
      "name": "AicDatasetRole",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicDatasetRole",
      "description": "What a dataset is used for.",
      "in_subset": [
        "aic_data"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "training",
          "description": "Used to fit a model.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.3.16"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.6"
            }
          ]
        },
        {
          "text": "validation",
          "description": "Used while developing a model, to compare versions and tune settings.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.15"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.8"
            }
          ]
        },
        {
          "text": "test",
          "description": "Held back from development, to judge the finished model.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.14"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.11.8"
            }
          ]
        },
        {
          "text": "production",
          "description": "Gathered while the system runs, when it is deployed and in real use.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.12"
            }
          ]
        },
        {
          "text": "input",
          "description": "What a system is given so that it can work out a result.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.9"
            }
          ]
        }
      ]
    },
    {
      "name": "AicDataProcessKind",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicDataProcessKind",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.10"
        }
      ],
      "description": "A kind of work done on data before or while a model uses it.",
      "in_subset": [
        "aic_data"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "data_annotation",
          "description": "Adds descriptive notes to data and leaves the data itself as it was.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.1"
            }
          ]
        },
        {
          "text": "data_quality_checking",
          "description": "Looks for gaps, skew and whatever else would limit the data's use.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.2"
            }
          ]
        },
        {
          "text": "data_augmentation",
          "description": "Makes new samples out of existing ones by altering them.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.3"
            }
          ]
        },
        {
          "text": "data_sampling",
          "description": "Picks a smaller part of the data that behaves like the whole.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.4"
            }
          ]
        },
        {
          "text": "exploratory_data_analysis",
          "description": "A first look at data to learn its shape and what it may hold.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.6"
            }
          ]
        },
        {
          "text": "imputation",
          "description": "Fills gaps with values worked out from what is there.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.2.8"
            }
          ]
        }
      ]
    },
    {
      "name": "AicTrustworthinessProperty",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicTrustworthinessProperty",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.15"
        }
      ],
      "description": "A property a trustworthiness claim is about.",
      "in_subset": [
        "aic_trustworthiness"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "robustness",
          "description": "Keeps performing well when conditions turn hostile or unusual.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.12"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.2"
            }
          ]
        },
        {
          "text": "reliability",
          "description": "Behaves and delivers as intended, time after time.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.9"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.3"
            }
          ]
        },
        {
          "text": "resilience",
          "description": "Gets back to working order soon after something goes wrong.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.10"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.4"
            }
          ]
        },
        {
          "text": "controllability",
          "description": "A person or another system can step in and steer it.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.5, 3.5.6"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.5"
            }
          ]
        },
        {
          "text": "explainability",
          "description": "Can say, in terms people follow, what drove a result.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.7"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.6"
            }
          ]
        },
        {
          "text": "predictability",
          "description": "Lets people form sound expectations of what it will produce.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.8"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.7"
            }
          ]
        },
        {
          "text": "organizational_transparency",
          "description": "The organization tells those concerned what it does and decides.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.14"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.8"
            }
          ]
        },
        {
          "text": "system_transparency",
          "description": "Those concerned can learn what they need to know about the system.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.15"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.8"
            }
          ]
        },
        {
          "text": "bias_and_fairness",
          "description": "Whether the system treats some people or things worse than others, as a pattern.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.4"
            },
            {
              "tag": "iso22989_clause",
              "value": "5.15.9"
            }
          ]
        },
        {
          "text": "accountability",
          "description": "Someone answers for what the system does and decides.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.1, 3.5.2"
            }
          ]
        },
        {
          "text": "availability",
          "description": "Those entitled to use it can reach it and use it when they ask.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.3"
            }
          ]
        }
      ]
    },
    {
      "name": "AicAssessmentKind",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicAssessmentKind",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.16"
        }
      ],
      "description": "Which question an assessment answers.",
      "in_subset": [
        "aic_trustworthiness"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "verification",
          "description": "Evidence shows that the system meets what was specified for it.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.17"
            }
          ]
        },
        {
          "text": "validation",
          "description": "Evidence shows that the system suits the use it is meant for.",
          "annotations": [
            {
              "tag": "iso22989_term",
              "value": "3.5.18"
            }
          ]
        }
      ]
    },
    {
      "name": "AicStakeholderRole",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicStakeholderRole",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "5.19"
        }
      ],
      "description": "The part a party plays around an AI system.",
      "in_subset": [
        "aic_stakeholders"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "ai_provider",
          "description": "Offers AI products or services, or the platform for them.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.19.2"
            }
          ]
        },
        {
          "text": "ai_producer",
          "description": "Designs, builds, tests or runs AI systems.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.19.3"
            }
          ]
        },
        {
          "text": "ai_customer",
          "description": "Takes an AI product or service for its own use.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.19.4"
            }
          ]
        },
        {
          "text": "ai_partner",
          "description": "Helps others in the ecosystem, by integrating systems or supplying data.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.19.5"
            }
          ]
        },
        {
          "text": "ai_subject",
          "description": "Is affected by an AI system, or has data about them used in it.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.19.6"
            }
          ]
        },
        {
          "text": "relevant_authority",
          "description": "Sets policy for AI or holds others to the rules on it.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "5.19.7"
            }
          ]
        }
      ]
    },
    {
      "name": "AicStakeholderSubRole",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicStakeholderSubRole",
      "description": "A narrower part within one of the roles.",
      "comments": [
        "These are the narrower parts ISO/IEC 42001:2023 lists under each role in clause 4.1, which refers to clause 5.19 of this standard. The role annotation names the role each sits under."
      ],
      "in_subset": [
        "aic_stakeholders"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "ai_platform_provider",
          "description": "Offers the platform that others run AI on.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_provider"
            }
          ]
        },
        {
          "text": "ai_product_or_service_provider",
          "description": "Offers a finished AI product or a service built on AI.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_provider"
            }
          ]
        },
        {
          "text": "ai_developer",
          "description": "Writes and builds the system.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_producer"
            }
          ]
        },
        {
          "text": "ai_user",
          "description": "Uses the system directly.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_customer"
            }
          ]
        },
        {
          "text": "ai_system_integrator",
          "description": "Fits AI parts into a larger system.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_partner"
            }
          ]
        },
        {
          "text": "data_provider",
          "description": "Supplies data that others build or run on.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_partner"
            }
          ]
        },
        {
          "text": "data_subject",
          "description": "A person the data is about.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_subject"
            }
          ]
        },
        {
          "text": "other_subject",
          "description": "Anyone else a system affects.",
          "annotations": [
            {
              "tag": "role",
              "value": "ai_subject"
            }
          ]
        },
        {
          "text": "policy_maker",
          "description": "Decides policy on AI.",
          "annotations": [
            {
              "tag": "role",
              "value": "relevant_authority"
            }
          ]
        },
        {
          "text": "regulator",
          "description": "Holds others to the rules on AI.",
          "annotations": [
            {
              "tag": "role",
              "value": "relevant_authority"
            }
          ]
        }
      ]
    },
    {
      "name": "AicLifecycleStage",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicLifecycleStage",
      "annotations": [
        {
          "tag": "iso22989_term",
          "value": "3.1.22"
        },
        {
          "tag": "iso22989_clause",
          "value": "6.2"
        }
      ],
      "description": "A stage in an AI system's life.",
      "comments": [
        "The related_mappings to AicOecdLifecycleStage are this project's reading of Annex A, and have not been checked against its text."
      ],
      "in_subset": [
        "aic_lifecycle"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "inception",
          "description": "Deciding that a system is wanted, what it is for and whether it can be done.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.2"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#plan_and_design"
          ]
        },
        {
          "text": "design_and_development",
          "description": "Making the system, from its architecture through its data work to its models.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.3"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#collect_and_process_data",
            "iso22989:AicOecdLifecycleStage#build_and_use_model"
          ]
        },
        {
          "text": "verification_and_validation",
          "description": "Checking what was made against its specification and against its purpose.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.4"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#verify_and_validate"
          ]
        },
        {
          "text": "deployment",
          "description": "Installing the system where it is to run, and making it ready for use.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.5"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#deploy"
          ]
        },
        {
          "text": "operation_and_monitoring",
          "description": "Running the system and keeping an eye on how it behaves.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.6"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#operate_and_monitor"
          ]
        },
        {
          "text": "continuous_validation",
          "description": "Repeating the checks on a system that goes on learning as it runs.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.7"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#operate_and_monitor"
          ]
        },
        {
          "text": "re_evaluation",
          "description": "Looking again at whether the running system still meets its aims.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.8"
            }
          ],
          "related_mappings": [
            "iso22989:AicOecdLifecycleStage#operate_and_monitor"
          ]
        },
        {
          "text": "retirement",
          "description": "Taking the system out of use.",
          "annotations": [
            {
              "tag": "iso22989_clause",
              "value": "6.2.9"
            }
          ]
        }
      ]
    },
    {
      "name": "AicOecdLifecycleStage",
      "definition_uri": "https://w3id.org/lmodel/iso22989/AicOecdLifecycleStage",
      "annotations": [
        {
          "tag": "iso22989_clause",
          "value": "Annex A"
        }
      ],
      "description": "A stage of the OECD's account of an AI system's life, which Annex A sets beside the standard's.",
      "in_subset": [
        "aic_lifecycle"
      ],
      "from_schema": "https://w3id.org/lmodel/iso22989",
      "permissible_values": [
        {
          "text": "plan_and_design",
          "description": "Setting out what the system is for and how it will work."
        },
        {
          "text": "collect_and_process_data",
          "description": "Gathering and readying the data."
        },
        {
          "text": "build_and_use_model",
          "description": "Making the model and trying it."
        },
        {
          "text": "verify_and_validate",
          "description": "Checking the model."
        },
        {
          "text": "deploy",
          "description": "Putting the system into use."
        },
        {
          "text": "operate_and_monitor",
          "description": "Running the system and watching it."
        }
      ]
    },
    {
      "name": "AicResourceKind",
