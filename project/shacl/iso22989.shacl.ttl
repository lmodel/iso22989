iso22989:KnowledgeGraph a sh:NodeShape ;
    rdfs:comment "Graph-structured knowledge representation, often used for reasoning and retrieval (Clause 8.5)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Predominant symbolic vs subsymbolic approach used by the system." ;
            sh:in ( "symbolic" "subsymbolic" "hybrid" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path iso22989:symbolic_approach ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path skos:prefLabel ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:integer ;
            sh:description "Approximate number of edges in a graph-structured artefact." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:edge_count ],
        [ sh:description "Type of knowledge captured (Clause 3.1.12, 3.1.28)." ;
            sh:in ( "declarative" "procedural" "tacit" "common_sense" "domain_specific" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path iso22989:knowledge_type ],
        [ sh:datatype xsd:string ;
            sh:description "Concrete form of representation (rules, frames, ontology, graph, vectors)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:representation_form ],
        [ sh:datatype xsd:integer ;
            sh:description "Approximate number of nodes in a graph-structured artefact." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso22989:node_count ],
        [ sh:description "Ontologies referenced by a knowledge artefact." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso22989:ontology_reference ] ;
    sh:targetClass iso22989:KnowledgeGraph .

iso22989:Task a sh:NodeShape ;
    rdfs:comment "AI task addressed by a model or system (e.g. classification, regression, planning). Provides a first-class entity for the task categories enumerated across Clause 3 terminology." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Metrics used to evaluate performance." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:performance_metric ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ],
        [ sh:description "Category of AI task being addressed." ;
            sh:in ( "classification" "regression" "clustering" "ranking" "recommendation" "anomaly_detection" "dimensionality_reduction" "generation" "planning" "control" "decision_support" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:task_category ],
        [ sh:description "Type of output label produced by a task, when applicable." ;
            sh:in ( "categorical" "binary" "ordinal" "numeric" "structured" "sequence" "graph" "none" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path iso22989:output_label_type ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:description "Modalities of input accepted by a task or component." ;
            sh:in ( "structured" "semi_structured" "unstructured" "text" "image" "video" "audio" "sensor" "time_series" "graph" ) ;
            sh:order 1 ;
            sh:path iso22989:input_modalities ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ] ;
    sh:targetClass iso22989:Task .

iso22989:InferenceEngine a sh:NodeShape ;
    rdfs:comment "Component performing inference over a model or knowledge base (Clause 3.1.17)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Inference strategy used (e.g. forward_chaining, backward_chaining, probabilistic)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso22989:inference_strategy ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:altLabel ],
        [ sh:class iso22989:AIModel ;
            sh:description "Model the inference engine evaluates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:uses_model ] ;
    sh:targetClass iso22989:InferenceEngine .

iso22989:Prediction a sh:NodeShape ;
    rdfs:comment "Prediction produced by an AI model (Clause 7.4.2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:float ;
            sh:description "Normalised confidence value associated with an output or claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:confidence ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdfs:seeAlso ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Serialised representation of a predicted value (Clause 7.4.2)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso22989:predicted_value ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:class iso22989:AIModel ;
            sh:description "Model that produced the prediction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso22989:produced_by ] ;
    sh:targetClass iso22989:Prediction .

iso22989:TrustworthinessProperty a sh:NodeShape ;
    rdfs:comment "Claim about a trustworthiness property of an AI system or model, with evidence and measurement metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Normalised confidence in the property claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso22989:confidence_score ],
        [ sh:description "Which trustworthiness property is being characterised." ;
            sh:in ( "robustness" "reliability" "resilience" "controllability" "explainability" "predictability" "transparency" "fairness" "bias_mitigation" "accountability" <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED> <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#SAFE> "availability" "integrity" "authenticity" "security" "usability" "quality" "fault_tolerance" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:trustworthiness_property_type ],
        [ sh:datatype xsd:string ;
            sh:description "How the property was assessed or measured." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "References to evidence supporting the property claim." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:property_evidence ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:description "Bias categories considered relevant to this property assessment." ;
            sh:in ( "data_bias" "algorithmic_bias" "societal_bias" "cognitive_bias" "automation_bias" ) ;
            sh:order 3 ;
            sh:path iso22989:applicable_biases ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:name ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass iso22989:TrustworthinessProperty .

iso22989:DataProcess a sh:NodeShape ;
    rdfs:comment "Discrete data-handling process applied to a dataset during AI system development or operation (Clause 5.10)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iso22989:Dataset ;
            sh:description "Dataset consumed by the process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:input_dataset ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:name ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:description "Type of data-handling process performed." ;
            sh:in ( "data_acquisition" "exploratory_data_analysis" "data_annotation" "data_labeling" "data_preparation" "data_cleaning" "filtering" "normalisation" "de_identification" "data_quality_checking" "data_sampling" "data_augmentation" "feature_engineering" "imputation" "data_drift_detection" "data_poisoning_detection" "concept_drift_handling" "catastrophic_forgetting_mitigation" "retraining" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:process_type ],
        [ sh:class iso22989:Dataset ;
            sh:description "Dataset produced by the process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso22989:output_dataset ],
        [ sh:class iso22989:AIStakeholderRole ;
            sh:description "Stakeholder role that executed the process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path iso22989:executed_by ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form parameters configuring the process." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path skos:prefLabel ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdfs:seeAlso ] ;
    sh:targetClass iso22989:DataProcess .

iso22989:IoTSystem a sh:NodeShape ;
    rdfs:comment "Networked system composed of IoT devices, possibly enhanced with AI capabilities (Clause 5.14.2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:class iso22989:IoTDevice ;
            sh:description "Devices that make up the IoT system." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path iso22989:devices ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:prefLabel ],
        [ sh:class iso22989:AIComponent ;
            sh:description "AI components that operate within the IoT system." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:ai_components ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rdfs:seeAlso ] ;
    sh:targetClass iso22989:IoTSystem .

iso22989:AIComponent a sh:NodeShape ;
    rdfs:comment "Functional component of an AI system, such as a data pipeline, preprocessor, model server, or post-processing module." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Functional view component implemented by an AI component (Clause 7)." ;
            sh:in ( "data_and_information" "knowledge_and_learning" "prediction" "decision" "action" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:component_function ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:prefLabel ],
        [ sh:class iso22989:AIComponent ;
            sh:description "Other components this component depends on at runtime." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:depends_on ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ] ;
    sh:targetClass iso22989:AIComponent .

iso22989:AIModel a sh:NodeShape ;
    rdfs:comment "Trained or rule-based model embedded in an AI system. Carries paradigm, algorithm family, dataset references and version metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( iso22989:number_of_parameters rdf:type iso22989:number_of_layers ) ;
    sh:property [ sh:class iso22989:Dataset ;
            sh:description "Dataset used to fit the model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path iso22989:training_dataset ],
        [ sh:description "Machine-learning paradigm under which the model was trained." ;
            sh:in ( "supervised" "unsupervised" "semi_supervised" "reinforcement" "transfer" "self_supervised" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:model_paradigm ],
        [ sh:description "Algorithm family the model belongs to." ;
            sh:in ( "neural_network" "bayesian_network" "decision_tree" "support_vector_machine" "genetic_algorithm" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso22989:algorithm_family ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:class iso22989:Dataset ;
            sh:description "Dataset used to estimate generalisation performance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path iso22989:test_dataset ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the model has had compression or distillation applied for deployment (Clause 8.6.2)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso22989:model_compression_applied ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:float ;
            sh:description "Estimated risk of catastrophic forgetting on retraining (Clause 5.11.9.1)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso22989:catastrophic_forgetting_risk ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether a model supports continuous or online learning (Clause 3.1.9, 5.11.9.2)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso22989:supports_continuous_learning ],
        [ sh:description "Non-learning engineering approach used (for symbolic/knowledge-based models)." ;
            sh:in ( "expert_system" "logic_programming" "knowledge_graph" "constraint_satisfaction" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path iso22989:engineering_approach ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form record of model hyperparameter settings." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso22989:hyperparameters ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path skos:altLabel ],
        [ sh:class iso22989:Dataset ;
            sh:description "Dataset used for hyperparameter tuning and model selection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path iso22989:validation_dataset ],
        [ sh:datatype xsd:duration ;
            sh:description "Wall-clock duration of model training, expressed as an ISO 8601 duration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso22989:training_duration ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:float ;
            sh:description "Typical end-to-end inference latency in milliseconds." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso22989:inference_latency_ms ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:identifier ],
        [ sh:description "Training-time phenomena observed for the model (Clause 3.4)." ;
            sh:in ( "vanishing_gradient" "exploding_gradient" "catastrophic_forgetting" "overfitting" "underfitting" ) ;
            sh:order 17 ;
            sh:path iso22989:training_phenomena ],
        [ sh:description "Neural-network architecture, when algorithm_family is neural_network (Clauses 3.4, 5.12.1)." ;
            sh:in ( "feed_forward" "recurrent" "long_short_term_memory" "gated_recurrent_unit" "convolutional" "transformer" "autoencoder" "generative_adversarial" "deep" ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path iso22989:neural_network_architecture ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier of the trained model artefact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:model_version ],
        [ sh:description "Predominant activation function used in the network (Clause 3.4.1)." ;
            sh:in ( "sigmoid" "tanh" "relu" "leaky_relu" "softmax" "linear" "other" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path iso22989:activation_function ],
        [ sh:datatype xsd:integer ;
            sh:description "Approximate count of trainable model parameters." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso22989:parameter_count ],
        [ sh:datatype xsd:string ;
            sh:description "Date or version reference for when the model was last trained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso22989:trained_on ] ;
    sh:targetClass iso22989:AIModel .

iso22989:AIStakeholderRole a sh:NodeShape ;
    rdfs:comment "Stakeholder role enacted by an organisation or individual in relation to an AI system (Clause 5.19)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the organisation acting in the stakeholder role." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:organization_name ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:description "Canonical stakeholder role type as defined in Clause 5.19." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:stakeholder_role_type ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Contact identifier (e.g. email) for the stakeholder." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:contact ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text statements of responsibility." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:responsibilities ] ;
    sh:targetClass iso22989:AIStakeholderRole .

iso22989:AISystem a sh:NodeShape ;
    rdfs:comment "Engineered system that uses AI techniques to perform tasks delegated to it. Aggregates lifecycle, functional, model and stakeholder data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:class iso22989:AIComponent ;
            sh:description "Constituent components of the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path iso22989:components ],
        [ sh:class iso22989:IoTSystem ;
            sh:description "IoT/CPS system this AI system is integrated with, if any (Clause 5.14)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path iso22989:iot_integration ],
        [ sh:class iso22989:AIModel ;
            sh:description "Trained or knowledge-based models embedded in the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path iso22989:models ],
        [ sh:description "Current life-cycle stage of the AI system." ;
            sh:in ( "inception" "design_and_development" "verification_and_validation" <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT> "operation_and_monitoring" "continuous_validation" "re_evaluation" <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path iso22989:lifecycle_stage ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path rdfs:seeAlso ],
        [ sh:description "Agent architecture, if the AI system is structured as an agent (Clause 5.3)." ;
            sh:in ( "reflex_agent" "model_based_agent" "goal_based_agent" "utility_based_agent" "learning_agent" "multi_agent" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path iso22989:agent_architecture ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path schema1:name ],
        [ sh:description "Predominant symbolic vs subsymbolic approach used by the system." ;
            sh:in ( "symbolic" "subsymbolic" "hybrid" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso22989:symbolic_approach ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dcterms:description ],
        [ sh:description "Operational autonomy level of the AI system." ;
            sh:in ( "automated" "heteronomous" "autonomous" "level_0_no_automation" "level_1_assistance" "level_2_partial_automation" "level_3_conditional_automation" "level_4_high_automation" "level_5_full_automation" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path iso22989:autonomy_level ],
        [ sh:class iso22989:TrustworthinessProperty ;
            sh:description "Trustworthiness properties claimed for the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso22989:trustworthiness_properties ],
        [ sh:description "Societal impact categories considered in scope." ;
            sh:in ( "employment" "human_rights" "environment" "democratic_processes" "digital_divide" ) ;
            sh:order 14 ;
            sh:path iso22989:societal_impacts ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path skos:altLabel ],
        [ sh:description "Jurisdictional issues considered in scope for the application." ;
            sh:in ( "data_residency" "cross_border_transfer" "liability" "regulatory_compliance" "intellectual_property" ) ;
            sh:order 13 ;
            sh:path iso22989:jurisdictional_issues ],
        [ sh:description "AI sub-field(s) the system draws on." ;
            sh:in ( "computer_vision" "natural_language_processing" "data_mining" "planning" "robotics" "knowledge_representation_and_reasoning" "speech_processing" "multi_agent_systems" ) ;
            sh:order 5 ;
            sh:path iso22989:ai_field ],
        [ sh:description "Functional components exhibited by the system (Clause 7)." ;
            sh:in ( "data_and_information" "knowledge_and_learning" "prediction" "decision" "action" ) ;
            sh:order 6 ;
            sh:path iso22989:functional_components ],
        [ sh:description "Task categories the AI system addresses." ;
            sh:in ( "classification" "regression" "clustering" "ranking" "recommendation" "anomaly_detection" "dimensionality_reduction" "generation" "planning" "control" "decision_support" ) ;
            sh:order 16 ;
            sh:path iso22989:task_categories ],
        [ sh:class iso22989:Dataset ;
            sh:description "Datasets used by, or produced by, the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path iso22989:datasets ],
        [ sh:datatype xsd:string ;
            sh:description "Stated intended purpose of the AI system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:intended_purpose ],
        [ sh:description "Distinguishing characteristics from Clause 5.1." ;
            sh:in ( "interactive" "contextual" "adaptive" "oversight_enabled" "data_dependent" ) ;
            sh:order 15 ;
            sh:path iso22989:system_characteristics ],
        [ sh:description "Application domain(s) the AI system targets." ;
            sh:in ( "fraud_detection" "automated_vehicles" "predictive_maintenance" "recommendation" "medical_diagnosis" "content_generation" "agriculture" "automotive" "banking_and_finance" "defense_and_security" "education" "energy_and_utilities" "healthcare" "legal_services" "manufacturing" "media_and_entertainment" "mixed_reality" "public_sector" "retail" "space" "telecommunications" ) ;
            sh:order 4 ;
            sh:path iso22989:application_domain ],
        [ sh:class iso22989:DataProcess ;
            sh:description "Data-handling processes applied within the AI system (Clause 5.10)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path iso22989:data_processes ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dcterms:identifier ],
        [ sh:description "Capability classification of the AI system." ;
            sh:in ( "narrow_ai" "general_ai" "weak_ai" "strong_ai" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:ai_system_type ],
        [ sh:class iso22989:AIStakeholderRole ;
            sh:description "Stakeholder roles associated with the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path iso22989:stakeholders ] ;
    sh:targetClass iso22989:AISystem .

iso22989:Dataset a sh:NodeShape ;
    rdfs:comment "Collection of data items used by an AI system in a training, validation, test, reference or production role." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rdfs:seeAlso ],
        [ sh:description "Modalities present in the dataset." ;
            sh:in ( "structured" "semi_structured" "unstructured" "text" "image" "video" "audio" "sensor" "time_series" "graph" ) ;
            sh:order 0 ;
            sh:path iso22989:data_modality ],
        [ sh:class iso22989:DataProcess ;
            sh:description "Data-handling processes applied to the dataset (Clause 5.10)." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path iso22989:data_processes_applied ],
        [ sh:datatype xsd:string ;
            sh:description "Notes on data quality, completeness or representativeness." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso22989:data_quality_notes ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Role the dataset plays in the ML workflow." ;
            sh:in ( "training" "validation" "test" "production" "reference" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso22989:dataset_role ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether trusted ground-truth labels are available (Clause 3.2.7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:ground_truth_available ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of features per record." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso22989:feature_count ],
        [ sh:description "Type of target label associated with the dataset (Clause 3.2.10)." ;
            sh:in ( "categorical" "binary" "ordinal" "numeric" "structured" "sequence" "graph" "none" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path iso22989:label_type ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of records or examples in the dataset." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:record_count ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance statement for the dataset (origin, collection method, licensing)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the dataset contains personal or personally identifiable information." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:contains_personal_data ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path skos:altLabel ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass iso22989:Dataset .

