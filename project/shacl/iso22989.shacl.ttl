iso22989:Recommendation a sh:NodeShape ;
    rdfs:comment "Recommendation produced by an AI system (Clauses 7.4, 10)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:float ;
            sh:description "Normalised confidence value associated with an output or claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:confidence ],
        [ sh:class iso22989:Prediction ;
            sh:description "Predictions supporting the recommendation." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path iso22989:based_on_predictions ],
        [ sh:datatype xsd:string ;
            sh:description "Items recommended by the system, serialised as strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:recommended_items ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:description "High-level outcome type of a recommendation (Clauses 7.4, 10)." ;
            sh:in ( "content_recommendation" "action_recommendation" "ranking_recommendation" "next_best_action" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:recommendation_outcome_type ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:altLabel ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ;
    sh:targetClass iso22989:Recommendation .

iso22989:Regulator a sh:NodeShape ;
    rdfs:comment "Authority responsible for regulatory oversight of AI systems (Clause 5.19.7)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
