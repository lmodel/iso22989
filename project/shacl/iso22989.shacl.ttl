            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:description "Classification of a data source (Clause 8.6.1)." ;
            sh:in ( "first_party" "second_party" "third_party" "open_data" "synthetic" "queried_union" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:data_source_type ],
        [ sh:datatype xsd:string ;
