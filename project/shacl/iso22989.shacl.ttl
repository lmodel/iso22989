            sh:order 12 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:float ;
            sh:description "Estimated likelihood of the event (0.0–1.0)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:likelihood ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:class iso22989:AIStakeholderRole ;
            sh:description "Stakeholder roles affected by the risk." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path iso22989:affected_stakeholders ],
        [ sh:datatype xsd:string ;
            sh:description "Source from which the risk originates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso22989:risk_source ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Strategies to reduce likelihood or severity." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:mitigation_strategy ],
        [ sh:datatype xsd:string ;
            sh:description "Potential event whose occurrence would realise the risk." ;
