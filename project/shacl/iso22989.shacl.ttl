iso22989:RiskItem a sh:NodeShape ;
    rdfs:comment "Risk associated with an AI system, capturing source, potential event, consequence and treatment metadata (Clause 3.5.11; aligned with ISO/IEC 23894 risk concepts)." ;
    sh:closed true ;
