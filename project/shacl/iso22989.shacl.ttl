            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:prefLabel ] ;
    sh:targetClass iso22989:AbbreviationEntry .

iso22989:CyberPhysicalSystem a sh:NodeShape ;
    rdfs:comment "System that tightly integrates computational and physical components, typically with feedback loops between sensing and actuation (Clause 5.14.3)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iso22989:IoTSystem ;
            sh:description "IoT subsystem the CPS relies on, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso22989:iot_subsystem ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:class iso22989:AIComponent ;
            sh:description "Computational components participating in the system." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:cyber_components ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Physical processes the system monitors or controls." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso22989:physical_processes ] ;
    sh:targetClass iso22989:CyberPhysicalSystem .

iso22989:Decision a sh:NodeShape ;
    rdfs:comment "Decision produced by an AI system on the basis of one or more predictions (Clause 7.4.3)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Chosen course of action resulting from a decision (Clause 7.4.3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso22989:decision_outcome ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdfs:seeAlso ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Policy or rule used to translate predictions into a decision." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:decision_policy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:class iso22989:Prediction ;
            sh:description "Predictions that supported the decision." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso22989:based_on_predictions ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
