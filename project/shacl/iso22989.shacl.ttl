            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso22989:severity ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Consequence to one or more stakeholders if the event occurs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:consequence ] ;
    sh:targetClass iso22989:RiskItem .

