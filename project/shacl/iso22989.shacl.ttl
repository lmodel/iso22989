            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Validation methods applied or applicable to the system." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:validation_methods ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:description "Verifiability / validatability claim (Clause 5.16)." ;
            sh:in ( "completely_verifiable" "partially_verifiable_validatable" "unverifiable_validatable" "unverifiable_partially_validatable" "unverifiable_unvalidatable" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:verification_validation_level ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:altLabel ] ;
    sh:targetClass iso22989:VerificationValidationFramework .

iso22989:AIApplication a sh:NodeShape ;
    rdfs:comment "Description of an AI application instance situated in a domain (Clause 10)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Societal impact categories considered in scope." ;
            sh:in ( "employment" "human_rights" "environment" "democratic_processes" "digital_divide" ) ;
            sh:order 3 ;
            sh:path iso22989:societal_impacts ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path skos:prefLabel ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Stated intended purpose of the AI system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:intended_purpose ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:altLabel ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:description "Application domain(s) the AI system targets." ;
            sh:in ( "fraud_detection" "automated_vehicles" "predictive_maintenance" "recommendation" "medical_diagnosis" "content_generation" "agriculture" "automotive" "banking_and_finance" "defense_and_security" "education" "energy_and_utilities" "healthcare" "legal_services" "manufacturing" "media_and_entertainment" "mixed_reality" "public_sector" "retail" "space" "telecommunications" ) ;
            sh:order 0 ;
            sh:path iso22989:application_domain ],
        [ sh:class iso22989:AISystem ;
            sh:description "AI system that provides the application." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path iso22989:hosting_system ],
        [ sh:description "Jurisdictional issues considered in scope for the application." ;
            sh:in ( "data_residency" "cross_border_transfer" "liability" "regulatory_compliance" "intellectual_property" ) ;
            sh:order 2 ;
            sh:path iso22989:jurisdictional_issues ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ;
    sh:targetClass iso22989:AIApplication .

iso22989:AILifecycleProcess a sh:NodeShape ;
    rdfs:comment "Process or activity associated with a stage of the AI system life cycle (Clause 6)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Risks identified or addressed by a process or assessment." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso22989:risk_items ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text refinement of the process within its life-cycle stage (e.g. \"objectives\", \"requirements\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso22989:process_sub_type ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Criteria that must be met for an output or process to be approved." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:approval_criteria ],
        [ sh:datatype xsd:string ;
            sh:description "Outputs produced by the process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:process_outputs ],
        [ sh:datatype xsd:date ;
            sh:description "Date the process started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso22989:start_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date the process completed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:end_date ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Inputs consumed by the process." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:process_inputs ],
        [ sh:description "Life-cycle stage the process belongs to." ;
            sh:in ( "inception" "design_and_development" "verification_and_validation" <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT> "operation_and_monitoring" "continuous_validation" "re_evaluation" <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:process_stage ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path skos:prefLabel ],
        [ sh:description "Stakeholder role responsible for executing the process." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path iso22989:responsible_role ] ;
    sh:targetClass iso22989:AILifecycleProcess .

iso22989:AbbreviationEntry a sh:NodeShape ;
    rdfs:comment "Record of a single abbreviation listed in Clause 4 of the standard." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
