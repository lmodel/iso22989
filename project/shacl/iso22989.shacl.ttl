            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path iso22989:consumed_by ],
        [ sh:description "Method used to collect data (Clause 8.6.1)." ;
            sh:in ( "point_of_sale" "survey" "research_study" "sensor_capture" "image_capture" "audio_capture" "document_extraction" "web_scraping" "interaction_log" "transactional_log" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso22989:data_collection_method ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
