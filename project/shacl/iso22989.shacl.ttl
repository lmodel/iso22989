        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:description "Acronym or abbreviation code (Clause 4)." ;
            sh:in ( "AI" "API" "ASIC" "CNN" "CPS" "CPU" "CRISP_DM" "DNN" "DSP" "FFNN" "FPGA" "GA" "GPU" "HMM" "IoT" "IR" "IT" "KDD" "LSTM" "ML" "MT" "NER" "NLG" "NLP" "NLU" "NN" "NPU" "OCR" "OECD" iso29100:PersonallyIdentifiableInformation "POS" "RL" "RNN" "SVM" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:abbreviation_code ],
        [ sh:datatype xsd:string ;
            sh:description "Expanded form of an abbreviation (Clause 4)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:expansion ],
        [ sh:datatype xsd:string ;
