            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:prefLabel ] ;
    sh:targetClass iso22989:Decision .

iso22989:ExpertSystem a sh:NodeShape ;
    rdfs:comment "Rule-based system encoding domain expertise (Clause 8.5.2)." ;
