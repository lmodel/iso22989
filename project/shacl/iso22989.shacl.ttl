        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:class iso22989:InferenceEngine ;
            sh:description "Inference engine used by the expert system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:inference_engine ],
