@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iso22989: <https://w3id.org/lmodel/iso22989/> .
@prefix iso29100: <https://w3id.org/lmodel/iso29100/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

schema1:Thing a sh:NodeShape ;
    rdfs:comment "Abstract base class for any addressable entity in the schema, carrying identity, label and clause-reference metadata." ;
    sh:closed false ;
    sh:ignoredProperties ( iso22989:action_target iso22989:lifecycle_stage iso22989:activation_function iso22989:societal_impacts iso22989:symbolic_approach iso22989:ai_systems_involved iso22989:consumed_by iso22989:measurement_method iso22989:semantic_model iso22989:ai_system_type iso22989:representation_form iso22989:organization_name iso22989:contact iso22989:produced_output iso22989:annotator iso22989:padding iso22989:validation_methods iso22989:label_value iso22989:coverage_scope iso22989:responsible_role iso22989:over_model iso22989:kernel_size rdf:type iso22989:agent_architecture iso22989:number_of_parameters iso22989:affected_dataset iso22989:verification_methods iso22989:soft_computing_techniques iso22989:big_data_characteristics iso22989:start_date iso22989:recommendation_outcome_type iso22989:applicable_biases iso22989:cv_task iso22989:property_evidence iso22989:affected_model iso22989:modality iso22989:trained_on iso22989:record_count iso22989:data_modality iso22989:human_roles iso22989:feature_count iso22989:process_stage iso22989:sample_label iso22989:components iso22989:device_role iso22989:iot_integration iso22989:stakeholder_role_type iso22989:training_phenomena iso22989:sample_payload iso22989:data_processes iso22989:data_quality_notes iso22989:devices iso22989:process_inputs iso22989:responsibilities iso22989:recommended_items iso22989:applies_to_metric iso22989:system_characteristics iso22989:output_dataset iso22989:decision_outcome iso22989:confidence iso22989:data_sources iso22989:input_arity iso22989:algorithm_family iso22989:detected_at iso22989:decision_policy iso22989:end_date iso22989:depends_on iso22989:process_outputs iso22989:stakeholders iso22989:ground_truth_available iso22989:process_sub_type iso22989:training_duration iso22989:expansion iso22989:application_domain iso22989:model_compression_applied iso22989:hosting_system iso22989:parameters iso22989:ai_stakeholder_roles iso22989:risk_source iso22989:model_paradigm iso22989:process_type iso22989:goal_set iso22989:oecd_stage iso22989:input_dataset iso22989:uses_model iso22989:approval_criteria iso22989:metric_name iso22989:based_on_predictions iso22989:datasets iso22989:functional_components iso22989:models iso22989:autonomy_criterion_scores iso22989:data_processes_applied iso22989:drift_type iso22989:test_dataset iso22989:abbreviation_code iso22989:threshold_value iso22989:cognitive_capabilities iso22989:task_categories iso22989:mechanism_type iso22989:dataset_role iso22989:inference_latency_ms iso22989:actuating_capabilities iso22989:metric_unit iso22989:confidence_score iso22989:triggered_by iso22989:threshold_policy iso22989:validation_dataset iso22989:reference_dataset iso22989:ai_field iso22989:component_function iso22989:cyber_components iso22989:data_collection_method iso22989:number_of_layers iso22989:knowledge_type iso22989:training_dataset iso22989:likelihood iso22989:neural_network_architecture iso22989:computing_resources iso22989:mapping_notes iso22989:capacity_units iso22989:risk_items iso22989:engineering_approach iso22989:potential_event iso22989:parameter_count iso22989:supports_continuous_learning iso22989:trustworthiness_property_type iso22989:ecosystem_components iso22989:task_allocation iso22989:severity iso22989:input_modalities iso22989:resource_type iso22989:output_label_type iso22989:label_type iso22989:autonomy_level iso22989:rule_count iso22989:iso_stage iso22989:metric_value iso22989:consequence iso22989:mitigation_strategy iso22989:executed_by iso22989:inference_engine iso22989:execution_status iso22989:affected_stakeholders iso22989:produced_by iso22989:stride iso22989:hyperparameters iso22989:task_category iso22989:data_source_type iso22989:language_code iso22989:ai_systems iso22989:embodiment prov:wasDerivedFrom iso22989:edge_count iso22989:predicted_value iso22989:inference_strategy iso22989:model_version iso22989:ontology_reference iso22989:physical_processes iso22989:augmented_capability iso22989:contains_personal_data iso22989:sensing_capabilities iso22989:performed_by iso22989:jurisdictional_issues iso22989:intended_purpose iso22989:nlp_component_type iso22989:trustworthiness_properties iso22989:ai_components iso22989:catastrophic_forgetting_risk iso22989:verification_validation_level iso22989:iot_subsystem iso22989:ground_truth_value iso22989:script iso22989:node_count iso22989:performance_metric iso22989:controlled_by ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path skos:altLabel ] ;
    sh:targetClass schema1:Thing .

iso22989:AIAgent a sh:NodeShape ;
    rdfs:comment "Entity that perceives its environment and acts upon it to achieve goals (Clause 5.3)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:description "Operational autonomy level of the AI system." ;
            sh:in ( "automated" "heteronomous" "autonomous" "level_0_no_automation" "level_1_assistance" "level_2_partial_automation" "level_3_conditional_automation" "level_4_high_automation" "level_5_full_automation" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso22989:autonomy_level ],
        [ sh:description "Agent architecture realised by the entity (Clause 5.3)." ;
            sh:in ( "reflex_agent" "model_based_agent" "goal_based_agent" "utility_based_agent" "learning_agent" "multi_agent" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path iso22989:agent_architecture ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Goals the agent is configured to pursue." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:goal_set ],
        [ sh:description "Predominant symbolic vs subsymbolic approach used by the system." ;
            sh:in ( "symbolic" "subsymbolic" "hybrid" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso22989:symbolic_approach ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:altLabel ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ] ;
    sh:targetClass iso22989:AIAgent .

iso22989:AIAuditor a sh:NodeShape ;
    rdfs:comment "Partner performing independent audits of AI systems (Clause 5.19.5)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Contact identifier (e.g. email) for the stakeholder." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:contact ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:defaultValue "ai_partner" ;
            sh:description "Canonical stakeholder role type as defined in Clause 5.19." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:stakeholder_role_type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the organisation acting in the stakeholder role." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:organization_name ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text statements of responsibility." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:responsibilities ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ] ;
    sh:targetClass iso22989:AIAuditor .

iso22989:AIConcept a sh:NodeShape ;
    rdfs:comment "Abstract base for Clause 5 conceptual entities (agent, knowledge, cognition, autonomy, etc.)." ;
    sh:closed false ;
    sh:ignoredProperties ( iso22989:human_roles iso22989:activation_function iso22989:symbolic_approach iso22989:ai_systems_involved iso22989:cognitive_capabilities iso22989:semantic_model iso22989:stride iso22989:representation_form iso22989:padding iso22989:language_code iso22989:edge_count iso22989:kernel_size rdf:type iso22989:input_arity iso22989:knowledge_type iso22989:agent_architecture iso22989:ontology_reference iso22989:augmented_capability iso22989:soft_computing_techniques iso22989:task_allocation iso22989:goal_set iso22989:script iso22989:node_count iso22989:autonomy_level ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ] ;
    sh:targetClass iso22989:AIConcept .

iso22989:AIConceptsCollection a sh:NodeShape ;
    rdfs:comment "Top-level container aggregating AI systems, models, datasets, lifecycle processes, stakeholder roles, applications and trustworthiness records for serialisation as a single artefact." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iso22989:AILifecycleProcess ;
            sh:description "Life-cycle process records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path iso22989:ai_lifecycle_processes ],
        [ sh:class iso22989:ExpertSystem ;
            sh:description "Expert-system records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso22989:expert_systems ],
        [ sh:class iso22989:Dataset ;
            sh:description "Datasets referenced by entities in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso22989:ai_datasets ],
        [ sh:class iso22989:KnowledgeGraph ;
            sh:description "Knowledge-graph records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path iso22989:knowledge_graphs ],
        [ sh:class iso22989:IoTSystem ;
            sh:description "IoT system records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path iso22989:iot_systems ],
        [ sh:class iso22989:AISystem ;
            sh:description "AI systems documented in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path iso22989:ai_systems ],
        [ sh:class iso22989:AIStakeholderRole ;
            sh:description "Stakeholder role records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path iso22989:ai_stakeholder_roles ],
        [ sh:class iso22989:TrustworthinessProperty ;
            sh:description "Trustworthiness property claims documented in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path iso22989:trustworthiness_records ],
        [ sh:class iso22989:Task ;
            sh:description "Task records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path iso22989:tasks ],
        [ sh:class iso22989:DataProcess ;
            sh:description "Data-handling process records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path iso22989:data_processes ],
        [ sh:class iso22989:AIApplication ;
            sh:description "AI application records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path iso22989:ai_applications ],
        [ sh:class iso22989:CyberPhysicalSystem ;
            sh:description "Cyber-physical system records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path iso22989:cyber_physical_systems ],
        [ sh:class iso22989:AbbreviationEntry ;
            sh:description "Clause 4 abbreviation records." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path iso22989:abbreviations ],
        [ sh:class iso22989:AIModel ;
            sh:description "Trained or knowledge-based models in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso22989:ai_models ] ;
    sh:targetClass iso22989:AIConceptsCollection .

iso22989:AICustomer a sh:NodeShape ;
    rdfs:comment "Stakeholder using an AI system or AI-backed service (Clause 5.19.4)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Contact identifier (e.g. email) for the stakeholder." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:contact ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text statements of responsibility." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso22989:responsibilities ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:prefLabel ],
        [ sh:defaultValue "ai_customer" ;
            sh:description "Canonical stakeholder role type as defined in Clause 5.19." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iso22989:stakeholder_role_type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the organisation acting in the stakeholder role." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:organization_name ],
        [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass iso22989:AICustomer .

iso22989:AIEcosystem a sh:NodeShape ;
    rdfs:comment "Aggregation of the AI systems, data sources, computing resources and stakeholder roles that surround a deployment context (Clause 8)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifiers or descriptions of data sources feeding the ecosystem." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso22989:data_sources ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text or CURIE references to ecosystem components." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:ecosystem_components ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred natural-language label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the entity (paraphrased; verbatim ISO text excluded)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:class iso22989:AIStakeholderRole ;
            sh:description "Stakeholder role records in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path iso22989:ai_stakeholder_roles ],
        [ sh:description "Big-data characteristics that the ecosystem exhibits (Clause 8.6.1)." ;
            sh:in ( "volume" "velocity" "variety" "veracity" "value" "variability" ) ;
            sh:order 5 ;
            sh:path iso22989:big_data_characteristics ],
        [ sh:datatype xsd:string ;
            sh:description "ISO/IEC 22989:2022 clause identifier (e.g. \"5.11.4\") the element corresponds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso22989:clause_reference ;
            sh:pattern "^[0-9]+(\\.[0-9]+){0,3}$" ],
        [ sh:description "Pointers to related external resources or term records." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative names or synonyms for the term." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path skos:altLabel ],
        [ sh:class iso22989:AISystem ;
            sh:description "AI systems documented in the collection." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path iso22989:ai_systems ],
        [ sh:description "Computing resource types relied upon." ;
            sh:in ( "cloud" "edge" "on_premises" "cpu" "gpu" "tpu" "asic" "fpga" "npu" "dsp" ) ;
            sh:order 0 ;
            sh:path iso22989:computing_resources ] ;
    sh:targetClass iso22989:AIEcosystem .

iso22989:AIEvaluator a sh:NodeShape ;
    rdfs:comment "Partner performing evaluations of AI system performance and trustworthiness (Clause 5.19.5)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unique CURIE or URI identifying the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Contact identifier (e.g. email) for the stakeholder." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso22989:contact ],
