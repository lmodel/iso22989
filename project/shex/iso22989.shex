<ModelVerifier> CLOSED {
    (  $<ModelVerifier_tes> (  &<AIProducer_tes> ;
          rdf:type [ <AIProducer> ] ?
       ) ;
       rdf:type [ <ModelVerifier> ]
    )
}

<NamedEntity>  (
    @<AIApplication> OR @<AIComponent> OR @<AIConcept> OR @<AIEcosystem> OR @<AILifecycleProcess> OR @<AIModel> OR
    @<AIStakeholderRole> OR @<AISystem> OR @<AbbreviatedTerm> OR @<AbbreviationEntry> OR @<Action> OR @<AutonomyAssessment> OR
    @<CatastrophicForgetting> OR @<ComputerVisionFunction> OR @<CyberPhysicalSystem> OR @<DataDrift> OR @<DataLabel> OR
    @<DataProcess> OR @<DataSample> OR @<Dataset> OR @<Decision> OR @<EvaluationMetric> OR @<ExpertSystem> OR
    @<FaultToleranceMechanism> OR @<GroundTruthRecord> OR @<Inference> OR @<InferenceEngine> OR @<InputData> OR @<InterestedParty>
    OR @<IoTDevice> OR @<IoTSystem> OR @<NLPComponent> OR @<OECDLifecycleMapping> OR @<Organization> OR @<Prediction> OR
    @<Recommendation> OR @<ResourcePool> OR @<RiskItem> OR @<Robot> OR @<Task> OR @<Term> OR @<Threshold> OR
    @<TrustworthinessProperty> OR @<VerificationValidationFramework>
)

<NamedEntity_struct> {
    (  $<NamedEntity_tes> (  schema1:name @linkml:String ;
          dcterms:description @linkml:String ? ;
          <clause_reference> @linkml:String ? ;
          skos:altLabel @linkml:String * ;
          skos:prefLabel @linkml:String ? ;
          rdfs:seeAlso @linkml:Uriorcurie *
       ) ;
       rdf:type [ schema1:Thing ]
    )
}

<NaturalLanguage> CLOSED {
    (  $<NaturalLanguage_tes> (  &<AIConcept_tes> ;
          rdf:type [ <AIConcept> ] ? ;
          <language_code> @linkml:String ? ;
          <script> @linkml:String ?
       ) ;
       rdf:type [ <NaturalLanguage> ]
    )
}

<NeuralNetworkModel> CLOSED {
    (  $<NeuralNetworkModel_tes> (  &<AIModel_tes> ;
          rdf:type [ <AIModel> ] ? ;
          <number_of_layers> @linkml:Integer ? ;
          <number_of_parameters> @linkml:Integer ? ;
          <algorithm_family> [ <https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#neural_network>
             <https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#bayesian_network>
             <https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#decision_tree>
             <https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#support_vector_machine>
             <https://w3id.org/lmodel/iso22989/MLAlgorithmFamily#genetic_algorithm> ] ?
       ) ;
       rdf:type [ <NeuralNetworkModel> ]
    )
}

<NeuralNetworkTerm> CLOSED {
    (  $<NeuralNetworkTerm_tes> (  &<Term_tes> ;
          rdf:type [ <Term> ] ?
       ) ;
       rdf:type [ <NeuralNetworkTerm> ]
    )
}

<Neuron> CLOSED {
    (  $<Neuron_tes> (  &<AIConcept_tes> ;
          rdf:type [ <AIConcept> ] ? ;
          <activation_function> [ <https://w3id.org/lmodel/iso22989/ActivationFunctionType#sigmoid>
             <https://w3id.org/lmodel/iso22989/ActivationFunctionType#tanh>
             <https://w3id.org/lmodel/iso22989/ActivationFunctionType#relu>
             <https://w3id.org/lmodel/iso22989/ActivationFunctionType#leaky_relu>
             <https://w3id.org/lmodel/iso22989/ActivationFunctionType#softmax>
             <https://w3id.org/lmodel/iso22989/ActivationFunctionType#linear>
             <https://w3id.org/lmodel/iso22989/ActivationFunctionType#other> ] ? ;
          <input_arity> @linkml:Integer ?
       ) ;
       rdf:type [ <Neuron> ]
    )
}

<NLPComponent> CLOSED {
    (  $<NLPComponent_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <nlp_component_type> [ <https://w3id.org/lmodel/iso22989/NLPComponentType#tokenisation>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#lemmatisation>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#part_of_speech_tagging>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#syntactic_parsing>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#semantic_analysis>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#named_entity_recognition>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#sentiment_analysis>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#machine_translation>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#speech_recognition>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#speech_synthesis>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#natural_language_understanding>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#natural_language_generation>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#automatic_summarization>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#dialogue_management>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#information_retrieval>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#question_answering>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#relationship_extraction>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#emotion_recognition>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#optical_character_recognition>
             <https://w3id.org/lmodel/iso22989/NLPComponentType#coreference_resolution> ]
       ) ;
       rdf:type [ <NLPComponent> ]
    )
}

<NLPTerm> CLOSED {
    (  $<NLPTerm_tes> (  &<Term_tes> ;
          rdf:type [ <Term> ] ?
       ) ;
       rdf:type [ <NLPTerm> ]
    )
}

<OECDLifecycleMapping> CLOSED {
    (  $<OECDLifecycleMapping_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <iso_stage> [ <https://w3id.org/lmodel/iso22989/AILifecycleStage#inception>
             <https://w3id.org/lmodel/iso22989/AILifecycleStage#design_and_development>
             <https://w3id.org/lmodel/iso22989/AILifecycleStage#verification_and_validation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT>
             <https://w3id.org/lmodel/iso22989/AILifecycleStage#operation_and_monitoring>
             <https://w3id.org/lmodel/iso22989/AILifecycleStage#continuous_validation>
             <https://w3id.org/lmodel/iso22989/AILifecycleStage#re_evaluation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> ] ;
          <oecd_stage> [ <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/iso22989/OECDLifecycleStage#deploy>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] ;
          <mapping_notes> @linkml:String ?
       ) ;
       rdf:type [ <OECDLifecycleMapping> ]
    )
}

<Organization> CLOSED {
    (  $<Organization_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ <Organization> ]
    )
}

<PolicyMaker> CLOSED {
    (  $<PolicyMaker_tes> (  &<RelevantAuthority_tes> ;
