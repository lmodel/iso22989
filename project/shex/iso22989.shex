    )
}

<Prediction> CLOSED {
    (  $<Prediction_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <predicted_value> @linkml:String ? ;
          <confidence> @<ConfidenceScore> ? ;
          <produced_by> @<AIModel> ?
       ) ;
       rdf:type [ <Prediction> ]
    )
}

<Recommendation> CLOSED {
    (  $<Recommendation_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <recommendation_outcome_type> [ <https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#content_recommendation>
             <https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#action_recommendation>
             <https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#ranking_recommendation>
             <https://w3id.org/lmodel/iso22989/RecommendationOutcomeType#next_best_action> ] ? ;
          <confidence> @<ConfidenceScore> ? ;
          <recommended_items> @linkml:String * ;
          <based_on_predictions> @<Prediction> *
       ) ;
       rdf:type [ <Recommendation> ]
    )
}

<Regulator> CLOSED {
    (  $<Regulator_tes> (  &<RelevantAuthority_tes> ;
          rdf:type [ <RelevantAuthority> ] ?
       ) ;
       rdf:type [ <Regulator> ]
    )
}

<RelevantAuthority>  (
    CLOSED {
       (  $<RelevantAuthority_tes> (  &<AIStakeholderRole_tes> ;
             rdf:type [ <AIStakeholderRole> ] ? ;
             <stakeholder_role_type> [ <https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_provider>
                <https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_producer>
                <https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_customer>
                <https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_partner>
                <https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#ai_subject>
                <https://w3id.org/lmodel/iso22989/AIStakeholderRoleType#relevant_authority> ]
          ) ;
          rdf:type [ <RelevantAuthority> ]
       )
    } OR @<PolicyMaker> OR @<Regulator>
)

<ResourcePool> CLOSED {
    (  $<ResourcePool_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <resource_type> [ <https://w3id.org/lmodel/iso22989/ComputingResourceType#cloud>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#edge>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#on_premises>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#cpu>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#gpu>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#tpu>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#asic>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#fpga>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#npu>
             <https://w3id.org/lmodel/iso22989/ComputingResourceType#dsp> ] ;
          <capacity_units> @linkml:String ?
       ) ;
       rdf:type [ <ResourcePool> ]
    )
}

<RiskItem> CLOSED {
    (  $<RiskItem_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <risk_source> @linkml:String ? ;
          <potential_event> @linkml:String ? ;
          <consequence> @linkml:String ? ;
          <likelihood> @<ConfidenceScore> ? ;
          <severity> @linkml:String ? ;
          <mitigation_strategy> @linkml:String * ;
          <affected_stakeholders> @<AIStakeholderRole> *
       ) ;
       rdf:type [ <RiskItem> ]
    )
}

<Robot> CLOSED {
    (  $<Robot_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <embodiment> @linkml:String ? ;
          <controlled_by> @<AISystem> ?
       ) ;
       rdf:type [ <Robot> ]
    )
}

<SemanticComputingSystem> CLOSED {
    (  $<SemanticComputingSystem_tes> (  &<AIConcept_tes> ;
          rdf:type [ <AIConcept> ] ? ;
          <semantic_model> @linkml:String ?
       ) ;
       rdf:type [ <SemanticComputingSystem> ]
    )
}

<SoftComputingSystem> CLOSED {
    (  $<SoftComputingSystem_tes> (  &<AIConcept_tes> ;
          rdf:type [ <AIConcept> ] ? ;
          <soft_computing_techniques> [ <https://w3id.org/lmodel/iso22989/SoftComputingTechnique#fuzzy_logic>
             <https://w3id.org/lmodel/iso22989/SoftComputingTechnique#evolutionary_computing>
             <https://w3id.org/lmodel/iso22989/SoftComputingTechnique#swarm_intelligence>
             <https://w3id.org/lmodel/iso22989/SoftComputingTechnique#probabilistic_reasoning>
             <https://w3id.org/lmodel/iso22989/SoftComputingTechnique#neural_computing> ] +
       ) ;
       rdf:type [ <SoftComputingSystem> ]
    )
}

<Task> CLOSED {
    (  $<Task_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <task_category> [ <https://w3id.org/lmodel/iso22989/TaskCategory#classification>
             <https://w3id.org/lmodel/iso22989/TaskCategory#regression> <https://w3id.org/lmodel/iso22989/TaskCategory#clustering>
             <https://w3id.org/lmodel/iso22989/TaskCategory#ranking> <https://w3id.org/lmodel/iso22989/TaskCategory#recommendation>
             <https://w3id.org/lmodel/iso22989/TaskCategory#anomaly_detection>
             <https://w3id.org/lmodel/iso22989/TaskCategory#dimensionality_reduction>
             <https://w3id.org/lmodel/iso22989/TaskCategory#generation> <https://w3id.org/lmodel/iso22989/TaskCategory#planning>
             <https://w3id.org/lmodel/iso22989/TaskCategory#control>
             <https://w3id.org/lmodel/iso22989/TaskCategory#decision_support> ] ;
          <input_modalities> [ <https://w3id.org/lmodel/iso22989/DataModality#structured>
             <https://w3id.org/lmodel/iso22989/DataModality#semi_structured>
             <https://w3id.org/lmodel/iso22989/DataModality#unstructured> <https://w3id.org/lmodel/iso22989/DataModality#text>
             <https://w3id.org/lmodel/iso22989/DataModality#image> <https://w3id.org/lmodel/iso22989/DataModality#video>
             <https://w3id.org/lmodel/iso22989/DataModality#audio> <https://w3id.org/lmodel/iso22989/DataModality#sensor>
             <https://w3id.org/lmodel/iso22989/DataModality#time_series> <https://w3id.org/lmodel/iso22989/DataModality#graph> ] *
          ;
          <output_label_type> [ <https://w3id.org/lmodel/iso22989/DataLabelType#categorical>
             <https://w3id.org/lmodel/iso22989/DataLabelType#binary> <https://w3id.org/lmodel/iso22989/DataLabelType#ordinal>
             <https://w3id.org/lmodel/iso22989/DataLabelType#numeric> <https://w3id.org/lmodel/iso22989/DataLabelType#structured>
             <https://w3id.org/lmodel/iso22989/DataLabelType#sequence> <https://w3id.org/lmodel/iso22989/DataLabelType#graph>
             <https://w3id.org/lmodel/iso22989/DataLabelType#none> ] ? ;
          <performance_metric> @linkml:String *
       ) ;
       rdf:type [ <Task> ]
    )
}

<Term>  (
    @<AITerm> OR @<ComputerVisionTerm> OR @<DataTerm> OR @<MachineLearningTerm> OR @<NLPTerm> OR @<NeuralNetworkTerm> OR
    @<TrustworthinessTerm>
)

<Term_struct> {
    (  $<Term_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ <Term> ]
    )
}

<Threshold> CLOSED {
    (  $<Threshold_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <threshold_value> @linkml:Float ;
          <applies_to_metric> @linkml:String ? ;
          <threshold_policy> @linkml:String ?
       ) ;
       rdf:type [ <Threshold> ]
    )
}

<TrustworthinessProperty> CLOSED {
    (  $<TrustworthinessProperty_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <trustworthiness_property_type> [ <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#robustness>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#reliability>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#resilience>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#controllability>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#explainability>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#predictability>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#transparency>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#fairness>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#bias_mitigation>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#accountability>
             <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
             <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common/TrustworthinessCharacteristicEnum#SAFE>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#availability>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#integrity>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#authenticity>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#security>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#usability>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#quality>
             <https://w3id.org/lmodel/iso22989/TrustworthinessPropertyType#fault_tolerance> ] ;
          <property_evidence> @linkml:String * ;
          <measurement_method> @linkml:String ? ;
          <applicable_biases> [ <https://w3id.org/lmodel/iso22989/BiasType#data_bias>
             <https://w3id.org/lmodel/iso22989/BiasType#algorithmic_bias> <https://w3id.org/lmodel/iso22989/BiasType#societal_bias>
             <https://w3id.org/lmodel/iso22989/BiasType#cognitive_bias> <https://w3id.org/lmodel/iso22989/BiasType#automation_bias>
             ] * ;
          <confidence_score> @<ConfidenceScore> ?
       ) ;
       rdf:type [ <TrustworthinessProperty> ]
    )
}

<TrustworthinessTerm> CLOSED {
    (  $<TrustworthinessTerm_tes> (  &<Term_tes> ;
          rdf:type [ <Term> ] ?
       ) ;
       rdf:type [ <TrustworthinessTerm> ]
    )
}

<VerificationValidationFramework> CLOSED {
    (  $<VerificationValidationFramework_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <verification_validation_level> [ <https://w3id.org/lmodel/iso22989/VerificationValidationLevel#completely_verifiable>
             <https://w3id.org/lmodel/iso22989/VerificationValidationLevel#partially_verifiable_validatable>
             <https://w3id.org/lmodel/iso22989/VerificationValidationLevel#unverifiable_validatable>
             <https://w3id.org/lmodel/iso22989/VerificationValidationLevel#unverifiable_partially_validatable>
             <https://w3id.org/lmodel/iso22989/VerificationValidationLevel#unverifiable_unvalidatable> ] ? ;
          <verification_methods> @linkml:String * ;
          <validation_methods> @linkml:String *
       ) ;
       rdf:type [ <VerificationValidationFramework> ]
    )
}
