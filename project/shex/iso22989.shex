          rdf:type [ <AIConcept> ] ? ;
          <human_roles> @linkml:String * ;
          <ai_systems_involved> @<AISystem> * ;
          <task_allocation> @linkml:String ?
       ) ;
       rdf:type [ <HumanMachineTeam> ]
    )
}

<Inference> CLOSED {
    (  $<Inference_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <inference_strategy> @linkml:String ? ;
          <performed_by> @<InferenceEngine> ? ;
          <over_model> @<AIModel> ? ;
          <produced_output> @linkml:String ?
       ) ;
       rdf:type [ <Inference> ]
    )
}

<InferenceEngine> CLOSED {
    (  $<InferenceEngine_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <inference_strategy> @linkml:String ? ;
          <uses_model> @<AIModel> ?
       ) ;
       rdf:type [ <InferenceEngine> ]
    )
}

<InputData> CLOSED {
    (  $<InputData_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <data_source_type> [ <https://w3id.org/lmodel/iso22989/DataSourceType#first_party>
             <https://w3id.org/lmodel/iso22989/DataSourceType#second_party>
             <https://w3id.org/lmodel/iso22989/DataSourceType#third_party>
             <https://w3id.org/lmodel/iso22989/DataSourceType#open_data>
             <https://w3id.org/lmodel/iso22989/DataSourceType#synthetic>
             <https://w3id.org/lmodel/iso22989/DataSourceType#queried_union> ] ? ;
          <data_collection_method> [ <https://w3id.org/lmodel/iso22989/DataCollectionMethod#point_of_sale>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#survey>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#research_study>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#sensor_capture>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#image_capture>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#audio_capture>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#document_extraction>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#web_scraping>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#interaction_log>
             <https://w3id.org/lmodel/iso22989/DataCollectionMethod#transactional_log> ] ? ;
          <modality> [ <https://w3id.org/lmodel/iso22989/DataModality#structured>
             <https://w3id.org/lmodel/iso22989/DataModality#semi_structured>
             <https://w3id.org/lmodel/iso22989/DataModality#unstructured> <https://w3id.org/lmodel/iso22989/DataModality#text>
             <https://w3id.org/lmodel/iso22989/DataModality#image> <https://w3id.org/lmodel/iso22989/DataModality#video>
             <https://w3id.org/lmodel/iso22989/DataModality#audio> <https://w3id.org/lmodel/iso22989/DataModality#sensor>
             <https://w3id.org/lmodel/iso22989/DataModality#time_series> <https://w3id.org/lmodel/iso22989/DataModality#graph> ] ?
          ;
          <consumed_by> @<AISystem> ?
       ) ;
       rdf:type [ <InputData> ]
    )
}

<IntelligenceAugmentation> CLOSED {
    (  $<IntelligenceAugmentation_tes> (  &<AIConcept_tes> ;
          rdf:type [ <AIConcept> ] ? ;
          <augmented_capability> @linkml:String *
       ) ;
       rdf:type [ <IntelligenceAugmentation> ]
    )
}

<InterestedParty> CLOSED {
    (  $<InterestedParty_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ <InterestedParty> ]
    )
}

<IoTDevice> CLOSED {
    (  $<IoTDevice_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <device_role> [ <https://w3id.org/lmodel/iso22989/IoTDeviceRole#sensor>
             <https://w3id.org/lmodel/iso22989/IoTDeviceRole#actuator> <https://w3id.org/lmodel/iso22989/IoTDeviceRole#gateway>
             <https://w3id.org/lmodel/iso22989/IoTDeviceRole#edge_compute>
             <https://w3id.org/lmodel/iso22989/IoTDeviceRole#controller> ] ;
          <sensing_capabilities> @linkml:String * ;
          <actuating_capabilities> @linkml:String *
       ) ;
       rdf:type [ <IoTDevice> ]
    )
}

<IoTSystem> CLOSED {
    (  $<IoTSystem_tes> (  &<NamedEntity_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <devices> @<IoTDevice> * ;
          <ai_components> @<AIComponent> *
       ) ;
       rdf:type [ <IoTSystem> ]
    )
}

<KnowledgeGraph> CLOSED {
    (  $<KnowledgeGraph_tes> (  &<KnowledgeRepresentation_tes> ;
          rdf:type [ <KnowledgeRepresentation> ] ? ;
          <node_count> @linkml:Integer ? ;
          <edge_count> @linkml:Integer ? ;
          <ontology_reference> @linkml:Uriorcurie *
       ) ;
       rdf:type [ <KnowledgeGraph> ]
    )
}

<KnowledgeRepresentation>  (
    CLOSED {
       (  $<KnowledgeRepresentation_tes> (  &<AIConcept_tes> ;
             rdf:type [ <AIConcept> ] ? ;
             <symbolic_approach> [ <https://w3id.org/lmodel/iso22989/SymbolicApproach#symbolic>
                <https://w3id.org/lmodel/iso22989/SymbolicApproach#subsymbolic>
                <https://w3id.org/lmodel/iso22989/SymbolicApproach#hybrid> ] ? ;
             <knowledge_type> [ <https://w3id.org/lmodel/iso22989/KnowledgeType#declarative>
                <https://w3id.org/lmodel/iso22989/KnowledgeType#procedural> <https://w3id.org/lmodel/iso22989/KnowledgeType#tacit>
                <https://w3id.org/lmodel/iso22989/KnowledgeType#common_sense>
                <https://w3id.org/lmodel/iso22989/KnowledgeType#domain_specific> ] ? ;
             <representation_form> @linkml:String ?
          ) ;
          rdf:type [ <KnowledgeRepresentation> ]
       )
    } OR @<KnowledgeGraph>
)

<MachineLearningTerm> CLOSED {
    (  $<MachineLearningTerm_tes> (  &<Term_tes> ;
          rdf:type [ <Term> ] ?
       ) ;
       rdf:type [ <MachineLearningTerm> ]
    )
}

<ModelDesigner> CLOSED {
    (  $<ModelDesigner_tes> (  &<AIProducer_tes> ;
